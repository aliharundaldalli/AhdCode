bring Env
bring HTML
from HTML bring HTMLNode
bring HTTP
from HTTP bring Request
from HTTP bring Response
from HTTP bring SessionStore
from HTTP bring Session
bring MySQL
from MySQL bring MySQLDatabase
from MySQL bring MySQLError
bring SQLite
from SQLite bring Database

mysqlHome: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            names: Local List<String> := mysqlDatabases(db)
            dbRows: Local List<HTMLNode> := []
            for name in names {
                dbRows.add(
                    HTML.element(
                        "tr"
                        {}
                        [
                            HTML.element(
                                "td"
                                {}
                                [HTML.element("strong", {}, [HTML.text(name)])]
                            )
                            HTML.element(
                                "td"
                                {"class": "text-end"}
                                [
                                    queryFormClass(
                                        "/AhdDataStudio/mysql/database"
                                        {"database": name}
                                        t("open")
                                        "btn btn-sm btn-primary"
                                    )
                                ]
                            )
                        ]
                    )
                )
            }
            body: Local List<HTMLNode> := [
                HTML.element("h1", {"class": "h4 mb-2"}, [HTML.text("MySQL")])
                databaseContext("MySQL", mysqlEndpoint())
                HTML.element(
                    "p"
                    {"class": "text-muted"}
                    [
                        HTML.text(
                            str(
                                len(names)
                            ) + " visible schemas for these credentials."
                        )
                    ]
                )
                HTML.element(
                    "div"
                    {"class": "table-responsive"}
                    [
                        HTML.element(
                            "table"
                            {
                                "class": "table table-sm table-hover align-middle bg-white"
                            }
                            [
                                HTML.element(
                                    "thead"
                                    {"class": "table-light"}
                                    [
                                        HTML.element(
                                            "tr"
                                            {}
                                            [
                                                HTML.element(
                                                    "th"
                                                    {}
                                                    [HTML.text("Database")]
                                                )
                                                HTML.element(
                                                    "th"
                                                    {"class": "text-end"}
                                                    [HTML.text("")]
                                                )
                                            ]
                                        )
                                    ]
                                )
                                HTML.element("tbody", {}, dbRows)
                            ]
                        )
                    ]
                )
            ]
            if len(names) == 0 {
                body.add(emptyState(t("no_rows"), t("no_rows_detail")))
            }
            return sessions.commit(
                session
                HTTP.html(layout("MySQL", token, body))
            )
        }
        except MySQLError as error {
            return sessions.commit(
                session
                HTTP.html(layout("MySQL", token, mysqlProblemNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return sessions.commit(
            session
            HTTP.html(layout("MySQL", token, mysqlProblemNodes(error.message)))
        )
    }
}

// mysqlProblemNodes reports what the server actually said and offers the
// connection form, so a wrong password is a correctable mistake rather than a
// dead end that needs environment variables and a restart.
mysqlProblemNodes: Function := (message: String) -> List<HTMLNode> {
    nodes: Local List<HTMLNode> := errorNodes(message)
    nodes.add(
        HTML.element(
            "p"
            {"class": "text-muted"}
            [HTML.text(t("conn_failed_detail") + " " + mysqlEndpoint() + ".")]
        )
    )
    nodes.add(
        HTML.element(
            "a"
            {"class": "btn btn-sm btn-primary", "href": "/AhdDataStudio/mysql/connection"}
            [HTML.text(t("conn_open"))]
        )
    )
    return nodes
}

