# AhdDataStudio local configuration
# Copy to .env and edit. Do not commit real credentials.

# MySQL — explicit configuration only. AhdDataStudio never scans the
# machine, browser, or shell history for passwords.
AHD_DATA_MYSQL_HOST=127.0.0.1
AHD_DATA_MYSQL_PORT=3306
AHD_DATA_MYSQL_USER=root
AHD_DATA_MYSQL_PASSWORD=
AHD_DATA_MYSQL_SECURITY=none

# SQLite — optional explicit file list (comma-separated) and/or a project
# root whose immediate .db / .sqlite / .sqlite3 children are listed.
# Discovery is not recursive and never walks outside this root.
# AHD_DATA_SQLITE_PATHS=/absolute/path/to/app.db
# AHD_DATA_PROJECT_ROOT=/absolute/path/to/project
