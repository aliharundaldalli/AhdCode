bring File
from File bring FileError
bring HTML
from HTML bring HTMLNode
bring Path

studioCSS: Function := () -> String {
    return r"""
:root {
    --studio-bg: #f5f4f1;
    --studio-panel: #fff;
    --studio-border: #dedfdc;
    --studio-border-strong: #bcc2bf;
    --studio-text: #25312e;
    --studio-muted: #626d68;
    --studio-accent: #8a3024;
    --studio-success: #236449;
    --studio-warning: #795616;
    --studio-danger: #a52d36;
    --studio-radius: 6px;
    --studio-space: 8px;
    --studio-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}
html, body { min-height: 100%; }
body { margin: 0; background: var(--studio-bg); color: var(--studio-text); font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif; }
a { color: var(--studio-accent); }
h1, h1.h3, h1.h4 { font-size: 23px; font-weight: 650; letter-spacing: -.025em; overflow-wrap: anywhere; }
h2.h5 { font-size: 17px; font-weight: 650; }
.text-muted { color: var(--studio-muted) !important; }
code, .studio-mono { font-family: var(--studio-mono); overflow-wrap: anywhere; }
code { color: #485b54; }
:focus-visible { outline: 3px solid #9a5137 !important; outline-offset: 3px; box-shadow: none !important; }
.studio-navbar { position: sticky; top: 0; z-index: 1030; background: var(--studio-panel); border-bottom: 1px solid var(--studio-border); padding: 10px 8px; }
.studio-navbar .navbar-brand { color: var(--studio-text); font-size: 16px; gap: 9px; }
.studio-navbar .navbar-nav { flex-direction: row; gap: 4px; flex-wrap: wrap; }
.studio-navbar .nav-link { color: var(--studio-muted); font-size: 13px; padding: 5px 9px; border-radius: var(--studio-radius); }
.studio-navbar .nav-link:hover { background: var(--studio-bg); color: var(--studio-text); }
.studio-logo { height: 28px; width: auto; display: block; }
.studio-local-badge { color: var(--studio-muted); background: #f3f4f1; border: 1px solid var(--studio-border); font-size: 11px; font-weight: 500; }
.studio-lang { margin-left: 10px; padding: 3px; gap: 2px; background: #f1f2ef; border: 1px solid var(--studio-border); border-radius: var(--studio-radius); }
.studio-lang .btn { border: 0; border-radius: 3px !important; font-size: 11px; font-weight: 650; padding: 3px 7px; }
.studio-lang .btn-dark { background: #33483f; color: #fff; }
.studio-sidebar { background: #eeefeb; min-height: calc(100vh - 60px); border-right: 1px solid var(--studio-border); font-size: 13px; overflow-x: hidden; }
.studio-sidebar-label { letter-spacing: .09em; font-size: 10px; font-weight: 700; color: var(--studio-muted); }
.studio-sidebar form { display: block; margin: 0; max-width: 100%; }
.studio-sidebar button, .studio-side-item { width: 100%; max-width: 100%; text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.studio-sidebar .btn { font-size: 12px; border-color: transparent; background: transparent; color: #44564d; }
.studio-sidebar .btn:hover, .studio-side-list .list-group-item:hover { background: #fff; border-color: var(--studio-border); }
.studio-side-list .list-group-item { border-color: transparent; background: transparent; color: #44564d; }
.studio-side-list .list-group-item.active { background: #dfe7df; border-color: #c7d4c8; color: #254b37; font-weight: 650; }
.studio-main { min-width: 0; padding: 26px !important; }
.studio-content { max-width: 1500px; margin: 0 auto; }
.studio-page-heading { margin-bottom: 24px; }
.studio-page-heading .eyebrow { color: var(--studio-muted); font-size: 10px; text-transform: uppercase; letter-spacing: .1em; font-weight: 700; margin-bottom: 6px; }
.studio-context { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 16px; color: var(--studio-muted); font-size: 12px; overflow-wrap: anywhere; }
.studio-engine { display: inline-flex; align-items: center; border: 1px solid #cdd8d2; background: #eaf0eb; color: #355444; border-radius: 4px; padding: 2px 7px; font: 600 11px/1.5 var(--studio-mono); }
.studio-tabs { border-bottom: 1px solid var(--studio-border); flex-wrap: wrap; gap: 4px; margin-top: 8px; }
.studio-tabs .nav-item { margin-bottom: -1px; }
.studio-tabs form { display: block; margin: 0; }
.studio-tabs .nav-link { border: 0; border-bottom: 2px solid transparent; border-radius: 0; color: var(--studio-muted); background: transparent; font-size: 13px; padding: 9px 12px; }
.studio-tabs .nav-link:hover { background: #eceee9; color: var(--studio-text); }
.studio-tabs .nav-link.active { color: var(--studio-accent); border-bottom-color: var(--studio-accent); background: transparent; font-weight: 650; }
.studio-name { font: 12px var(--studio-mono); color: var(--studio-text); overflow-wrap: anywhere; background: transparent; }
.btn { border-radius: var(--studio-radius); font-size: 13px; font-weight: 550; }
.btn-primary { --bs-btn-bg: #3b5548; --bs-btn-border-color: #3b5548; --bs-btn-hover-bg: #2c4337; --bs-btn-hover-border-color: #2c4337; --bs-btn-active-bg: #243b30; --bs-btn-active-border-color: #243b30; }
.btn-outline-primary { --bs-btn-color: #365343; --bs-btn-border-color: #a6b9ac; --bs-btn-hover-bg: #365343; --bs-btn-hover-border-color: #365343; }
.btn-outline-secondary { --bs-btn-color: #58665e; --bs-btn-border-color: #cbd1cc; --bs-btn-hover-bg: #e9ede7; --bs-btn-hover-color: #25312e; --bs-btn-hover-border-color: #aab5ad; }
.btn-danger { --bs-btn-bg: var(--studio-danger); --bs-btn-border-color: var(--studio-danger); }
.studio-actions { display: inline-flex; flex-wrap: nowrap; gap: 5px; align-items: center; }
.studio-actions form { display: inline; margin: 0; }
.studio-actions .btn { padding: 3px 7px; font-size: 11px; line-height: 1.3; border-radius: 4px; }
.studio-actions .btn-primary { --bs-btn-bg: #edf2ed; --bs-btn-color: #34503e; --bs-btn-border-color: #c9d5ca; }
.studio-table-wrap, .table-responsive { border: 1px solid var(--studio-border); border-radius: var(--studio-radius); background: #fff; overflow: auto; max-height: 65vh; margin-bottom: 16px; }
.table { --bs-table-striped-bg: #fafbf8; --bs-table-hover-bg: #f0f4ee; width: 100%; margin-bottom: 0; font-size: 12px; }
.table td, .table th { padding: 9px 12px; vertical-align: middle; border-color: #e7e9e4; }
.table td { min-width: 80px; max-width: 420px; overflow-wrap: anywhere; }
.table thead th { position: sticky; top: 0; z-index: 1; background: #f0f2ed; color: #58665d; font-size: 11px; font-weight: 650; white-space: nowrap; border-bottom: 1px solid #d6ddd4; }
.studio-null { color: #65736a; font-style: italic; font-size: 11px; border: 1px solid #dce2da; border-radius: 3px; padding: 1px 4px; background: #f1f4ef; }
.studio-data td { font-family: var(--studio-mono); white-space: pre-wrap; }
.studio-actions-cell { width: 1%; white-space: nowrap; }
.studio-card, .studio-panel, .studio-sql, .studio-row-action { border: 1px solid var(--studio-border); border-radius: var(--studio-radius); background: var(--studio-panel); }
.studio-card { box-shadow: 0 1px 2px #25312e06; }
.studio-card .card-body { padding: 20px; }
.studio-card .card-header { background: #f8f9f5; border-bottom-color: var(--studio-border); }
.studio-panel, .studio-sql { padding: 16px; }
.studio-provider-icon { width: 32px; height: 32px; border: 1px solid #cbd6ce; border-radius: 5px; display: inline-flex; align-items: center; justify-content: center; font: 650 14px var(--studio-mono); color: #3d5947; background: #eaf0e9; }
.studio-provider-icon.sqlite { color: #435868; background: #eaf0f4; border-color: #d0dbe2; }
.badge { font-weight: 550; border-radius: 4px; }
.studio-status-badge { font-size: 11px; }
.studio-status-badge.text-bg-secondary { background: #eff0ed !important; color: #5f675f !important; border: 1px solid #d7dcd4; }
.studio-status-badge.text-bg-success { background: #e6f0e8 !important; color: #24613d !important; }
.studio-database-entry { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-top: 1px solid var(--studio-border); }
.studio-database-entry div { flex: 1; min-width: 0; }
.studio-database-entry strong { display: block; font: 600 13px var(--studio-mono); overflow-wrap: anywhere; }
.studio-path { display: block; color: var(--studio-muted); font: 11px/1.6 var(--studio-mono); overflow-wrap: anywhere; }
.studio-empty { border: 1px dashed var(--studio-border-strong); border-radius: var(--studio-radius); background: #fafbf8; padding: 28px 20px; text-align: left; }
.studio-empty-icon { display: none; }
.studio-field-meta { color: var(--studio-muted); font-size: 11px; min-height: 17px; margin-bottom: 4px; }
.studio-sortbar { display: flex; flex-wrap: wrap; gap: 5px; padding: 8px; margin-bottom: 12px; border: 1px solid var(--studio-border); border-radius: var(--studio-radius); background: #fff; }
.studio-pagination { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin: 12px 0; }
.studio-pagination .pager-actions { display: flex; gap: 6px; }
.studio-row-action { padding: 12px; margin-bottom: 8px; }
.studio-row-action form { margin: 0; }
.studio-row-action-fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(160px, 100%), 1fr)); gap: 8px; }
.form-control, .form-select { border-color: var(--studio-border-strong); border-radius: var(--studio-radius); font-size: 13px; min-width: 0; }
.form-control:focus, .form-select:focus { border-color: #6c8775; box-shadow: 0 0 0 3px #52745d20; }
textarea.form-control { min-height: 230px; padding: 14px; background: #fafbf8; font: 13px/1.65 var(--studio-mono); tab-size: 4; resize: vertical; }
.studio-sql-context { color: var(--studio-muted); font-size: 12px; margin-bottom: 10px; }
.alert { border-radius: var(--studio-radius); font-size: 13px; overflow-wrap: anywhere; }
.alert-warning { background: #fcf7e9; border-color: #e9dcb9; color: var(--studio-warning); }
.alert-danger, .studio-danger { background: #fff5f3; border: 1px solid #e7c6c2; border-left: 3px solid var(--studio-danger); color: #802c31; }
.studio-danger { border-radius: var(--studio-radius); padding: 16px; }
.alert-success { background: #edf5ed; border-color: #c5dbc8; color: var(--studio-success); }
.ok { color: var(--studio-success); font-weight: 600; }
.fail { color: var(--studio-danger); font-weight: 600; }
@media (max-width: 991.98px) { .studio-navbar .container-fluid { gap: 8px; } .studio-local-badge { display: none; } }
@media (max-width: 767.98px) {
    .studio-navbar { position: relative; }
    .studio-navbar .container-fluid { flex-wrap: wrap; }
    .studio-navbar .navbar-nav { width: 100%; justify-content: space-between; }
    .studio-lang { margin-left: auto; }
    .studio-sidebar { min-height: auto; max-height: 180px; overflow-y: auto; border-right: 0; border-bottom: 1px solid var(--studio-border); }
    .studio-main { padding: 20px 16px !important; }
    .studio-actions { flex-wrap: nowrap; }
    .table td { min-width: 110px; }
    .studio-card .card-body { padding: 16px; }
}

"""
}

layout: Function := (
    title: String
    token: String
    body: List<HTMLNode>
) -> String {
    sqliteLinks: Local List<HTMLNode> := []
    attempt {
        files: Local List<String> := allowedSqlitePaths()
        for path in files {
            sqliteLinks.add(
                queryFormClass(
                    "/AhdDataStudio/sqlite/database"
                    {"db": path}
                    Path.base(path)
                    "btn btn-sm btn-outline-secondary w-100 text-start mb-1"
                )
            )
        }
    }
    except FileError {}
    mysqlSchemaCache: Global List<String>
    mysqlActiveSchema: Global String
    sideBody: Local List<HTMLNode> := [
        HTML.element(
            "div"
            {"class": "studio-sidebar-label px-1 mb-2"}
            [HTML.text("MYSQL")]
        )
        HTML.element(
            "a"
            {
                "class": "btn btn-sm btn-light border w-100 text-start mb-2"
                "href": "/AhdDataStudio/mysql"
            }
            [HTML.text(t("all_databases"))]
        )
    ]
    if len(mysqlSchemaCache) > 0 {
        sideBody.add(schemaSideList(mysqlSchemaCache, mysqlActiveSchema))
    }
    sideBody.add(
        HTML.element(
            "div"
            {"class": "studio-sidebar-label px-1 mt-3 mb-2"}
            [HTML.text("SQLITE")]
        )
    )
    for link in sqliteLinks {
        sideBody.add(link)
    }
    if len(sqliteLinks) == 0 {
        sideBody.add(
            HTML.element(
                "div"
                {"class": "small text-muted px-1 py-2"}
                [
                    HTML.text(t("no_project_db"))
                    HTML.element(
                        "div"
                        {"class": "mt-1"}
                        [
                            HTML.text(
                                t("configure_paths")
                            )
                        ]
                    )
                ]
            )
        )
    }
    nodes: Local List<HTMLNode> := [
        HTML.element(
            "link"
            {
                "rel": "stylesheet"
                "href": "/AhdDataStudio/assets/bootstrap.min.css"
            }
            []
        )
        HTML.element("style", {}, [HTML.text(studioCSS())])
        HTML.element(
            "nav"
            {"class": "navbar navbar-expand navbar-light studio-navbar"}
            [
                HTML.element(
                    "div"
                    {"class": "container-fluid"}
                    [
                        HTML.element(
                            "div"
                            {"class": "d-flex align-items-center gap-2"}
                            [
                                HTML.element(
                                    "a"
                                    {
                                        "class": "navbar-brand d-flex align-items-center mb-0"
                                        "href": "/AhdDataStudio"
                                    }
                                    [
                                        HTML.element(
                                            "img"
                                            {
                                                "src": "/AhdDataStudio/assets/ahdcode-logo.png"
                                                "alt": "AhdCode"
                                                "class": "studio-logo"
                                            }
                                            []
                                        )
                                        HTML.element(
                                            "span"
                                            {"class": "fw-semibold"}
                                            [HTML.text("AhdDataStudio")]
                                        )
                                    ]
                                )
                                HTML.element(
                                    "span"
                                    {"class": "badge studio-local-badge"}
                                    [HTML.text(t("local_badge"))]
                                )
                            ]
                        )
                        HTML.element(
                            "div"
                            {"class": "navbar-nav align-items-center"}
                            [
                                HTML.element(
                                    "a"
                                    {
                                        "class": "nav-link"
                                        "href": "/AhdDataStudio"
                                    }
                                    [HTML.text(t("nav_dashboard"))]
                                )
                                HTML.element(
                                    "a"
                                    {
                                        "class": "nav-link"
                                        "href": "/AhdDataStudio/mysql"
                                    }
                                    [HTML.text(t("nav_mysql"))]
                                )
                                HTML.element(
                                    "a"
                                    {
                                        "class": "nav-link"
                                        "href": "/AhdDataStudio/sqlite"
                                    }
                                    [HTML.text(t("nav_sqlite"))]
                                )
                                langSwitch()
                            ]
                        )
                    ]
                )
            ]
        )
        HTML.element(
            "div"
            {"class": "container-fluid"}
            [
                HTML.element(
                    "div"
                    {"class": "row"}
                    [
                        HTML.element(
                            "aside"
                            {"class": "col-md-3 col-lg-2 studio-sidebar py-3"}
                            sideBody
                        )
                        HTML.element(
                            "main"
                            {"class": "col-md-9 col-lg-10 studio-main py-4"}
                            [
                                HTML.element(
                                    "div"
                                    {"class": "studio-content"}
                                    body
                                )
                            ]
                        )
                    ]
                )
            ]
        )
    ]
    return HTML.document("AhdDataStudio · " + title, nodes)
}

errorNodes: Function := (message: String) -> List<HTMLNode> {
    return [
        HTML.element("h1", {"class": "h4"}, [HTML.text(t("error"))])
        HTML.element(
            "div"
            {"class": "alert alert-danger", "role": "alert"}
            [HTML.text(redact(message))]
        )
    ]
}

parsePage: Function := (text: String?) -> Int {
    if text == null {
        return 1
    }
    attempt {
        value: Local Int := int(text)
        if value < 1 {
            return 1
        }
        return value
    }
    except DomainError {
        return 1
    }
    except OverflowError {
        return 1
    }
}

sortDirection: Function := (text: String?) -> String {
    if text == null {
        return "ASC"
    }
    if text.upper() == "DESC" {
        return "DESC"
    }
    return "ASC"
}

