bring HTML
from HTML bring HTMLNode

navLink: Function := (href: String, label: String) -> HTMLNode {
    return HTML.element(
        "a"
        {"href": href, "class": "nav-link"}
        [HTML.text(label)]
    )
}

mysqlActionGroup: Function := (schema: String, table: String) -> HTMLNode {
    fields: Local Pair<String, String> := {"database": schema, "table": table}
    return HTML.element(
        "div"
        {"class": "studio-actions"}
        [
            queryFormClass(
                "/AhdDataStudio/mysql/browse"
                fields
                "Browse"
                "btn btn-sm btn-primary"
            )
            queryFormClass(
                "/AhdDataStudio/mysql/table"
                fields
                "Structure"
                "btn btn-sm btn-outline-secondary"
            )
            queryFormClass(
                "/AhdDataStudio/mysql/indexes"
                fields
                "Indexes"
                "btn btn-sm btn-outline-secondary"
            )
        ]
    )
}

sqliteActionGroup: Function := (path: String, table: String) -> HTMLNode {
    fields: Local Pair<String, String> := {"db": path, "table": table}
    return HTML.element(
