langSwitch: Function := () -> HTMLNode {
    studioLang: Global String
    enClass: Local String := "btn btn-sm btn-outline-secondary"
    trClass: Local String := "btn btn-sm btn-outline-secondary"
    if studioLang == "en" {
        enClass = "btn btn-sm btn-dark"
    }
    if studioLang == "tr" {
        trClass = "btn btn-sm btn-dark"
    }
    return HTML.element(
        "div"
        {"class": "studio-lang btn-group"}
        [
            HTML.element(
                "a"
                {
                    "class": enClass
                    "href": "/AhdDataStudio/lang?lang=en"
                    "title": "English"
                    "aria-current": str(studioLang == "en")
                }
                [HTML.text("EN")]
            )
            HTML.element(
                "a"
                {
                    "class": trClass
                    "href": "/AhdDataStudio/lang?lang=tr"
                    "title": "Türkçe"
                    "aria-current": str(studioLang == "tr")
                }
                [HTML.text("TR")]
            )
        ]
    )
}
