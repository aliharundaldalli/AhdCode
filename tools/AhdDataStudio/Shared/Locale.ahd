bring Env
bring HTML
from HTML bring HTMLNode
bring HTTP
from HTTP bring Request
from HTTP bring Response
from HTTP bring SessionStore
from HTTP bring Session

rememberLang: Function := (session: Session) -> Nothing {
    studioLang: Global String
    stored: Local String? := session.get("lang")
    if stored != null {
        if stored == "tr" or stored == "en" {
            studioLang = stored
            return
        }
    }
    fromEnv: Local String := Env.getOr("AHD_DATA_LANG", "en")
    if fromEnv == "tr" {
        studioLang = "tr"
        return
    }
    studioLang = "en"
}

setStudioLang: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    rememberLang(session)
    lang: Local String? := request.query("lang")
    if lang != null {
        if lang == "tr" or lang == "en" {
            session.set("lang", lang)
            studioLang: Global String
            studioLang = lang
        }
    }
    return sessions.commit(session, HTTP.redirect("/AhdDataStudio"))
}

t: Function := (key: String) -> String {
    studioLang: Global String
    if studioLang == "tr" {
        return tTR(key)
    }
    return tEN(key)
}

