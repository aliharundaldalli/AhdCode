bring Env
bring File
from File bring FileError
bring JSON
from JSON bring JSONValue
from JSON bring JSONError
bring MySQL
from MySQL bring MySQLDatabase
bring Path
// connectMysql opens a server-level connection with no database selected, so
// the caller can list schemas through SHOW DATABASES and INFORMATION_SCHEMA.
// The values come from Shared/Connection.ahd, which starts from the
// AHD_DATA_MYSQL_* environment and is then editable from the connection form.
connectMysql: Function := () -> MySQLDatabase {
    port: Local Int := int(mysqlPortText())
    return MySQL.connect(
        mysqlHost()
        mysqlUser()
        mysqlPassword()
        port
        null
        mysqlSecurity()
    )
}
// registeredSqlitePaths reads the AhdCode database registry.
//
// The registry is written by the CLI (`ahdcode init web admin` registers the
// database it created; `ahdcode databases add` registers one by hand), and
// AHD_DATA_REGISTRY names its location. It holds only metadata -- a driver,
// a path, a display name -- and never a credential, so reading it here adds
// no secret to this process.
//
// A registry that is missing, unreadable, or malformed yields no paths
// rather than an error: the environment-variable sources below are a
// complete configuration on their own, and Studio must still open.
registeredSqlitePaths: Function := () -> List<String> {
    found: Local List<String> := []
    registry: Local String := Env.getOr("AHD_DATA_REGISTRY", "")
    if registry == "" {
        return found
    }
    attempt {
        document: Local JSONValue := JSON.read(registry)
        entries: Local JSONValue? := document.get("databases")
        if entries != null {
            for entry in entries.array() {
                driver: Local JSONValue? := entry.get("driver")
                file: Local JSONValue? := entry.get("path")
                if driver != null {
                    if file != null {
                        if driver.string() == "sqlite" {
                            value: Local String := file.string()
                            if value != "" {
                                if not (value in found) {
                                    found.add(value)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    except JSONError {}
    return found
}
// allowedSqlitePaths is the one allowlist every SQLite page in Studio checks
// a requested path against. v0.19 adds the registry as a third source, ahead
// of the two environment sources it already had, and deduplicates across all
// three in a fixed order so the list is the same on every request.
//
// The discovery rules themselves are unchanged: explicit paths, plus the
// immediate children of AHD_DATA_PROJECT_ROOT. Nothing recursive, nothing
// machine-wide.
allowedSqlitePaths: Function := () -> List<String> {
    found: Local List<String> := []
    for registered in registeredSqlitePaths() {
        if not (registered in found) {
            found.add(registered)
        }
    }
    explicit: Local String := Env.getOr("AHD_DATA_SQLITE_PATHS", "")
    parts: Local List<String> := explicit.split(",")
    for part in parts {
        trimmed: Local String := part.trim()
        if trimmed != "" {
            if not (trimmed in found) {
                found.add(trimmed)
            }
        }
    }
    root: Local String := Env.getOr("AHD_DATA_PROJECT_ROOT", "")
    if root != "" {
        attempt {
            names: Local List<String> := File.list(root)
            for name in names {
                if isSafeComponent(name) {
                    candidate: Local String := Path.join([root, name])
                    if isSqliteExt(candidate) {
                        if not isDirectoryPath(candidate) {
                            if not (candidate in found) {
                                found.add(candidate)
                            }
                        }
                    }
                }
            }
        }
        except FileError {}
    }
    return found
}

sqlitePathAllowed: Function := (path: String) -> Bool {
    allowed: Local List<String> := allowedSqlitePaths()
    return path in allowed
}

sqliteFileAvailable: Function := (path: String) -> Bool {
    return File.exists(path)
}

sqliteRegistryOwned: Function := (path: String) -> Bool {
    registered: Local List<String> := registeredSqlitePaths()
    return path in registered
}
// forgetRegisteredSqlite drops one registry entry from AHD_DATA_REGISTRY.
// It rewrites the same CLI registry document and never deletes a SQLite file.
forgetRegisteredSqlite: Function := (path: String) -> Bool {
    registry: Local String := Env.getOr("AHD_DATA_REGISTRY", "")
    if registry == "" {
        return false
    }
    if sqliteRegistryOwned(path) == false {
        return false
    }
    attempt {
        document: Local JSONValue := JSON.read(registry)
        entries: Local JSONValue? := document.get("databases")
        kept: Local List<JSONValue> := []
        removed: Local Bool := false
        if entries != null {
            for entry in entries.array() {
                file: Local JSONValue? := entry.get("path")
                if file != null {
                    if file.string() == path {
                        removed = true
                    }
                    else {
                        kept.add(entry)
                    }
                }
                else {
                    kept.add(entry)
                }
            }
        }
        if removed == false {
            return false
        }
        JSON.write(
            JSON.object(
                {
                    "schema": JSON.fromString("ahdcode.localdatabases")
                    "version": JSON.fromInt(1)
                    "databases": JSON.array(kept)
                }
            )
            registry
            true
        )
        return true
    }
    except JSONError {
        return false
    }
}

isSqliteExt: Function := (path: String) -> Bool {
    ext: Local String := Path.ext(path).lower()
    return ext == ".db" or ext == ".sqlite" or ext == ".sqlite3"
}

isDirectoryPath: Function := (path: String) -> Bool {
    attempt {
        File.list(path)
        return true
    }
    except FileError {
        return false
    }
}

isSafeComponent: Function := (name: String) -> Bool {
    if name == "" or name == "." or name == ".." {
        return false
    }
    if name.contains("/") or name.contains("\\") {
        return false
    }
    return true
}

looksLikeQuery: Function := (sql: String) -> Bool {
    trimmed: Local String := sql.trim().lower()
    if trimmed.startsWith("select") {
        return true
    }
    if trimmed.startsWith("show") {
        return true
    }
    if trimmed.startsWith(
        "describe"
    ) or trimmed.startsWith("desc ") or trimmed == "desc" {
        return true
    }
    if trimmed.startsWith("explain") {
        return true
    }
    if trimmed.startsWith("with") {
        return true
    }
    if trimmed.startsWith("pragma") {
        return true
    }
    return false
}
