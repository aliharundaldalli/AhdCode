                                                )
                                                statusBadge(
                                                    mysqlStatus
                                                    mysqlOk
                                                )
                                            ]
                                        )
                                        HTML.element(
                                            "p"
                                            {"class": "text-muted mb-3"}
                                            [HTML.text(mysqlDetail)]
                                        )
                                        HTML.element(
                                            "a"
                                            {
                                                "class": "btn btn-primary btn-sm"
                                                "href": "/AhdDataStudio/mysql"
                                            }
                                            [HTML.text("Open MySQL")]
                                        )
                                    ]
                                )
                            ]
                        )
                    ]
                )
                HTML.element(
                    "div"
                    {"class": "col-lg-6"}
                    [
                        HTML.element(
                            "div"
                            {"class": "card studio-card h-100"}
                            [
                                HTML.element(
                                    "div"
                                    {"class": "card-body"}
                                    [
                                        HTML.element(
                                            "div"
                                            {
                                                "class": "d-flex justify-content-between align-items-start mb-3"
                                            }
                                            [
                                                HTML.element(
                                                    "div"
                                                    {
                                                        "class": "d-flex gap-3 align-items-center"
                                                    }
                                                    [
                                                        HTML.element(
                                                            "span"
                                                            {
                                                                "class": "studio-provider-icon sqlite"
                                                            }
                                                            [HTML.text("S")]
