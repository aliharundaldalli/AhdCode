// AhdDataStudio — local database development UI.
//
// Written in AhdCode against the released HTTP, HTML, MySQL, SQLite, Env,
// File, Path, and Security modules, plus v0.14's require(...) and
// Server.static application foundations: this entry file composes the
// application out of local source files under Shared/, Components/,
// Pages/, MySQL/, and SQLite/, and serves its local UI assets through
// Server.static rather than one HTTP.file route per file.
//
//   cd tools/AhdDataStudio
//   ahdcode run app.ahd
//   open http://127.0.0.1:8081/AhdDataStudio
//   ahdcode kill app.run
//
// Binds 127.0.0.1 only. Do not change the host to 0.0.0.0.
require("Shared/Config.ahd")
require("Shared/Redaction.ahd")
require("Shared/Database.ahd")
require("Shared/CSRF.ahd")
require("Components/Forms.ahd")
require("Components/Navigation.ahd")
require("Components/Tables.ahd")
require("Components/Layout.ahd")
require("Pages/Dashboard.ahd")
require("MySQL/Helpers.ahd")
require("MySQL/Home.ahd")
require("MySQL/Database.ahd")
require("MySQL/Structure.ahd")
require("MySQL/Indexes.ahd")
require("MySQL/Browse.ahd")
require("MySQL/SQL.ahd")
require("SQLite/Helpers.ahd")
require("SQLite/Home.ahd")
require("SQLite/Structure.ahd")
require("SQLite/Indexes.ahd")
require("SQLite/Browse.ahd")
require("SQLite/SQL.ahd")

bring Env
bring File
bring HTML
bring HTTP
bring Security
from Env bring EnvError
from HTML bring HTMLError
from HTTP bring Server
from HTTP bring HTTPError
from Security bring SecurityError

// staticAssetsRoot mirrors the old per-file bootstrapPath/logoPath fallback:
// AhdDataStudio can be started either from the repository root or from
// tools/AhdDataStudio itself, so its own assets/ directory is preferred
// when present and the path relative to the repository root is the
// fallback. Both files this app ships (bootstrap.min.css, the logo) live
// together under the same directory, so one static root covers both.
staticAssetsRoot: Function := () -> String {
    if File.exists("assets/bootstrap.min.css") {
        return "assets"
    }
    return "tools/AhdDataStudio/assets"
}

startStudio: Function := () -> Nothing {
    loadEnvFile()
    app: Local Server := HTTP.server("127.0.0.1", 8081)
    app.static("/AhdDataStudio/assets", staticAssetsRoot())
    app.get("/AhdDataStudio", home)
    app.get("/AhdDataStudio/mysql", mysqlHome)
    app.get("/AhdDataStudio/mysql/database", mysqlDatabasePage)
    app.get("/AhdDataStudio/mysql/table", mysqlStructurePage)
    app.get("/AhdDataStudio/mysql/indexes", mysqlIndexesPage)
    app.get("/AhdDataStudio/mysql/browse", mysqlBrowsePage)
    app.get("/AhdDataStudio/mysql/sql", mysqlSqlPage)
    app.post("/AhdDataStudio/mysql/sql", mysqlSqlRun)
    app.post("/AhdDataStudio/mysql/insert", mysqlInsert)
    app.post("/AhdDataStudio/mysql/update", mysqlUpdate)
    app.post("/AhdDataStudio/mysql/delete", mysqlDelete)
    app.get("/AhdDataStudio/mysql/confirm", mysqlConfirmPage)
    app.post("/AhdDataStudio/mysql/drop", mysqlDrop)
    app.post("/AhdDataStudio/mysql/truncate", mysqlTruncate)
    app.get("/AhdDataStudio/sqlite", sqliteHome)
    app.get("/AhdDataStudio/sqlite/database", sqliteOpenPage)
    app.get("/AhdDataStudio/sqlite/table", sqliteStructurePage)
    app.get("/AhdDataStudio/sqlite/indexes", sqliteIndexesPage)
    app.get("/AhdDataStudio/sqlite/browse", sqliteBrowsePage)
    app.get("/AhdDataStudio/sqlite/sql", sqliteSqlPage)
    app.post("/AhdDataStudio/sqlite/sql", sqliteSqlRun)
    app.post("/AhdDataStudio/sqlite/insert", sqliteInsert)
    app.post("/AhdDataStudio/sqlite/update", sqliteUpdate)
    app.post("/AhdDataStudio/sqlite/delete", sqliteDelete)
    app.get("/AhdDataStudio/sqlite/confirm", sqliteConfirmPage)
    app.post("/AhdDataStudio/sqlite/drop", sqliteDrop)
    write("AhdDataStudio listening on http://127.0.0.1:8081/AhdDataStudio")
    app.start()
}

attempt {
    startStudio()
}
except HTTPError as error {
    write("HTTP error: " + redact(error.message))
}
except EnvError as error {
    write("Env error: " + redact(error.message))
}
except HTMLError as error {
    write("HTML error: " + redact(error.message))
}
except SecurityError as error {
    write("Security error: " + redact(error.message))
}
