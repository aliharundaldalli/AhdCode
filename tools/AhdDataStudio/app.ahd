sqliteNav: Function := (
    path: String
    table: String
    current: String
) -> HTMLNode {
    fields: Local Pair<String, String> := {"db": path, "table": table}
    browseClass: Local String := "nav-link"
    structureClass: Local String := "nav-link"
    indexClass: Local String := "nav-link"
    sqlClass: Local String := "nav-link"
    if current == "browse" {
        browseClass = "nav-link active"
    }
    if current == "structure" {
        structureClass = "nav-link active"
    }
    if current == "indexes" {
        indexClass = "nav-link active"
    }
    if current == "sql" {
        sqlClass = "nav-link active"
    }
    return HTML.element(
        "ul"
        {"class": "nav nav-tabs studio-tabs mb-3"}
        [
            HTML.element(
                "li"
                {"class": "nav-item"}
                [
                    queryFormClass(
                        "/AhdDataStudio/sqlite"
                        {}
                        "Databases"
                        "nav-link"
                    )
                ]
            )
            HTML.element(
                "li"
                {"class": "nav-item"}
                [
                    queryFormClass(
                        "/AhdDataStudio/sqlite/browse"
                        fields
                        "Browse"
                        browseClass
                    )
                ]
            )
            HTML.element(
                "li"
                {"class": "nav-item"}
                [
                    queryFormClass(
                        "/AhdDataStudio/sqlite/table"
                        fields
                        "Structure"
                        structureClass
                    )
                ]
            )
            HTML.element(
                "li"
                {"class": "nav-item"}
                [
                    queryFormClass(
                        "/AhdDataStudio/sqlite/indexes"
                        fields
                        "Indexes"
                        indexClass
                    )
                ]
            )
            HTML.element(
                "li"
                {"class": "nav-item"}
                [
                    queryFormClass(
                        "/AhdDataStudio/sqlite/sql"
                        {"db": path}
                        "SQL"
                        sqlClass
                    )
                ]
            )
        ]
    )
}

sqliteHome: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    files: Local List<String> := allowedSqlitePaths()
    dbRows: Local List<HTMLNode> := []
    for path in files {
        dbRows.add(
            HTML.element(
                "tr"
                {}
                [
                    HTML.element(
                        "td"
                        {}
                        [
                            HTML.element(
                                "strong"
                                {}
                                [HTML.text(Path.base(path))]
                            )
                        ]
                    )
                    HTML.element(
                        "td"
                        {"class": "text-muted small studio-mono"}
                        [HTML.text(path)]
                    )
                    HTML.element(
                        "td"
                        {"class": "text-end"}
                        [
                            queryFormClass(
                                "/AhdDataStudio/sqlite/database"
                                {"db": path}
                                "Open"
                                "btn btn-sm btn-primary"
                            )
                        ]
                    )
                ]
            )
        )
    }
    body: Local List<HTMLNode> := [
        HTML.element(
            "div"
            {"class": "studio-page-heading"}
            [
                HTML.element(
                    "div"
                    {"class": "eyebrow"}
                    [HTML.text("Project-scoped databases")]
                )
                HTML.element("h1", {"class": "h4 mb-1"}, [HTML.text("SQLite")])
                HTML.element(
                    "p"
                    {"class": "text-muted mb-0"}
                    [
                        HTML.text(
                            "Only explicitly configured database paths and SQLite files that are immediate children of AHD_DATA_PROJECT_ROOT are listed."
                        )
                    ]
                )
            ]
        )
    ]
    if len(files) == 0 {
        body.add(
            emptyState(
                "No project databases found"
                "Set AHD_DATA_SQLITE_PATHS for explicit files, or AHD_DATA_PROJECT_ROOT to discover .db, .sqlite, and .sqlite3 files directly inside a project folder. AhdDataStudio never scans the whole machine."
            )
        )
    }
    else {
        body.add(
            HTML.element(
                "div"
                {"class": "studio-table-wrap"}
                [
                    HTML.element(
                        "table"
                        {
                            "class": "table table-sm table-hover align-middle studio-table"
                        }
                        [
                            HTML.element(
                                "thead"
                                {"class": "table-light"}
                                [
                                    HTML.element(
                                        "tr"
                                        {}
                                        [
                                            HTML.element(
                                                "th"
                                                {}
                                                [HTML.text("Database")]
                                            )
                                            HTML.element(
                                                "th"
                                                {}
                                                [HTML.text("Path")]
                                            )
                                            HTML.element(
                                                "th"
                                                {"class": "text-end"}
                                                [HTML.text("Action")]
                                            )
                                        ]
                                    )
                                ]
                            )
                            HTML.element("tbody", {}, dbRows)
                        ]
                    )
                ]
            )
        )
    }
    return sessions.commit(session, HTTP.html(layout("SQLite", token, body)))
}

openAllowedSqlite: Function := (path: String) -> Database? {
    if not sqlitePathAllowed(path) {
        return null
    }
    if isDirectoryPath(path) {
        return null
    }
    return SQLite.open(path)
}

sqliteOpenPage: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    path: Local String? := request.query("db")
    if path == null {
        path = request.form("db")
    }
    if path == null {
        return sessions.commit(
            session
            HTTP.html(layout("SQLite", token, errorNodes("db is required")))
        )
    }
    attempt {
        db: Local Database? := openAllowedSqlite(path)
        if db == null {
            return sessions.commit(
                session
                HTTP.html(
                    layout(
                        "SQLite"
                        token
                        errorNodes(
                            "sqlite path is not in the allowed project set"
                        )
                    )
                )
            )
        }
        attempt {
            tables: Local List<Pair<String, String>> := sqliteTables(db)
            tableRows: Local List<HTMLNode> := []
            for table in tables {
                name: Local String := table["name"]
                tableRows.add(
                    HTML.element(
                        "tr"
                        {}
                        [
                            HTML.element(
                                "td"
                                {}
                                [
                                    HTML.element(
                                        "code"
                                        {"class": "studio-name", "title": name}
                                        [HTML.text(name)]
                                    )
                                ]
                            )
                            HTML.element(
                                "td"
                                {"class": "studio-actions-cell"}
                                [sqliteActionGroup(path, name)]
                            )
                            HTML.element("td", {}, [typeBadge(table["type"])])
                        ]
                    )
                )
            }
            body: Local List<HTMLNode> := [
                HTML.element(
                    "h1"
                    {"class": "h4 mb-1"}
                    [HTML.text(Path.base(path))]
                )
                HTML.element(
                    "p"
                    {"class": "text-muted small"}
                    [HTML.text(path)]
                )
                HTML.element(
                    "div"
                    {"class": "d-flex justify-content-end mb-2"}
                    [
                        queryFormClass(
                            "/AhdDataStudio/sqlite/sql"
                            {"db": path}
                            "SQL console"
                            "btn btn-sm btn-outline-primary"
                        )
                    ]
                )
                HTML.element(
                    "div"
                    {"class": "table-responsive"}
                    [
                        HTML.element(
                            "table"
                            {
                                "class": "table table-sm table-striped table-hover align-middle bg-white studio-table"
                            }
                            [
                                HTML.element(
                                    "thead"
                                    {"class": "table-light"}
                                    [
                                        HTML.element(
                                            "tr"
                                            {}
                                            [
                                                HTML.element(
                                                    "th"
                                                    {}
                                                    [HTML.text("Table")]
                                                )
                                                HTML.element(
                                                    "th"
                                                    {}
                                                    [HTML.text("Action")]
                                                )
                                                HTML.element(
                                                    "th"
                                                    {}
                                                    [HTML.text("Type")]
                                                )
                                            ]
                                        )
                                    ]
                                )
                                HTML.element("tbody", {}, tableRows)
                            ]
                        )
                    ]
                )
            ]
            return sessions.commit(
                session
                HTTP.html(layout("SQLite", token, body))
            )
        }
        except SQLiteError as error {
            return sessions.commit(
                session
                HTTP.html(layout("SQLite", token, errorNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except SQLiteError as error {
        return sessions.commit(
            session
            HTTP.html(layout("SQLite", token, errorNodes(error.message)))
        )
    }
}

sqliteStructurePage: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    path: Local String? := request.query("db")
    table: Local String? := request.query("table")
    if path == null or table == null {
        return sessions.commit(
            session
            HTTP.html(
                layout("SQLite", token, errorNodes("db and table are required"))
            )
        )
    }
    attempt {
        db: Local Database? := openAllowedSqlite(path)
        if db == null {
            return sessions.commit(
                session
                HTTP.html(
                    layout(
                        "SQLite"
                        token
                        errorNodes(
                            "sqlite path is not in the allowed project set"
                        )
                    )
                )
            )
        }
        attempt {
            if not (table in sqliteTableNames(db)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("SQLite", token, errorNodes("unknown table"))
                    )
                )
            }
            columns: Local List<Pair<String, String>> := sqliteColumns(
                db
                table
            )
            rows: Local List<List<String>> := []
            insertFields: Local List<HTMLNode> := [
                csrfField(token)
                hiddenField("db", path)
                hiddenField("table", table)
            ]
            for column in columns {
                rows.add(
                    [
                        column["name"]
                        column["type"]
                        column["nullable"]
                        column["default"]
                        column["key"]
                    ]
                )
                insertFields.add(
                    fieldNode(
                        column["name"]
                        column["type"]
                        column["nullable"]
                    )
                )
            }
            insertFields.add(
                HTML.element(
                    "div"
                    {"class": "col-12"}
                    [
                        HTML.element(
                            "button"
                            {
                                "type": "submit"
                                "class": "btn btn-primary btn-sm"
                            }
                            [HTML.text("Insert row")]
                        )
                    ]
                )
            )
            body: Local List<HTMLNode> := [
                HTML.element("h1", {"class": "h4 mb-1"}, [HTML.text(table)])
                HTML.element(
                    "p"
                    {"class": "small text-muted studio-mono"}
                    [HTML.text(Path.base(path))]
                )
                sqliteNav(path, table, "structure")
                htmlTable(
                    ["Column", "Type", "Nullable", "Default", "Key"]
                    rows
                )
                HTML.element(
                    "div"
                    {"class": "studio-panel mt-3"}
                    [
                        HTML.element(
                            "h2"
                            {"class": "h6 mb-3"}
                            [HTML.text("Insert row")]
                        )
                        HTML.element(
                            "form"
                            {
                                "method": "post"
                                "action": "/AhdDataStudio/sqlite/insert"
                                "class": "row g-3"
                            }
                            insertFields
                        )
                    ]
                )
                HTML.element(
                    "div"
                    {"class": "studio-danger mt-3"}
                    [
                        HTML.element(
                            "h2"
                            {"class": "h6 text-danger mb-1"}
                            [HTML.text("Danger zone")]
                        )
                        HTML.element(
                            "p"
                            {"class": "small text-muted mb-3"}
                            [
                                HTML.text(
                                    "Dropping this table requires a separate confirmation POST."
                                )
                            ]
                        )
                        queryFormClass(
                            "/AhdDataStudio/sqlite/confirm"
                            {"db": path, "table": table, "action": "drop"}
                            "Drop table…"
                            "btn btn-sm btn-outline-danger"
                        )
                    ]
                )
            ]
            return sessions.commit(
                session
                HTTP.html(layout(table, token, body))
            )
        }
        except SQLiteError as error {
            return sessions.commit(
                session
                HTTP.html(layout("SQLite", token, errorNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except SQLiteError as error {
        return sessions.commit(
            session
            HTTP.html(layout("SQLite", token, errorNodes(error.message)))
        )
    }
}

sqliteIndexesPage: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    path: Local String? := request.query("db")
    table: Local String? := request.query("table")
    if path == null or table == null {
        return sessions.commit(
            session
            HTTP.html(
                layout("SQLite", token, errorNodes("db and table are required"))
            )
        )
    }
    attempt {
        db: Local Database? := openAllowedSqlite(path)
        if db == null {
            return sessions.commit(
                session
                HTTP.html(
                    layout(
                        "SQLite"
                        token
                        errorNodes(
                            "sqlite path is not in the allowed project set"
                        )
                    )
                )
            )
        }
        attempt {
            if not (table in sqliteTableNames(db)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("SQLite", token, errorNodes("unknown table"))
                    )
                )
            }
            listRows: Local List<Pair<String, SQLiteValue>> := db.query(
                "PRAGMA index_list(" + quoteSqlite(table) + ")"
            )
            rows: Local List<List<String>> := []
            for indexRow in listRows {
                indexName: Local String := ""
                unique: Local String := "non-unique"
                if "name" in indexRow {
                    if indexRow["name"].kind() == "String" {
                        indexName = indexRow["name"].string()
                    }
                }
                if "unique" in indexRow {
                    if indexRow["unique"].kind() == "Int" {
                        if indexRow["unique"].int() != 0 {
                            unique = "unique"
                        }
                    }
                }
                infoRows: Local List<Pair<String, SQLiteValue>> := db.query(
                    "PRAGMA index_info(" + quoteSqlite(indexName) + ")"
                )
                for info in infoRows {
                    column: Local String := ""
                    seq: Local String := ""
                    if "name" in info {
                        if info["name"].kind() == "String" {
                            column = info["name"].string()
                        }
                    }
                    if "seqno" in info {
                        if info["seqno"].kind() == "Int" {
                            seq = str(info["seqno"].int())
                        }
                    }
                    rows.add([indexName, unique, column, seq])
                }
            }
            body: Local List<HTMLNode> := [
                HTML.element(
                    "h1"
                    {"class": "h4"}
                    [HTML.text("Indexes · " + table)]
                )
                sqliteNav(path, table, "indexes")
                htmlTable(["Index", "Uniqueness", "Column", "Sequence"], rows)
            ]
            return sessions.commit(
                session
                HTTP.html(layout("Indexes", token, body))
            )
        }
        except SQLiteError as error {
            return sessions.commit(
                session
                HTTP.html(layout("SQLite", token, errorNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except SQLiteError as error {
        return sessions.commit(
            session
            HTTP.html(layout("SQLite", token, errorNodes(error.message)))
        )
    }
}

sqliteBrowsePage: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    pageSize: Global Int
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    path: Local String? := request.query("db")
    table: Local String? := request.query("table")
    if path == null or table == null {
        return sessions.commit(
            session
            HTTP.html(
                layout("SQLite", token, errorNodes("db and table are required"))
            )
        )
    }
    page: Local Int := parsePage(request.query("page"))
    direction: Local String := sortDirection(request.query("dir"))
    sortCol: Local String? := request.query("sort")
    attempt {
        db: Local Database? := openAllowedSqlite(path)
        if db == null {
            return sessions.commit(
                session
                HTTP.html(
                    layout(
                        "SQLite"
                        token
                        errorNodes(
                            "sqlite path is not in the allowed project set"
                        )
                    )
                )
            )
        }
        attempt {
            if not (table in sqliteTableNames(db)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("SQLite", token, errorNodes("unknown table"))
                    )
                )
            }
            columns: Local List<Pair<String, String>> := sqliteColumns(
                db
                table
            )
            browseCols: Local List<String> := sqliteBrowseColumns(columns)
            if len(browseCols) == 0 {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout(
                            "SQLite"
                            token
                            errorNodes("no non-BLOB columns to browse")
                        )
                    )
                )
            }
            orderColumn: Local String := browseCols[0]
            if sortCol != null {
                if sortCol in browseCols {
                    orderColumn = sortCol
                }
            }
            selectList: Local String := quoteSqlite(browseCols[0])
            index: Local Int := 1
            while index < len(browseCols) {
                selectList = selectList + ", " + quoteSqlite(browseCols[index])
                index++
            }
            offset: Local Int := (page - 1) * pageSize
            sql: Local String := "SELECT " + selectList + " FROM " + quoteSqlite(
                table
            ) + " ORDER BY " + quoteSqlite(
                orderColumn
            ) + " " + direction + " LIMIT ? OFFSET ?"
            data: Local List<Pair<String, SQLiteValue>> := db.query(
                sql
                [SQLite.fromInt(pageSize), SQLite.fromInt(offset)]
            )
            rows: Local List<List<String>> := []
            for dataRow in data {
                cells: Local List<String> := []
                for header in browseCols {
                    if header in dataRow {
                        cells.add(formatSqliteValue(dataRow[header]))
                    }
                    else {
                        cells.add("")
                    }
                }
                rows.add(cells)
            }
            pkCols: Local List<String> := mysqlPrimaryColumns(columns)
            actionNodes: Local List<HTMLNode> := []
            rowNumber: Local Int := offset + 1
            for dataRow in data {
                if len(pkCols) > 0 {
                    deleteChildren: Local List<HTMLNode> := [
                        csrfField(token)
                        hiddenField("db", path)
                        hiddenField("table", table)
                    ]
                    updateChildren: Local List<HTMLNode> := [
                        csrfField(token)
                        hiddenField("db", path)
                        hiddenField("table", table)
                    ]
                    pkSummary: Local String := ""
                    for pk in pkCols {
                        pkValue: Local String := ""
                        if pk in dataRow {
                            pkValue = formatSqliteValue(dataRow[pk])
                        }
                        deleteChildren.add(hiddenField("pk_" + pk, pkValue))
                        updateChildren.add(hiddenField("pk_" + pk, pkValue))
                        if pkSummary != "" {
                            pkSummary = pkSummary + " · "
                        }
                        pkSummary = pkSummary + pk + "=" + pkValue
                    }
                    fieldNodes: Local List<HTMLNode> := []
                    for header in browseCols {
                        if not (header in pkCols) {
                            current: Local String := ""
                            if header in dataRow {
                                current = formatSqliteValue(dataRow[header])
                            }
                            fieldNodes.add(
                                HTML.element(
                                    "div"
                                    {}
                                    [
                                        HTML.element(
                                            "label"
                                            {"class": "small text-muted mb-1"}
                                            [HTML.text(header)]
                                        )
                                        HTML.element(
                                            "input"
                                            {
                                                "type": "text"
                                                "name": "col_" + header
                                                "value": current
                                                "class": "form-control form-control-sm"
                                            }
                                            []
                                        )
                                    ]
                                )
                            )
                        }
                    }
                    for field in fieldNodes {
                        updateChildren.add(field)
                    }
                    updateChildren.add(
                        HTML.element(
                            "button"
                            {
                                "type": "submit"
                                "class": "btn btn-sm btn-primary mt-2"
                            }
                            [HTML.text("Update row")]
                        )
                    )
                    deleteChildren.add(
                        HTML.element(
                            "button"
                            {
                                "type": "submit"
                                "class": "btn btn-sm btn-outline-danger"
                            }
                            [HTML.text("Delete row")]
                        )
                    )
                    actionNodes.add(
                        HTML.element(
                            "div"
                            {"class": "studio-row-action"}
                            [
                                HTML.element(
                                    "div"
                                    {
                                        "class": "d-flex justify-content-between align-items-start gap-3 mb-2"
                                    }
                                    [
                                        HTML.element(
                                            "div"
                                            {}
                                            [
                                                HTML.element(
                                                    "div"
                                                    {
                                                        "class": "small fw-semibold"
                                                    }
                                                    [
                                                        HTML.text(
                                                            "Row " + str(
                                                                rowNumber
                                                            )
                                                        )
                                                    ]
                                                )
                                                HTML.element(
                                                    "div"
                                                    {
                                                        "class": "small text-muted studio-mono"
                                                    }
                                                    [HTML.text(pkSummary)]
                                                )
                                            ]
                                        )
                                        HTML.element(
                                            "form"
                                            {
                                                "method": "post"
                                                "action": "/AhdDataStudio/sqlite/delete"
                                            }
                                            deleteChildren
                                        )
                                    ]
                                )
                                HTML.element(
                                    "form"
                                    {
                                        "method": "post"
                                        "action": "/AhdDataStudio/sqlite/update"
                                    }
                                    [
                                        HTML.element(
                                            "div"
                                            {
                                                "class": "studio-row-action-fields"
                                            }
                                            updateChildren
                                        )
                                    ]
                                )
                            ]
                        )
                    )
                }
                rowNumber++
            }
            pager: Local List<HTMLNode> := []
            if page > 1 {
                pager.add(
                    queryFormClass(
                        "/AhdDataStudio/sqlite/browse"
                        {
                            "db": path
                            "table": table
                            "page": str(page - 1)
                            "sort": orderColumn
                            "dir": direction
                        }
                        "← Previous"
                        "btn btn-sm btn-outline-secondary"
                    )
                )
            }
            if len(data) == pageSize {
                pager.add(
                    queryFormClass(
                        "/AhdDataStudio/sqlite/browse"
                        {
                            "db": path
                            "table": table
                            "page": str(page + 1)
                            "sort": orderColumn
                            "dir": direction
                        }
                        "Next →"
                        "btn btn-sm btn-outline-secondary"
                    )
                )
            }
            sortLinks: Local List<HTMLNode> := []
            for name in browseCols {
                ascClass: Local String := "btn btn-sm btn-light border"
                descClass: Local String := "btn btn-sm btn-light border"
                if name == orderColumn and direction == "ASC" {
                    ascClass = "btn btn-sm btn-primary"
                }
                if name == orderColumn and direction == "DESC" {
                    descClass = "btn btn-sm btn-primary"
                }
                sortLinks.add(
                    queryFormClass(
                        "/AhdDataStudio/sqlite/browse"
                        {"db": path, "table": table, "sort": name, "dir": "ASC"}
                        name + " ↑"
                        ascClass
                    )
                )
                sortLinks.add(
                    queryFormClass(
                        "/AhdDataStudio/sqlite/browse"
                        {
                            "db": path
                            "table": table
                            "sort": name
                            "dir": "DESC"
                        }
                        name + " ↓"
                        descClass
                    )
                )
            }
            body: Local List<HTMLNode> := [
                HTML.element(
                    "h1"
                    {"class": "h4 mb-1"}
                    [HTML.text("Browse · " + table)]
                )
                HTML.element(
                    "p"
                    {"class": "small text-muted studio-mono"}
                    [HTML.text(Path.base(path))]
                )
                sqliteNav(path, table, "browse")
                HTML.element(
                    "div"
                    {
                        "class": "d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2"
                    }
                    [
                        HTML.element(
                            "span"
                            {"class": "small text-muted"}
                            [
                                HTML.text(
                                    "Page " + str(
                                        page
                                    ) + " · up to " + str(pageSize) + " rows"
                                )
                            ]
                        )
                        HTML.element(
                            "span"
                            {"class": "small text-muted"}
                            [
                                HTML.text(
                                    "Declared BLOB columns are omitted from browse."
                                )
                            ]
                        )
                    ]
                )
                HTML.element("div", {"class": "studio-sortbar"}, sortLinks)
            ]
            if len(data) == 0 {
                body.add(
                    emptyState(
                        "No rows on this page"
                        "The table is empty at this offset, or there are no more rows to display."
                    )
                )
            }
            else {
                body.add(htmlTable(browseCols, rows))
            }
            body.add(
                HTML.element(
                    "div"
                    {"class": "studio-pagination"}
                    [
                        HTML.element(
                            "span"
                            {"class": "small text-muted"}
                            [HTML.text("Page " + str(page))]
                        )
                        HTML.element("div", {"class": "pager-actions"}, pager)
                    ]
                )
            )
            if len(actionNodes) > 0 {
                body.add(
                    HTML.element(
                        "h2"
                        {"class": "h6 mt-4 mb-1"}
                        [HTML.text("Row actions")]
                    )
                )
                body.add(
                    HTML.element(
                        "p"
                        {"class": "small text-muted"}
                        [
                            HTML.text(
                                "Updates and deletes require a primary key and keep the existing SQLite contract."
                            )
                        ]
                    )
                )
                for action in actionNodes {
                    body.add(action)
                }
            }
            return sessions.commit(
                session
                HTTP.html(layout("Browse", token, body))
            )
        }
        except SQLiteError as error {
            return sessions.commit(
                session
                HTTP.html(layout("SQLite", token, errorNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except SQLiteError as error {
        return sessions.commit(
            session
            HTTP.html(layout("SQLite", token, errorNodes(error.message)))
        )
    }
}

sqliteSqlPage: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    pathQuery: Local String? := request.query("db")
    path: Local String := ""
    if pathQuery != null {
        path = pathQuery
    }
    context: Local String := "No database selected"
    if path != "" {
        context = Path.base(path)
    }
    body: Local List<HTMLNode> := [
        HTML.element(
            "h1"
            {"class": "h4 mb-1"}
            [HTML.text("SQLite SQL console")]
        )
        HTML.element(
            "p"
            {"class": "small text-muted studio-mono"}
            [HTML.text(context)]
        )
        HTML.element(
            "div"
            {"class": "alert alert-warning py-2 small"}
            [
                HTML.text(
                    "This console runs the SQL you type exactly as entered. Destructive statements are not extra-confirmed."
                )
            ]
        )
        HTML.element(
            "div"
            {"class": "studio-sql"}
            [
                HTML.element(
                    "form"
                    {"method": "post", "action": "/AhdDataStudio/sqlite/sql"}
                    [
                        csrfField(token)
                        hiddenField("db", path)
                        HTML.element(
                            "label"
                            {"class": "form-label small fw-semibold"}
                            [HTML.text("SQL")]
                        )
                        HTML.element(
                            "textarea"
                            {
                                "name": "sql"
                                "class": "form-control mb-3"
                                "placeholder": "SELECT ..."
                            }
                            [HTML.text("")]
                        )
                        HTML.element(
                            "div"
                            {
                                "class": "d-flex justify-content-between align-items-center"
                            }
                            [
                                HTML.element(
                                    "span"
                                    {"class": "small text-muted"}
                                    [
                                        HTML.text(
                                            "Runs against the selected project database."
                                        )
                                    ]
                                )
                                HTML.element(
                                    "button"
                                    {
                                        "type": "submit"
                                        "class": "btn btn-primary btn-sm px-3"
                                    }
                                    [HTML.text("Run query")]
                                )
                            ]
                        )
                    ]
                )
            ]
        )
    ]
    return sessions.commit(session, HTTP.html(layout("SQL", token, body)))
}

sqliteSqlRun: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    if request.method() != "POST" {
        return sessions.commit(
            session
            HTTP.html(
                layout("SQL", token, errorNodes("SQL console requires POST"))
                405
            )
        )
    }
    if not csrfOK(request, session) {
        return sessions.commit(
            session
            HTTP.html(
                layout(
                    "SQL"
                    token
                    errorNodes("rejected: CSRF token missing or invalid")
                )
                403
            )
        )
    }
    sqlText: Local String? := request.form("sql")
    path: Local String? := request.form("db")
    if sqlText == null or path == null {
        return sessions.commit(
            session
            HTTP.html(
                layout("SQL", token, errorNodes("db and sql are required"))
            )
        )
    }
    rotateCsrf(session)
    token = csrfToken(session)
    attempt {
        db: Local Database? := openAllowedSqlite(path)
        if db == null {
            return sessions.commit(
                session
                HTTP.html(
                    layout(
                        "SQLite"
                        token
                        errorNodes(
                            "sqlite path is not in the allowed project set"
                        )
                    )
                )
            )
        }
        attempt {
            body: Local List<HTMLNode> := [
                HTML.element("h1", {}, [HTML.text("SQLite SQL console")])
                HTML.element(
                    "div"
                    {"class": "alert alert-warning"}
                    [HTML.text("This console ran your SQL exactly as entered.")]
                )
            ]
            if looksLikeQuery(sqlText) {
                data: Local List<Pair<String, SQLiteValue>> := db.query(sqlText)
                headers: Local List<String> := []
                rows: Local List<List<String>> := []
                if len(data) > 0 {
                    for key in data[0] {
                        headers.add(key)
                    }
                    for dataRow in data {
                        cells: Local List<String> := []
                        for header in headers {
                            cells.add(formatSqliteValue(dataRow[header]))
                        }
                        rows.add(cells)
                    }
                }
                body.add(
                    HTML.element(
                        "p"
                        {}
                        [HTML.text(str(len(data)) + " row(s)")]
                    )
                )
                if len(headers) > 0 {
                    body.add(htmlTable(headers, rows))
                }
            }
            else {
                changed: Local Int := db.execute(sqlText)
                body.add(
                    HTML.element(
                        "p"
                        {}
                        [HTML.text("affected rows: " + str(changed))]
                    )
                )
            }
            body.add(
                HTML.element(
                    "form"
                    {"method": "post", "action": "/AhdDataStudio/sqlite/sql"}
                    [
                        csrfField(token)
                        hiddenField("db", path)
                        HTML.element(
                            "textarea"
                            {"name": "sql", "class": "form-control mb-2"}
                            [HTML.text(sqlText)]
                        )
                        HTML.element(
                            "button"
                            {"type": "submit", "class": "btn btn-primary"}
                            [HTML.text("Run")]
                        )
                    ]
                )
            )
            return sessions.commit(
                session
                HTTP.html(layout("SQL", token, body))
            )
        }
        except SQLiteError as error {
            return sessions.commit(
                session
                HTTP.html(layout("SQLite", token, errorNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except SQLiteError as error {
        return sessions.commit(
            session
            HTTP.html(layout("SQLite", token, errorNodes(error.message)))
        )
    }
}

sqliteInsert: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    rejected: Local Response? := rejectGetStateChange(request, session, token)
    if rejected != null {
        return rejected
    }
    path: Local String? := request.form("db")
    table: Local String? := request.form("table")
    if path == null or table == null {
        return sessions.commit(
            session
            HTTP.html(
                layout("SQLite", token, errorNodes("db and table are required"))
            )
        )
    }
    rotateCsrf(session)
    attempt {
        db: Local Database? := openAllowedSqlite(path)
        if db == null {
            return sessions.commit(
                session
                HTTP.html(
                    layout(
                        "SQLite"
                        token
                        errorNodes(
                            "sqlite path is not in the allowed project set"
                        )
                    )
                )
            )
        }
        attempt {
            if not (table in sqliteTableNames(db)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("SQLite", token, errorNodes("unknown table"))
                    )
                )
            }
            columns: Local List<Pair<String, String>> := sqliteColumns(
                db
                table
            )
            colNames: Local List<String> := []
            values: Local List<SQLiteValue> := []
            for column in columns {
                name: Local String := column["name"]
                raw: Local String? := request.form("col_" + name)
                if raw == null {
                    continue
                }
                colNames.add(quoteSqlite(name))
                if raw == "" and column["nullable"] == "YES" {
                    values.add(SQLite.nullValue())
                }
                else {
                    values.add(SQLite.fromString(raw))
                }
            }
            if len(colNames) == 0 {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("SQLite", token, errorNodes("no insert columns"))
                    )
                )
            }
            sql: Local String := "INSERT INTO " + quoteSqlite(
                table
            ) + " (" + colNames[0]
            index: Local Int := 1
            while index < len(colNames) {
                sql = sql + ", " + colNames[index]
                index++
            }
            sql = sql + ") VALUES (?"
            index = 1
            while index < len(colNames) {
                sql = sql + ", ?"
                index++
            }
            sql = sql + ")"
            db.execute(sql, values)
            return sessions.commit(
                session
                HTTP.redirect(sqliteBrowseURL(path, table))
            )
        }
        except SQLiteError as error {
            return sessions.commit(
                session
                HTTP.html(layout("SQLite", token, errorNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except SQLiteError as error {
        return sessions.commit(
            session
            HTTP.html(layout("SQLite", token, errorNodes(error.message)))
        )
    }
}

sqliteDelete: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    rejected: Local Response? := rejectGetStateChange(request, session, token)
    if rejected != null {
        return rejected
    }
    path: Local String? := request.form("db")
    table: Local String? := request.form("table")
    if path == null or table == null {
        return sessions.commit(
            session
            HTTP.html(
                layout("SQLite", token, errorNodes("db and table are required"))
            )
        )
    }
    rotateCsrf(session)
    attempt {
        db: Local Database? := openAllowedSqlite(path)
        if db == null {
            return sessions.commit(
                session
                HTTP.html(
                    layout(
                        "SQLite"
                        token
                        errorNodes(
                            "sqlite path is not in the allowed project set"
                        )
                    )
                )
            )
        }
        attempt {
            if not (table in sqliteTableNames(db)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("SQLite", token, errorNodes("unknown table"))
                    )
                )
            }
            columns: Local List<Pair<String, String>> := sqliteColumns(
                db
                table
            )
            pkCols: Local List<String> := mysqlPrimaryColumns(columns)
            if len(pkCols) == 0 {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout(
                            "SQLite"
                            token
                            errorNodes("delete requires a primary key")
                        )
                    )
                )
            }
            sql: Local String := "DELETE FROM " + quoteSqlite(table) + " WHERE "
            values: Local List<SQLiteValue> := []
            index: Local Int := 0
            while index < len(pkCols) {
                name: Local String := pkCols[index]
                raw: Local String? := request.form("pk_" + name)
                if raw == null {
                    return sessions.commit(
                        session
                        HTTP.html(
                            layout(
                                "SQLite"
                                token
                                errorNodes("missing primary key value")
                            )
                        )
                    )
                }
                if index > 0 {
                    sql = sql + " AND "
                }
                sql = sql + quoteSqlite(name) + " = ?"
                values.add(SQLite.fromString(raw))
                index++
            }
            db.execute(sql, values)
            return sessions.commit(
                session
                HTTP.redirect(sqliteBrowseURL(path, table))
            )
        }
        except SQLiteError as error {
            return sessions.commit(
                session
                HTTP.html(layout("SQLite", token, errorNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except SQLiteError as error {
        return sessions.commit(
            session
            HTTP.html(layout("SQLite", token, errorNodes(error.message)))
        )
    }
}

sqliteUpdate: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    rejected: Local Response? := rejectGetStateChange(request, session, token)
    if rejected != null {
        return rejected
    }
    path: Local String? := request.form("db")
    table: Local String? := request.form("table")
    if path == null or table == null {
        return sessions.commit(
            session
            HTTP.html(
                layout("SQLite", token, errorNodes("db and table are required"))
            )
        )
    }
    rotateCsrf(session)
    attempt {
        db: Local Database? := openAllowedSqlite(path)
        if db == null {
            return sessions.commit(
                session
                HTTP.html(
                    layout(
                        "SQLite"
                        token
                        errorNodes(
                            "sqlite path is not in the allowed project set"
                        )
                    )
                )
            )
        }
        attempt {
            if not (table in sqliteTableNames(db)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("SQLite", token, errorNodes("unknown table"))
                    )
                )
            }
            columns: Local List<Pair<String, String>> := sqliteColumns(
                db
                table
            )
            columnNames: Local List<String> := sqliteBrowseColumns(columns)
            pkCols: Local List<String> := mysqlPrimaryColumns(columns)
            if len(pkCols) == 0 {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout(
                            "SQLite"
                            token
                            errorNodes("update requires a primary key")
                        )
                    )
                )
            }
            setParts: Local List<String> := []
            values: Local List<SQLiteValue> := []
            for name in columnNames {
                if name in pkCols {
                    continue
                }
                raw: Local String? := request.form("col_" + name)
                if raw == null {
                    continue
                }
                setParts.add(quoteSqlite(name) + " = ?")
                values.add(SQLite.fromString(raw))
            }
            if len(setParts) == 0 {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("SQLite", token, errorNodes("no update columns"))
                    )
                )
            }
            sql: Local String := "UPDATE " + quoteSqlite(
                table
            ) + " SET " + setParts[0]
            index: Local Int := 1
            while index < len(setParts) {
                sql = sql + ", " + setParts[index]
                index++
            }
            sql = sql + " WHERE "
            index = 0
            while index < len(pkCols) {
                name: Local String := pkCols[index]
                raw: Local String? := request.form("pk_" + name)
                if raw == null {
                    return sessions.commit(
                        session
                        HTTP.html(
                            layout(
                                "SQLite"
                                token
                                errorNodes("missing primary key value")
                            )
                        )
                    )
                }
                if index > 0 {
                    sql = sql + " AND "
                }
                sql = sql + quoteSqlite(name) + " = ?"
                values.add(SQLite.fromString(raw))
                index++
            }
            db.execute(sql, values)
            return sessions.commit(
                session
                HTTP.redirect(sqliteBrowseURL(path, table))
            )
        }
        except SQLiteError as error {
            return sessions.commit(
                session
                HTTP.html(layout("SQLite", token, errorNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except SQLiteError as error {
        return sessions.commit(
            session
            HTTP.html(layout("SQLite", token, errorNodes(error.message)))
        )
    }
}

sqliteConfirmPage: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    path: Local String? := request.query("db")
    table: Local String? := request.query("table")
    action: Local String? := request.query("action")
    if path == null or table == null or action == null {
        return sessions.commit(
            session
            HTTP.html(
                layout(
                    "Confirm"
                    token
                    errorNodes("db, table, and action are required")
                )
            )
        )
    }
    if action != "drop" {
        return sessions.commit(
            session
            HTTP.html(layout("Confirm", token, errorNodes("unknown action")))
        )
    }
    body: Local List<HTMLNode> := [
        HTML.element(
            "h1"
            {"class": "h4 mb-3"}
            [HTML.text("Confirm destructive action")]
        )
        HTML.element(
            "div"
            {"class": "studio-danger"}
            [
                HTML.element(
                    "div"
                    {"class": "small text-uppercase fw-bold text-danger mb-2"}
                    [HTML.text("Danger zone")]
                )
                HTML.element(
                    "h2"
                    {"class": "h6"}
                    [HTML.text("DROP " + table)]
                )
                HTML.element(
                    "p"
                    {"class": "small text-muted studio-mono"}
                    [HTML.text(Path.base(path))]
                )
                HTML.element(
                    "p"
                    {"class": "text-muted small"}
                    [
                        HTML.text(
                            "AhdDataStudio will drop this SQLite table only after this confirmation POST."
                        )
                    ]
                )
                HTML.element(
                    "form"
                    {"method": "post", "action": "/AhdDataStudio/sqlite/drop"}
                    [
                        csrfField(token)
                        hiddenField("db", path)
                        hiddenField("table", table)
                        HTML.element(
                            "a"
                            {
                                "href": sqliteBrowseURL(path, table)
                                "class": "btn btn-sm btn-light border me-2"
                            }
                            [HTML.text("Cancel")]
                        )
                        HTML.element(
                            "button"
                            {"type": "submit", "class": "btn btn-sm btn-danger"}
                            [HTML.text("Confirm DROP TABLE")]
                        )
                    ]
                )
            ]
        )
    ]
    return sessions.commit(session, HTTP.html(layout("Confirm", token, body)))
}

sqliteDrop: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    rejected: Local Response? := rejectGetStateChange(request, session, token)
    if rejected != null {
        return rejected
    }
    path: Local String? := request.form("db")
    table: Local String? := request.form("table")
    if path == null or table == null {
        return sessions.commit(
            session
            HTTP.html(
                layout("SQLite", token, errorNodes("db and table are required"))
            )
        )
    }
    rotateCsrf(session)
    attempt {
        db: Local Database? := openAllowedSqlite(path)
        if db == null {
            return sessions.commit(
                session
                HTTP.html(
                    layout(
                        "SQLite"
                        token
                        errorNodes(
                            "sqlite path is not in the allowed project set"
                        )
                    )
                )
            )
        }
        attempt {
            if not (table in sqliteTableNames(db)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("SQLite", token, errorNodes("unknown table"))
                    )
                )
            }
            db.execute("DROP TABLE " + quoteSqlite(table))
            return sessions.commit(
                session
                HTTP.redirect("/AhdDataStudio/sqlite")
            )
        }
        except SQLiteError as error {
            return sessions.commit(
                session
                HTTP.html(layout("SQLite", token, errorNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except SQLiteError as error {
        return sessions.commit(
            session
            HTTP.html(layout("SQLite", token, errorNodes(error.message)))
        )
    }
}

startStudio: Function := () -> Nothing {
    loadEnvFile()
    app: Local Server := HTTP.server("127.0.0.1", 8081)
    app.get("/AhdDataStudio", home)
    app.get("/AhdDataStudio/assets/bootstrap.min.css", serveBootstrap)
    app.get("/AhdDataStudio/assets/ahdcode-logo.png", serveLogo)
    app.get("/AhdDataStudio/mysql", mysqlHome)
    app.get("/AhdDataStudio/mysql/database", mysqlDatabasePage)
    app.get("/AhdDataStudio/mysql/table", mysqlStructurePage)
    app.get("/AhdDataStudio/mysql/indexes", mysqlIndexesPage)
    app.get("/AhdDataStudio/mysql/browse", mysqlBrowsePage)
    app.get("/AhdDataStudio/mysql/sql", mysqlSqlPage)
    app.post("/AhdDataStudio/mysql/sql", mysqlSqlRun)
    app.post("/AhdDataStudio/mysql/insert", mysqlInsert)
    app.post("/AhdDataStudio/mysql/update", mysqlUpdate)
    app.post("/AhdDataStudio/mysql/delete", mysqlDelete)
    app.get("/AhdDataStudio/mysql/confirm", mysqlConfirmPage)
    app.post("/AhdDataStudio/mysql/drop", mysqlDrop)
    app.post("/AhdDataStudio/mysql/truncate", mysqlTruncate)
    app.get("/AhdDataStudio/sqlite", sqliteHome)
    app.get("/AhdDataStudio/sqlite/database", sqliteOpenPage)
    app.get("/AhdDataStudio/sqlite/table", sqliteStructurePage)
    app.get("/AhdDataStudio/sqlite/indexes", sqliteIndexesPage)
    app.get("/AhdDataStudio/sqlite/browse", sqliteBrowsePage)
    app.get("/AhdDataStudio/sqlite/sql", sqliteSqlPage)
    app.post("/AhdDataStudio/sqlite/sql", sqliteSqlRun)
    app.post("/AhdDataStudio/sqlite/insert", sqliteInsert)
    app.post("/AhdDataStudio/sqlite/update", sqliteUpdate)
    app.post("/AhdDataStudio/sqlite/delete", sqliteDelete)
    app.get("/AhdDataStudio/sqlite/confirm", sqliteConfirmPage)
    app.post("/AhdDataStudio/sqlite/drop", sqliteDrop)
    write("AhdDataStudio listening on http://127.0.0.1:8081/AhdDataStudio")
    app.start()
}

attempt {
    startStudio()
}
except HTTPError as error {
    write("HTTP error: " + redact(error.message))
}
except EnvError as error {
    write("Env error: " + redact(error.message))
}
except HTMLError as error {
    write("HTML error: " + redact(error.message))
}
except SecurityError as error {
    write("Security error: " + redact(error.message))
}
