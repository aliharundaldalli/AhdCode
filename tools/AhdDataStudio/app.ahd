}

mysqlSqlRun: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    if request.method() != "POST" {
        return sessions.commit(
            session
            HTTP.html(
                layout("SQL", token, errorNodes("SQL console requires POST"))
                405
            )
        )
    }
    if not csrfOK(request, session) {
        return sessions.commit(
            session
            HTTP.html(
                layout(
                    "SQL"
                    token
                    errorNodes("rejected: CSRF token missing or invalid")
                )
                403
            )
        )
    }
    sqlText: Local String? := request.form("sql")
    schemaForm: Local String? := request.form("database")
    schema: Local String := ""
    if schemaForm != null {
        schema = schemaForm
    }
    if sqlText == null {
        return sessions.commit(
            session
            HTTP.html(layout("SQL", token, errorNodes("sql is required")))
        )
    }
    rotateCsrf(session)
    token = csrfToken(session)
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            if schema != "" {
                if not (schema in mysqlDatabases(db)) {
                    return sessions.commit(
                        session
                        HTTP.html(
                            layout("SQL", token, errorNodes("unknown database"))
                        )
                    )
                }
                db.execute("USE " + quoteMysql(schema))
            }
            body: Local List<HTMLNode> := [
                HTML.element(
                    "h1"
                    {"class": "h4"}
                    [HTML.text("MySQL SQL console")]
                )
                HTML.element(
                    "div"
                    {"class": "alert alert-warning"}
                    [HTML.text("This console ran your SQL exactly as entered.")]
                )
            ]
            if looksLikeQuery(sqlText) {
                data: Local List<Pair<String, MySQLValue>> := db.query(sqlText)
                headers: Local List<String> := []
                rows: Local List<List<String>> := []
                if len(data) > 0 {
                    for key in data[0] {
                        headers.add(key)
                    }
                    for dataRow in data {
                        cells: Local List<String> := []
                        for header in headers {
                            cells.add(formatMysqlValue(dataRow[header]))
                        }
                        rows.add(cells)
                    }
                }
                body.add(
                    HTML.element(
                        "p"
                        {}
                        [HTML.text(str(len(data)) + " row(s)")]
                    )
                )
                if len(headers) > 0 {
                    body.add(htmlTable(headers, rows))
                }
            }
            else {
                result: Local MySQLResult := db.execute(sqlText)
                body.add(
                    HTML.element(
                        "p"
                        {}
                        [
                            HTML.text(
                                "affected rows: " + str(result.affectedRows())
                            )
                        ]
                    )
                )
            }
            body.add(
                HTML.element(
                    "form"
                    {"method": "post", "action": "/AhdDataStudio/mysql/sql"}
                    [
                        csrfField(token)
                        hiddenField("database", schema)
                        HTML.element(
                            "textarea"
                            {"name": "sql", "class": "form-control mb-2"}
                            [HTML.text(sqlText)]
                        )
                        HTML.element(
                            "button"
                            {"type": "submit", "class": "btn btn-primary"}
                            [HTML.text("Run")]
                        )
                    ]
                )
            )
            return sessions.commit(
                session
                HTTP.html(layout("SQL", token, body))
            )
        }
        except MySQLError as error {
            return sessions.commit(
                session
                HTTP.html(layout("SQL", token, errorNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return sessions.commit(
            session
            HTTP.html(layout("SQL", token, errorNodes(error.message)))
        )
    }
}

rejectGetStateChange: Function := (
    request: Request
    session: Session
    token: String
) -> Response? {
    sessions: Global SessionStore
    if request.method() != "POST" {
        return sessions.commit(
            session
            HTTP.html(
                layout(
                    "Rejected"
                    token
                    errorNodes("this action requires POST")
                )
                405
            )
        )
    }
    if not csrfOK(request, session) {
        return sessions.commit(
            session
            HTTP.html(
                layout(
                    "Rejected"
                    token
                    errorNodes("rejected: CSRF token missing or invalid")
                )
                403
            )
        )
    }
    return null
}

mysqlInsert: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    rejected: Local Response? := rejectGetStateChange(request, session, token)
    if rejected != null {
        return rejected
    }
    schema: Local String? := request.form("database")
    table: Local String? := request.form("table")
    if schema == null or table == null {
        return sessions.commit(
            session
            HTTP.html(
                layout(
                    "MySQL"
                    token
                    errorNodes("database and table are required")
                )
            )
        )
    }
    rotateCsrf(session)
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            if not (schema in mysqlDatabases(db)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("MySQL", token, errorNodes("unknown database"))
                    )
                )
            }
            if not (table in mysqlTableNames(db, schema)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("MySQL", token, errorNodes("unknown table"))
                    )
                )
            }
            columns: Local List<Pair<String, String>> := mysqlColumns(
                db
                schema
                table
            )
            colNames: Local List<String> := []
            values: Local List<MySQLValue> := []
            for column in columns {
                extra: Local String := column["extra"].lower()
                if extra.contains("auto_increment") {
                    continue
                }
                name: Local String := column["name"]
                raw: Local String? := request.form("col_" + name)
                if raw == null {
                    continue
                }
                colNames.add(quoteMysql(name))
                if raw == "" and column["nullable"] == "YES" {
                    values.add(MySQL.nullValue())
                }
                else {
                    values.add(MySQL.fromString(raw))
                }
            }
            if len(colNames) == 0 {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("MySQL", token, errorNodes("no insert columns"))
                    )
                )
            }
            placeholders: Local List<String> := []
            for name in colNames {
                placeholders.add("?")
            }
            sql: Local String := "INSERT INTO " + quoteMysql(
                schema
            ) + "." + quoteMysql(table) + " (" + colNames[0]
            index: Local Int := 1
            while index < len(colNames) {
                sql = sql + ", " + colNames[index]
                index++
            }
            sql = sql + ") VALUES (?"
            index = 1
            while index < len(placeholders) {
                sql = sql + ", ?"
                index++
            }
            sql = sql + ")"
            db.execute(sql, values)
            return sessions.commit(
                session
                HTTP.redirect(mysqlBrowseURL(schema, table))
            )
        }
        except MySQLError as error {
            return sessions.commit(
                session
                HTTP.html(layout("MySQL", token, errorNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return sessions.commit(
            session
            HTTP.html(layout("MySQL", token, errorNodes(error.message)))
        )
    }
}

mysqlDelete: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    rejected: Local Response? := rejectGetStateChange(request, session, token)
    if rejected != null {
        return rejected
    }
    schema: Local String? := request.form("database")
    table: Local String? := request.form("table")
    if schema == null or table == null {
        return sessions.commit(
            session
            HTTP.html(
                layout(
                    "MySQL"
                    token
                    errorNodes("database and table are required")
                )
            )
        )
    }
    rotateCsrf(session)
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            if not (schema in mysqlDatabases(db)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("MySQL", token, errorNodes("unknown database"))
                    )
                )
            }
            if not (table in mysqlTableNames(db, schema)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("MySQL", token, errorNodes("unknown table"))
                    )
                )
            }
            columns: Local List<Pair<String, String>> := mysqlColumns(
                db
                schema
                table
            )
            pkCols: Local List<String> := mysqlPrimaryColumns(columns)
            if len(pkCols) == 0 {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout(
                            "MySQL"
                            token
                            errorNodes("delete requires a primary key")
                        )
                    )
                )
            }
            sql: Local String := "DELETE FROM " + quoteMysql(
                schema
            ) + "." + quoteMysql(table) + " WHERE "
            values: Local List<MySQLValue> := []
            index: Local Int := 0
            while index < len(pkCols) {
                name: Local String := pkCols[index]
                raw: Local String? := request.form("pk_" + name)
                if raw == null {
                    return sessions.commit(
                        session
                        HTTP.html(
                            layout(
                                "MySQL"
                                token
                                errorNodes("missing primary key value")
                            )
                        )
                    )
                }
                if index > 0 {
                    sql = sql + " AND "
                }
                sql = sql + quoteMysql(name) + " = ?"
                values.add(MySQL.fromString(raw))
                index++
            }
            db.execute(sql, values)
            return sessions.commit(
                session
                HTTP.redirect(mysqlBrowseURL(schema, table))
            )
        }
        except MySQLError as error {
            return sessions.commit(
                session
                HTTP.html(layout("MySQL", token, errorNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return sessions.commit(
            session
            HTTP.html(layout("MySQL", token, errorNodes(error.message)))
        )
    }
}

mysqlUpdate: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    rejected: Local Response? := rejectGetStateChange(request, session, token)
    if rejected != null {
        return rejected
    }
    schema: Local String? := request.form("database")
    table: Local String? := request.form("table")
    if schema == null or table == null {
        return sessions.commit(
            session
            HTTP.html(
                layout(
                    "MySQL"
                    token
                    errorNodes("database and table are required")
                )
            )
        )
    }
    rotateCsrf(session)
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            if not (schema in mysqlDatabases(db)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("MySQL", token, errorNodes("unknown database"))
                    )
                )
            }
            if not (table in mysqlTableNames(db, schema)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("MySQL", token, errorNodes("unknown table"))
                    )
                )
            }
            columns: Local List<Pair<String, String>> := mysqlColumns(
                db
                schema
                table
            )
            columnNames: Local List<String> := mysqlColumnNames(
                db
                schema
                table
            )
            pkCols: Local List<String> := mysqlPrimaryColumns(columns)
            if len(pkCols) == 0 {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout(
                            "MySQL"
                            token
                            errorNodes("update requires a primary key")
                        )
                    )
                )
            }
            setParts: Local List<String> := []
            values: Local List<MySQLValue> := []
            for name in columnNames {
                if name in pkCols {
                    continue
                }
                raw: Local String? := request.form("col_" + name)
                if raw == null {
                    continue
                }
                setParts.add(quoteMysql(name) + " = ?")
                values.add(MySQL.fromString(raw))
            }
            if len(setParts) == 0 {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("MySQL", token, errorNodes("no update columns"))
                    )
                )
            }
            sql: Local String := "UPDATE " + quoteMysql(
                schema
            ) + "." + quoteMysql(table) + " SET " + setParts[0]
            index: Local Int := 1
            while index < len(setParts) {
                sql = sql + ", " + setParts[index]
                index++
            }
            sql = sql + " WHERE "
            index = 0
            while index < len(pkCols) {
                name: Local String := pkCols[index]
                raw: Local String? := request.form("pk_" + name)
                if raw == null {
                    return sessions.commit(
                        session
                        HTTP.html(
                            layout(
                                "MySQL"
                                token
                                errorNodes("missing primary key value")
                            )
                        )
                    )
                }
                if index > 0 {
                    sql = sql + " AND "
                }
                sql = sql + quoteMysql(name) + " = ?"
                values.add(MySQL.fromString(raw))
                index++
            }
            db.execute(sql, values)
            return sessions.commit(
                session
                HTTP.redirect(mysqlBrowseURL(schema, table))
            )
        }
        except MySQLError as error {
            return sessions.commit(
                session
                HTTP.html(layout("MySQL", token, errorNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return sessions.commit(
            session
            HTTP.html(layout("MySQL", token, errorNodes(error.message)))
        )
    }
}

mysqlConfirmPage: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    schema: Local String? := request.query("database")
    table: Local String? := request.query("table")
    action: Local String? := request.query("action")
    if schema == null or table == null or action == null {
        return sessions.commit(
            session
            HTTP.html(
                layout(
                    "Confirm"
                    token
                    errorNodes("database, table, and action are required")
                )
            )
        )
    }
    if action != "drop" and action != "truncate" {
        return sessions.commit(
            session
            HTTP.html(layout("Confirm", token, errorNodes("unknown action")))
        )
    }
    target: Local String := "/AhdDataStudio/mysql/drop"
    label: Local String := "Confirm DROP TABLE"
    if action == "truncate" {
        target = "/AhdDataStudio/mysql/truncate"
        label = "Confirm TRUNCATE TABLE"
    }
    body: Local List<HTMLNode> := [
        HTML.element(
            "h1"
            {"class": "h4 mb-3"}
            [HTML.text("Confirm destructive action")]
        )
        HTML.element(
            "div"
            {"class": "studio-danger"}
            [
                HTML.element(
                    "div"
                    {"class": "small text-uppercase fw-bold text-danger mb-2"}
                    [HTML.text("Danger zone")]
                )
                HTML.element(
                    "h2"
                    {"class": "h6"}
                    [HTML.text(action.upper() + " " + schema + "." + table)]
                )
                HTML.element(
                    "p"
                    {"class": "text-muted small"}
                    [
                        HTML.text(
                            "AhdDataStudio will execute this action only after this confirmation POST. Review the target before continuing."
                        )
                    ]
                )
                HTML.element(
                    "form"
                    {"method": "post", "action": target}
                    [
                        csrfField(token)
                        hiddenField("database", schema)
                        hiddenField("table", table)
                        HTML.element(
                            "a"
                            {
                                "href": mysqlBrowseURL(schema, table)
                                "class": "btn btn-sm btn-light border me-2"
                            }
                            [HTML.text("Cancel")]
                        )
                        HTML.element(
                            "button"
                            {"type": "submit", "class": "btn btn-sm btn-danger"}
                            [HTML.text(label)]
                        )
                    ]
                )
            ]
        )
    ]
    return sessions.commit(session, HTTP.html(layout("Confirm", token, body)))
}

mysqlDrop: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    rejected: Local Response? := rejectGetStateChange(request, session, token)
    if rejected != null {
        return rejected
    }
    schema: Local String? := request.form("database")
    table: Local String? := request.form("table")
    if schema == null or table == null {
        return sessions.commit(
            session
            HTTP.html(
                layout(
                    "MySQL"
                    token
                    errorNodes("database and table are required")
                )
            )
        )
    }
    rotateCsrf(session)
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            if not (schema in mysqlDatabases(db)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("MySQL", token, errorNodes("unknown database"))
                    )
                )
            }
            if not (table in mysqlTableNames(db, schema)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("MySQL", token, errorNodes("unknown table"))
                    )
                )
            }
            db.execute(
                "DROP TABLE " + quoteMysql(schema) + "." + quoteMysql(table)
            )
            return sessions.commit(
                session
                HTTP.redirect(mysqlDatabaseURL(schema))
            )
        }
        except MySQLError as error {
            return sessions.commit(
                session
                HTTP.html(layout("MySQL", token, errorNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return sessions.commit(
            session
            HTTP.html(layout("MySQL", token, errorNodes(error.message)))
        )
    }
}

