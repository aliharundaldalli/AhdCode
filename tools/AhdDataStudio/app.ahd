// AhdDataStudio — local database development UI.
//
// Written in AhdCode against the released HTTP, HTML, MySQL, SQLite, Env,
// File, Path, and Security modules. There is no local source `require`, so
// this first version lives in one file on purpose.
//
//   cd tools/AhdDataStudio
//   ahdcode run app.ahd
//   open http://127.0.0.1:8081/AhdDataStudio
//   ahdcode kill app.run
//
// Binds 127.0.0.1 only. Do not change the host to 0.0.0.0.
bring Env
bring File
bring HTML
bring HTTP
bring MySQL
bring Path
bring SQLite
bring Security
from Env bring EnvError
from File bring FileError
from HTML bring HTMLNode
from HTML bring HTMLError
from HTTP bring Server
from HTTP bring Request
from HTTP bring Response
from HTTP bring SessionStore
from HTTP bring Session
from HTTP bring HTTPError
from MySQL bring MySQLDatabase
from MySQL bring MySQLResult
from MySQL bring MySQLValue
from MySQL bring MySQLError
from SQLite bring Database
from SQLite bring SQLiteValue
from SQLite bring SQLiteError
from Security bring SecurityError

sessions: SessionStore := HTTP.sessions("ahd_datastudio", 3600, false, "Lax")

pageSize: Int := 50
mysqlSchemaCache: List<String> := []
mysqlActiveSchema: String := ""

loadEnvFile: Function := () -> Nothing {
    if File.exists(".env") {
        Env.load(".env")
    }
}

redact: Function := (message: String) -> String {
    password: Local String := Env.getOr("AHD_DATA_MYSQL_PASSWORD", "")
    if password != "" {
        return message.replace(password, "[redacted]")
    }
    return message
}

quoteMysql: Function := (name: String) -> String {
    return "`" + name.replace("`", "``") + "`"
}

quoteSqlite: Function := (name: String) -> String {
    return "\"" + name.replace("\"", "\"\"") + "\""
}

mysqlBrowseURL: Function := (schema: String, table: String) -> String {
    return "/AhdDataStudio/mysql/browse?database=" + schema + "&table=" + table
}

mysqlDatabaseURL: Function := (schema: String) -> String {
    return "/AhdDataStudio/mysql/database?database=" + schema
}

sqliteBrowseURL: Function := (path: String, table: String) -> String {
    return "/AhdDataStudio/sqlite/browse?db=" + path + "&table=" + table
}

sqliteDatabaseURL: Function := (path: String) -> String {
    return "/AhdDataStudio/sqlite/database?db=" + path
}

isSafeComponent: Function := (name: String) -> Bool {
    if name == "" or name == "." or name == ".." {
        return false
    }
    if name.contains("/") or name.contains("\\") {
        return false
    }
    return true
}

isSqliteExt: Function := (path: String) -> Bool {
    ext: Local String := Path.ext(path).lower()
    return ext == ".db" or ext == ".sqlite" or ext == ".sqlite3"
}

isDirectoryPath: Function := (path: String) -> Bool {
    attempt {
        File.list(path)
        return true
    }
    except FileError {
        return false
    }
}

allowedSqlitePaths: Function := () -> List<String> {
    found: Local List<String> := []
    explicit: Local String := Env.getOr("AHD_DATA_SQLITE_PATHS", "")
    parts: Local List<String> := explicit.split(",")
    for part in parts {
        trimmed: Local String := part.trim()
        if trimmed != "" {
            if not (trimmed in found) {
                found.add(trimmed)
            }
        }
    }
    root: Local String := Env.getOr("AHD_DATA_PROJECT_ROOT", "")
    if root != "" {
        attempt {
            names: Local List<String> := File.list(root)
            for name in names {
                if isSafeComponent(name) {
                    candidate: Local String := Path.join([root, name])
                    if isSqliteExt(candidate) {
                        if not isDirectoryPath(candidate) {
                            if not (candidate in found) {
                                found.add(candidate)
                            }
                        }
                    }
                }
            }
        }
        except FileError {}
    }
    return found
}

sqlitePathAllowed: Function := (path: String) -> Bool {
    allowed: Local List<String> := allowedSqlitePaths()
    return path in allowed
}

connectMysql: Function := () -> MySQLDatabase {
    host: Local String := Env.getOr("AHD_DATA_MYSQL_HOST", "127.0.0.1")
    username: Local String := Env.getOr("AHD_DATA_MYSQL_USER", "root")
    password: Local String := Env.getOr("AHD_DATA_MYSQL_PASSWORD", "")
    portText: Local String := Env.getOr("AHD_DATA_MYSQL_PORT", "3306")
    security: Local String := Env.getOr("AHD_DATA_MYSQL_SECURITY", "none")
    port: Local Int := int(portText)
    return MySQL.connect(host, username, password, port, null, security)
}

mysqlDatabases: Function := (db: MySQLDatabase) -> List<String> {
    names: Local List<String> := []
    rows: Local List<Pair<String, MySQLValue>> := db.query("SHOW DATABASES")
    for row in rows {
        if "Database" in row {
            value: Local MySQLValue := row["Database"]
            if not value.isNull() {
                if value.kind() == "String" {
                    names.add(value.string())
                }
            }
        }
    }
    mysqlSchemaCache: Global List<String>
    mysqlSchemaCache = names
    return names
}

mysqlTables: Function := (
    db: MySQLDatabase
    schema: String
) -> List<Pair<String, String>> {
    rows: Local List<Pair<String, MySQLValue>> := db.query(
        "SELECT TABLE_NAME, TABLE_TYPE, ENGINE, TABLE_ROWS FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = ? ORDER BY TABLE_NAME"
        [MySQL.fromString(schema)]
    )
    tables: Local List<Pair<String, String>> := []
    for row in rows {
        name: Local String := ""
        kind: Local String := ""
        engine: Local String := ""
        approx: Local String := ""
        if "TABLE_NAME" in row {
            if row["TABLE_NAME"].kind() == "String" {
                name = row["TABLE_NAME"].string()
            }
        }
        if "TABLE_TYPE" in row {
            if row["TABLE_TYPE"].kind() == "String" {
                kind = row["TABLE_TYPE"].string()
            }
        }
        if "ENGINE" in row {
            if not row["ENGINE"].isNull() {
                if row["ENGINE"].kind() == "String" {
                    engine = row["ENGINE"].string()
                }
            }
        }
        if "TABLE_ROWS" in row {
            if not row["TABLE_ROWS"].isNull() {
                if row["TABLE_ROWS"].kind() == "Int" {
                    approx = str(row["TABLE_ROWS"].int())
                }
                else if row["TABLE_ROWS"].kind() == "String" {
                    approx = row["TABLE_ROWS"].string()
                }
            }
        }
        tables.add(
            {"name": name, "type": kind, "engine": engine, "rows": approx}
        )
    }
    return tables
}

mysqlTableNames: Function := (
    db: MySQLDatabase
    schema: String
) -> List<String> {
    names: Local List<String> := []
    tables: Local List<Pair<String, String>> := mysqlTables(db, schema)
    for table in tables {
        names.add(table["name"])
    }
    return names
}

mysqlColumns: Function := (
    db: MySQLDatabase
    schema: String
    table: String
) -> List<Pair<String, String>> {
    rows: Local List<Pair<String, MySQLValue>> := db.query(
        "SELECT COLUMN_NAME, COLUMN_TYPE, IS_NULLABLE, COLUMN_DEFAULT, COLUMN_KEY, EXTRA FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA = ? AND TABLE_NAME = ? ORDER BY ORDINAL_POSITION"
        [MySQL.fromString(schema), MySQL.fromString(table)]
    )
    columns: Local List<Pair<String, String>> := []
    for row in rows {
        name: Local String := ""
        sqlType: Local String := ""
        nullable: Local String := ""
        defaultValue: Local String := ""
        key: Local String := ""
        extra: Local String := ""
        if "COLUMN_NAME" in row {
            if row["COLUMN_NAME"].kind() == "String" {
                name = row["COLUMN_NAME"].string()
            }
        }
        if "COLUMN_TYPE" in row {
            if row["COLUMN_TYPE"].kind() == "String" {
                sqlType = row["COLUMN_TYPE"].string()
            }
        }
        if "IS_NULLABLE" in row {
            if row["IS_NULLABLE"].kind() == "String" {
                nullable = row["IS_NULLABLE"].string()
            }
        }
        if "COLUMN_DEFAULT" in row {
            if row["COLUMN_DEFAULT"].isNull() {
                defaultValue = ""
            }
            else if row["COLUMN_DEFAULT"].kind() == "String" {
                defaultValue = row["COLUMN_DEFAULT"].string()
            }
        }
        if "COLUMN_KEY" in row {
            if row["COLUMN_KEY"].kind() == "String" {
                key = row["COLUMN_KEY"].string()
            }
        }
        if "EXTRA" in row {
            if row["EXTRA"].kind() == "String" {
                extra = row["EXTRA"].string()
            }
        }
        columns.add(
            {
                "name": name
                "type": sqlType
                "nullable": nullable
                "default": defaultValue
                "key": key
                "extra": extra
            }
        )
    }
    return columns
}

mysqlColumnNames: Function := (
    db: MySQLDatabase
    schema: String
    table: String
) -> List<String> {
    names: Local List<String> := []
    columns: Local List<Pair<String, String>> := mysqlColumns(db, schema, table)
    for column in columns {
        names.add(column["name"])
    }
    return names
}

mysqlPrimaryColumns: Function := (
    columns: List<Pair<String, String>>
) -> List<String> {
    names: Local List<String> := []
    for column in columns {
        if column["key"] == "PRI" {
            names.add(column["name"])
        }
    }
    return names
}

formatMysqlValue: Function := (value: MySQLValue) -> String {
    if value.isNull() {
        return "NULL"
    }
    if value.isBinary() {
        return "[Binary · " + str(value.binarySize()) + " bytes]"
    }
    kind: Local String := value.kind()
    if kind == "Int" {
        return str(value.int())
    }
    if kind == "Real" {
        return str(value.real())
    }
    if kind == "String" {
        return value.string()
    }
    return "[" + kind + "]"
}

formatSqliteValue: Function := (value: SQLiteValue) -> String {
    if value.isNull() {
        return "NULL"
    }
    kind: Local String := value.kind()
    if kind == "Int" {
        return str(value.int())
    }
    if kind == "Real" {
        return str(value.real())
    }
    if kind == "String" {
        return value.string()
    }
    return "[" + kind + "]"
}

looksLikeQuery: Function := (sql: String) -> Bool {
    trimmed: Local String := sql.trim().lower()
    if trimmed.startsWith("select") {
        return true
    }
    if trimmed.startsWith("show") {
        return true
    }
    if trimmed.startsWith(
        "describe"
    ) or trimmed.startsWith("desc ") or trimmed == "desc" {
        return true
    }
    if trimmed.startsWith("explain") {
        return true
    }
    if trimmed.startsWith("with") {
        return true
    }
    if trimmed.startsWith("pragma") {
        return true
    }
    return false
}

csrfToken: Function := (session: Session) -> String {
    token: Local String? := session.get("csrf")
    if token == null {
        token = Security.token()
        session.set("csrf", token)
    }
    return token
}

csrfOK: Function := (request: Request, session: Session) -> Bool {
    stored: Local String? := session.get("csrf")
    submitted: Local String? := request.form("csrf")
    if stored == null {
        return false
    }
    if submitted == null {
        return false
    }
    return Security.secureEqual(stored, submitted)
}

rotateCsrf: Function := (session: Session) -> Nothing {
    session.set("csrf", Security.token())
}

hiddenField: Function := (name: String, value: String) -> HTMLNode {
    return HTML.element(
        "input"
        {"type": "hidden", "name": name, "value": value}
        []
    )
}

csrfField: Function := (token: String) -> HTMLNode {
    return hiddenField("csrf", token)
}

navLink: Function := (href: String, label: String) -> HTMLNode {
    return HTML.element(
        "a"
        {"href": href, "class": "nav-link"}
        [HTML.text(label)]
    )
}

queryFormClass: Function := (
    action: String
    fields: Pair<String, String>
    label: String
    buttonClass: String
) -> HTMLNode {
    children: Local List<HTMLNode> := []
    for name in fields {
        children.add(hiddenField(name, fields[name]))
    }
    children.add(
        HTML.element(
            "button"
            {"type": "submit", "class": buttonClass, "title": label}
            [HTML.text(label)]
        )
    )
    return HTML.element(
        "form"
        {"method": "get", "action": action, "class": "d-inline"}
        children
    )
}

queryForm: Function := (
    action: String
    fields: Pair<String, String>
    label: String
) -> HTMLNode {
    return queryFormClass(
        action
        fields
        label
        "btn btn-sm btn-outline-secondary"
    )
}

mysqlActionGroup: Function := (schema: String, table: String) -> HTMLNode {
    fields: Local Pair<String, String> := {"database": schema, "table": table}
    return HTML.element(
        "div"
        {"class": "studio-actions"}
        [
            queryFormClass(
                "/AhdDataStudio/mysql/browse"
                fields
                "Browse"
                "btn btn-sm btn-primary"
            )
            queryFormClass(
                "/AhdDataStudio/mysql/table"
                fields
                "Structure"
                "btn btn-sm btn-outline-secondary"
            )
            queryFormClass(
                "/AhdDataStudio/mysql/indexes"
                fields
                "Indexes"
                "btn btn-sm btn-outline-secondary"
            )
        ]
    )
}

sqliteActionGroup: Function := (path: String, table: String) -> HTMLNode {
    fields: Local Pair<String, String> := {"db": path, "table": table}
    return HTML.element(
        "div"
        {"class": "studio-actions"}
        [
            queryFormClass(
                "/AhdDataStudio/sqlite/browse"
                fields
                "Browse"
                "btn btn-sm btn-primary"
            )
            queryFormClass(
                "/AhdDataStudio/sqlite/table"
                fields
                "Structure"
                "btn btn-sm btn-outline-secondary"
            )
            queryFormClass(
                "/AhdDataStudio/sqlite/indexes"
                fields
                "Indexes"
                "btn btn-sm btn-outline-secondary"
            )
        ]
    )
}

tableKindMatches: Function := (tableType: String, kind: String) -> Bool {
    if kind == "all" or kind == "" {
        return true
    }
    if kind == "table" {
        return tableType == "BASE TABLE"
    }
    if kind == "view" {
        return tableType == "VIEW"
    }
    if kind == "system" {
        return tableType == "SYSTEM VIEW"
    }
    return true
}

typeBadge: Function := (tableType: String) -> HTMLNode {
    className: Local String := "badge text-bg-secondary"
    label: Local String := tableType
    if tableType == "BASE TABLE" {
        className = "badge text-bg-primary"
        label = "Table"
    }
    if tableType == "VIEW" {
        className = "badge text-bg-info"
        label = "View"
    }
    if tableType == "SYSTEM VIEW" {
        className = "badge text-bg-warning"
        label = "System"
    }
    return HTML.element(
        "span"
        {"class": className, "title": tableType}
        [HTML.text(label)]
    )
}

statusBadge: Function := (label: String, ok: Bool) -> HTMLNode {
    className: Local String := "badge rounded-pill text-bg-secondary studio-status-badge"
    if ok {
        className = "badge rounded-pill text-bg-success studio-status-badge"
    }
    return HTML.element("span", {"class": className}, [HTML.text(label)])
}

emptyState: Function := (title: String, message: String) -> HTMLNode {
    return HTML.element(
        "div"
        {"class": "studio-empty"}
        [
            HTML.element(
                "div"
                {"class": "studio-empty-icon"}
                [HTML.text("○")]
            )
            HTML.element("h2", {"class": "h6 mb-2"}, [HTML.text(title)])
            HTML.element(
                "p"
                {"class": "text-muted mb-0"}
                [HTML.text(message)]
            )
        ]
    )
}

fieldNode: Function := (
    name: String
    sqlType: String
    nullable: String
) -> HTMLNode {
    meta: Local String := sqlType
    if nullable == "YES" {
        meta = meta + " · nullable"
    }
    return HTML.element(
        "div"
        {"class": "col-md-6 col-xl-4"}
        [
            HTML.element(
                "label"
                {"class": "form-label small fw-semibold mb-1"}
                [HTML.text(name)]
            )
            HTML.element(
                "div"
                {"class": "studio-field-meta"}
                [HTML.text(meta)]
            )
            HTML.element(
                "input"
                {
                    "type": "text"
                    "name": "col_" + name
                    "class": "form-control form-control-sm"
                }
                []
            )
        ]
    )
}

schemaSideList: Function := (names: List<String>, current: String) -> HTMLNode {
    items: Local List<HTMLNode> := []
    for name in names {
        buttonClass: Local String := "list-group-item list-group-item-action py-1 px-2 studio-side-item"
        if name == current {
            buttonClass = buttonClass + " active"
        }
        items.add(
            queryFormClass(
                "/AhdDataStudio/mysql/database"
                {"database": name}
                name
                buttonClass
            )
        )
    }
    return HTML.element(
        "div"
        {"class": "list-group studio-side-list mb-3"}
        items
    )
}

kindTab: Function := (
    schema: String
    kind: String
    current: String
    label: String
    count: Int
) -> HTMLNode {
    className: Local String := "nav-link"
    if kind == current {
        className = "nav-link active"
    }
    return HTML.element(
        "li"
        {"class": "nav-item"}
        [
            queryFormClass(
                "/AhdDataStudio/mysql/database"
                {"database": schema, "kind": kind}
                label + " (" + str(count) + ")"
                className
            )
        ]
    )
}

bootstrapPath: Function := () -> String {
    if File.exists("assets/bootstrap.min.css") {
        return "assets/bootstrap.min.css"
    }
    return "tools/AhdDataStudio/assets/bootstrap.min.css"
}

logoPath: Function := () -> String {
    if File.exists("assets/ahdcode-logo.png") {
        return "assets/ahdcode-logo.png"
    }
    if File.exists("tools/AhdDataStudio/assets/ahdcode-logo.png") {
        return "tools/AhdDataStudio/assets/ahdcode-logo.png"
    }
    return "editors/vscode/images/ahdcode-logo.png"
}

serveBootstrap: Function := (request: Request) -> Response {
    return HTTP.file(bootstrapPath(), "text/css")
}

serveLogo: Function := (request: Request) -> Response {
    return HTTP.file(logoPath(), "image/png")
}

studioCSS: Function := () -> String {
    return r"""
:root {
    --studio-bg: #f4f6f8;
    --studio-panel: #ffffff;
    --studio-border: #dfe3e8;
    --studio-border-strong: #cbd2da;
    --studio-text: #1f2937;
    --studio-muted: #6b7280;
    --studio-navy: #1f3155;
    --studio-navy-2: #2e4774;
    --studio-accent: #8a1f12;
    --studio-sidebar: #edf1f5;
}
html, body { min-height: 100%; }
body {
    margin: 0;
    background: var(--studio-bg);
    color: var(--studio-text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
}
.studio-navbar {
    position: sticky;
    top: 0;
    z-index: 1030;
    background: rgba(255,255,255,.97);
    border-bottom: 1px solid var(--studio-border);
    box-shadow: 0 1px 3px rgba(15,23,42,.04);
}
.studio-navbar .navbar-brand { color: var(--studio-navy); gap: .65rem; }
.studio-navbar .navbar-nav .nav-link {
    color: #445064;
    padding: .45rem .75rem;
    border-radius: .35rem;
}
.studio-navbar .navbar-nav .nav-link:hover {
    color: var(--studio-accent);
    background: #f7f2f1;
}
.studio-logo { height: 34px; width: auto; display: block; }
.studio-local-badge {
    color: #445064;
    background: #f8fafc;
    border: 1px solid var(--studio-border);
    font-weight: 500;
}
.studio-sidebar {
    background: var(--studio-sidebar);
    min-height: calc(100vh - 58px);
    border-right: 1px solid var(--studio-border);
    font-size: 13px;
    overflow-x: hidden;
}
.studio-sidebar-label {
    letter-spacing: .08em;
    font-size: 11px;
    font-weight: 700;
    color: #7a8494;
}
.studio-side-list form { display: block; margin: 0; max-width: 100%; }
.studio-side-list button, .studio-side-item {
    width: 100%;
    max-width: 100%;
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.studio-side-list .list-group-item {
    border-color: transparent;
    background: transparent;
    color: #445064;
}
.studio-side-list .list-group-item:hover { background: rgba(255,255,255,.7); }
.studio-side-list .list-group-item.active {
    background: #dce5f0;
    border-color: #c8d4e2;
    color: #183454;
    font-weight: 600;
}
.studio-main { min-width: 0; }
.studio-content { max-width: 1500px; }
.studio-page-heading { margin-bottom: 1rem; }
.studio-page-heading .eyebrow {
    color: var(--studio-muted);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .08em;
    font-weight: 700;
}
.studio-tabs { border-bottom: 1px solid var(--studio-border); flex-wrap: wrap; }
.studio-tabs .nav-item { margin-bottom: -1px; }
.studio-tabs .nav-item form { display: block; margin: 0; }
.studio-tabs .nav-link {
    border: 1px solid transparent;
    border-top-left-radius: .375rem;
    border-top-right-radius: .375rem;
    background: transparent;
    color: #305d8c;
    font-size: 13px;
    padding: .45rem .7rem;
}
.studio-tabs .nav-link:hover { background: #f8fafc; }
.studio-tabs .nav-link.active {
    background: #fff;
    border-color: var(--studio-border) var(--studio-border) #fff;
    color: #212529;
    font-weight: 600;
}
.studio-name {
    font-size: 12.5px;
    color: #212529;
    word-break: break-word;
    overflow-wrap: anywhere;
    background: transparent;
}
.studio-actions {
    display: inline-flex;
    flex-wrap: nowrap;
    gap: 4px;
    align-items: center;
}
.studio-actions form { display: inline; margin: 0; }
.studio-actions .btn {
    padding: .18rem .5rem;
    font-size: 12px;
    line-height: 1.2;
    border-radius: .25rem;
}
.studio-table-wrap {
    border: 1px solid var(--studio-border);
    border-radius: .45rem;
    background: #fff;
    overflow: auto;
}
.studio-table { width: 100%; margin-bottom: 0; }
.studio-table td, .studio-table th { vertical-align: middle; border-color: #e8ebef; }
.studio-table thead th {
    color: #4b5563;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
}
.studio-table tbody tr:hover { background: #f8fafc; }
.studio-actions-cell { width: 1%; white-space: nowrap; }
.studio-card {
    border: 1px solid var(--studio-border);
    box-shadow: 0 1px 2px rgba(15,23,42,.04);
}
.studio-card .card-header {
    background: #fafbfc;
    border-bottom-color: var(--studio-border);
}
.studio-provider-icon {
    width: 38px;
    height: 38px;
    border-radius: .5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    color: #fff;
    background: var(--studio-navy-2);
}
.studio-provider-icon.sqlite { background: #5f6f82; }
.studio-status-badge { font-weight: 600; letter-spacing: .01em; }
.studio-empty {
    border: 1px dashed var(--studio-border-strong);
    border-radius: .55rem;
    background: #fff;
    padding: 2.25rem 1.5rem;
    text-align: center;
    max-width: 760px;
}
.studio-empty-icon {
    width: 38px;
    height: 38px;
    margin: 0 auto .75rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eef2f6;
    color: #637083;
    font-size: 20px;
}
.studio-panel {
    border: 1px solid var(--studio-border);
    border-radius: .5rem;
    background: #fff;
    padding: 1rem;
}
.studio-field-meta {
    color: var(--studio-muted);
    font-size: 11px;
    min-height: 17px;
    margin-bottom: .3rem;
}
.studio-sortbar {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
    padding: .65rem;
    margin-bottom: .75rem;
    border: 1px solid var(--studio-border);
    border-radius: .45rem;
    background: #fff;
}
.studio-pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    margin-top: .75rem;
}
.studio-pagination .pager-actions {
    display: flex;
    gap: .4rem;
}
.studio-row-action {
    border: 1px solid var(--studio-border);
    border-radius: .45rem;
    background: #fff;
    padding: .85rem;
    margin-bottom: .6rem;
}
.studio-row-action form { margin: 0; }
.studio-row-action-fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: .45rem;
}
.studio-row-action .form-control { min-width: 0; }
.studio-danger {
    border: 1px solid #efc2c7;
    border-left: 4px solid #b02a37;
    background: #fff7f8;
    border-radius: .45rem;
    padding: 1rem;
}
.studio-sql {
    border: 1px solid var(--studio-border);
    border-radius: .5rem;
    background: #fff;
    padding: 1rem;
}
.studio-sql-context {
    color: var(--studio-muted);
    font-size: 12px;
    margin-bottom: .65rem;
}
textarea.form-control {
    min-height: 230px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 13px;
    line-height: 1.5;
    resize: vertical;
}
code, .studio-mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}
h1.h4, h1.h3 { overflow-wrap: anywhere; }
.ok { color: #146c43; font-weight: 600; }
.fail { color: #b02a37; font-weight: 600; }
@media (max-width: 767.98px) {
    .studio-navbar .navbar-nav { display: none; }
    .studio-sidebar {
        min-height: auto;
        border-right: 0;
        border-bottom: 1px solid var(--studio-border);
    }
    .studio-content { padding-left: .25rem; padding-right: .25rem; }
    .studio-actions { flex-wrap: wrap; }
}
"""
}

layout: Function := (
    title: String
    token: String
    body: List<HTMLNode>
) -> String {
    sqliteLinks: Local List<HTMLNode> := []
    attempt {
        files: Local List<String> := allowedSqlitePaths()
        for path in files {
            sqliteLinks.add(
                queryFormClass(
                    "/AhdDataStudio/sqlite/database"
                    {"db": path}
                    Path.base(path)
                    "btn btn-sm btn-outline-secondary w-100 text-start mb-1"
                )
            )
        }
    }
    except FileError {}
    mysqlSchemaCache: Global List<String>
    mysqlActiveSchema: Global String
    sideBody: Local List<HTMLNode> := [
        HTML.element(
            "div"
            {"class": "studio-sidebar-label px-1 mb-2"}
            [HTML.text("MYSQL")]
        )
        HTML.element(
            "a"
            {
                "class": "btn btn-sm btn-light border w-100 text-start mb-2"
                "href": "/AhdDataStudio/mysql"
            }
            [HTML.text("All databases")]
        )
    ]
    if len(mysqlSchemaCache) > 0 {
        sideBody.add(schemaSideList(mysqlSchemaCache, mysqlActiveSchema))
    }
    sideBody.add(
        HTML.element(
            "div"
            {"class": "studio-sidebar-label px-1 mt-3 mb-2"}
            [HTML.text("SQLITE")]
        )
    )
    for link in sqliteLinks {
        sideBody.add(link)
    }
    if len(sqliteLinks) == 0 {
        sideBody.add(
            HTML.element(
                "div"
                {"class": "small text-muted px-1 py-2"}
                [
                    HTML.text("No project databases")
                    HTML.element(
                        "div"
                        {"class": "mt-1"}
                        [
                            HTML.text(
                                "Configure a project root or explicit path."
                            )
                        ]
                    )
                ]
            )
        )
    }
    nodes: Local List<HTMLNode> := [
        HTML.element(
            "link"
            {
                "rel": "stylesheet"
                "href": "/AhdDataStudio/assets/bootstrap.min.css"
            }
            []
        )
        HTML.element("style", {}, [HTML.text(studioCSS())])
        HTML.element(
            "nav"
            {"class": "navbar navbar-expand navbar-light studio-navbar"}
            [
                HTML.element(
                    "div"
                    {"class": "container-fluid"}
                    [
                        HTML.element(
                            "div"
                            {"class": "d-flex align-items-center gap-2"}
                            [
                                HTML.element(
                                    "a"
                                    {
                                        "class": "navbar-brand d-flex align-items-center mb-0"
                                        "href": "/AhdDataStudio"
                                    }
                                    [
                                        HTML.element(
                                            "img"
                                            {
                                                "src": "/AhdDataStudio/assets/ahdcode-logo.png"
                                                "alt": "AhdCode"
                                                "class": "studio-logo"
                                            }
                                            []
                                        )
                                        HTML.element(
                                            "span"
                                            {"class": "fw-semibold"}
                                            [HTML.text("AhdDataStudio")]
                                        )
                                    ]
                                )
                                HTML.element(
                                    "span"
                                    {"class": "badge studio-local-badge"}
                                    [HTML.text("Local · 127.0.0.1")]
                                )
                            ]
                        )
                        HTML.element(
                            "div"
                            {"class": "navbar-nav"}
                            [
                                HTML.element(
                                    "a"
                                    {
                                        "class": "nav-link"
                                        "href": "/AhdDataStudio"
                                    }
                                    [HTML.text("Dashboard")]
                                )
                                HTML.element(
                                    "a"
                                    {
                                        "class": "nav-link"
                                        "href": "/AhdDataStudio/mysql"
                                    }
                                    [HTML.text("MySQL")]
                                )
                                HTML.element(
                                    "a"
                                    {
                                        "class": "nav-link"
                                        "href": "/AhdDataStudio/sqlite"
                                    }
                                    [HTML.text("SQLite")]
                                )
                            ]
                        )
                    ]
                )
            ]
        )
        HTML.element(
            "div"
            {"class": "container-fluid"}
            [
                HTML.element(
                    "div"
                    {"class": "row"}
                    [
                        HTML.element(
                            "aside"
                            {"class": "col-md-3 col-lg-2 studio-sidebar py-3"}
                            sideBody
                        )
                        HTML.element(
                            "main"
                            {"class": "col-md-9 col-lg-10 studio-main py-4"}
                            [
                                HTML.element(
                                    "div"
                                    {"class": "studio-content"}
                                    body
                                )
                            ]
                        )
                    ]
                )
            ]
        )
    ]
    return HTML.document("AhdDataStudio · " + title, nodes)
}

errorNodes: Function := (message: String) -> List<HTMLNode> {
    return [
        HTML.element("h1", {"class": "h4"}, [HTML.text("Error")])
        HTML.element(
            "div"
            {"class": "alert alert-danger"}
            [HTML.text(redact(message))]
        )
    ]
}

parsePage: Function := (text: String?) -> Int {
    if text == null {
        return 1
    }
    attempt {
        value: Local Int := int(text)
        if value < 1 {
            return 1
        }
        return value
    }
    except DomainError {
        return 1
    }
    except OverflowError {
        return 1
    }
}

sortDirection: Function := (text: String?) -> String {
    if text == null {
        return "ASC"
    }
    if text.upper() == "DESC" {
        return "DESC"
    }
    return "ASC"
}

sqliteTables: Function := (db: Database) -> List<Pair<String, String>> {
    rows: Local List<Pair<String, SQLiteValue>> := db.query(
        "SELECT name, type FROM sqlite_master WHERE type IN ('table', 'view') AND name NOT LIKE 'sqlite_%' ORDER BY name"
    )
    tables: Local List<Pair<String, String>> := []
    for row in rows {
        name: Local String := ""
        kind: Local String := ""
        if "name" in row {
            if row["name"].kind() == "String" {
                name = row["name"].string()
            }
        }
        if "type" in row {
            if row["type"].kind() == "String" {
                kind = row["type"].string()
            }
        }
        tables.add({"name": name, "type": kind})
    }
    return tables
}

sqliteTableNames: Function := (db: Database) -> List<String> {
    names: Local List<String> := []
    tables: Local List<Pair<String, String>> := sqliteTables(db)
    for table in tables {
        names.add(table["name"])
    }
    return names
}

sqliteColumns: Function := (
    db: Database
    table: String
) -> List<Pair<String, String>> {
    sql: Local String := "PRAGMA table_info(" + quoteSqlite(table) + ")"
    rows: Local List<Pair<String, SQLiteValue>> := db.query(sql)
    columns: Local List<Pair<String, String>> := []
    for row in rows {
        name: Local String := ""
        sqlType: Local String := ""
        nullable: Local String := "YES"
        defaultValue: Local String := ""
        key: Local String := ""
        if "name" in row {
            if row["name"].kind() == "String" {
                name = row["name"].string()
            }
        }
        if "type" in row {
            if row["type"].kind() == "String" {
                sqlType = row["type"].string()
            }
        }
        if "notnull" in row {
            if row["notnull"].kind() == "Int" {
                if row["notnull"].int() != 0 {
                    nullable = "NO"
                }
            }
        }
        if "dflt_value" in row {
            if not row["dflt_value"].isNull() {
                if row["dflt_value"].kind() == "String" {
                    defaultValue = row["dflt_value"].string()
                }
                else if row["dflt_value"].kind() == "Int" {
                    defaultValue = str(row["dflt_value"].int())
                }
                else if row["dflt_value"].kind() == "Real" {
                    defaultValue = str(row["dflt_value"].real())
                }
            }
        }
        if "pk" in row {
            if row["pk"].kind() == "Int" {
                if row["pk"].int() != 0 {
                    key = "PRI"
                }
            }
        }
        columns.add(
            {
                "name": name
                "type": sqlType
                "nullable": nullable
                "default": defaultValue
                "key": key
                "extra": ""
            }
        )
    }
    return columns
}

sqliteBrowseColumns: Function := (
    columns: List<Pair<String, String>>
) -> List<String> {
    names: Local List<String> := []
    for column in columns {
        declared: Local String := column["type"].lower()
        if declared.contains("blob") {
            continue
        }
        names.add(column["name"])
    }
    return names
}

htmlTable: Function := (
    headers: List<String>
    rows: List<List<String>>
) -> HTMLNode {
    headCells: Local List<HTMLNode> := []
    for header in headers {
        headCells.add(HTML.element("th", {}, [HTML.text(header)]))
    }
    bodyRows: Local List<HTMLNode> := []
    for row in rows {
        cells: Local List<HTMLNode> := []
        for cell in row {
            cells.add(HTML.element("td", {}, [HTML.text(cell)]))
        }
        bodyRows.add(HTML.element("tr", {}, cells))
    }
    return HTML.element(
        "div"
        {"class": "studio-table-wrap"}
        [
            HTML.element(
                "table"
                {
                    "class": "table table-sm table-striped table-hover align-middle bg-white studio-table"
                }
                [
                    HTML.element(
                        "thead"
                        {"class": "table-light"}
                        [HTML.element("tr", {}, headCells)]
                    )
                    HTML.element("tbody", {}, bodyRows)
                ]
            )
        ]
    )
}

home: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    mysqlStatus: Local String := "Not configured"
    mysqlDetail: Local String := ""
    mysqlOk: Local Bool := false
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            names: Local List<String> := mysqlDatabases(db)
            mysqlOk = true
            mysqlStatus = "Connected"
            mysqlDetail = str(len(names)) + " visible databases"
        }
        except MySQLError as error {
            mysqlStatus = "Connection failed"
            mysqlDetail = redact(error.message)
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        mysqlStatus = "Connection failed"
        mysqlDetail = redact(error.message)
    }
    except DomainError as error {
        mysqlStatus = "Connection failed"
        mysqlDetail = redact(error.message)
    }

    sqliteFiles: Local List<String> := []
    sqliteStatus: Local String := "No project databases"
    attempt {
        sqliteFiles = allowedSqlitePaths()
        sqliteStatus = str(len(sqliteFiles)) + " database file(s)"
    }
    except FileError as error {
        sqliteStatus = "Discovery failed"
        sqliteDetail: Local String := redact(error.message)
        sqliteStatus = sqliteStatus + " — " + sqliteDetail
    }

    host: Local String := Env.getOr("AHD_DATA_MYSQL_HOST", "127.0.0.1")
    port: Local String := Env.getOr("AHD_DATA_MYSQL_PORT", "3306")

    sqliteDetailNodes: Local List<HTMLNode> := [
        HTML.element(
            "p"
            {"class": "mb-2 text-muted"}
            [HTML.text(sqliteStatus)]
        )
    ]
    if len(sqliteFiles) == 0 {
        sqliteDetailNodes.add(
            HTML.element(
                "p"
                {"class": "small text-muted mb-3"}
                [
                    HTML.text(
                        "Set AHD_DATA_SQLITE_PATHS or AHD_DATA_PROJECT_ROOT to add a project database."
                    )
                ]
            )
        )
    }

    body: Local List<HTMLNode> := [
        HTML.element(
            "div"
            {"class": "studio-page-heading"}
            [
                HTML.element(
                    "div"
                    {"class": "eyebrow"}
                    [HTML.text("Developer database workspace")]
                )
                HTML.element(
                    "h1"
                    {"class": "h3 mb-1"}
                    [HTML.text("AhdDataStudio")]
                )
                HTML.element(
                    "p"
                    {"class": "text-muted mb-0"}
                    [
                        HTML.text(
                            "Inspect and work with local MySQL and project-scoped SQLite databases from one AhdCode application."
                        )
                    ]
                )
            ]
        )
        HTML.element(
            "div"
            {"class": "row g-3"}
            [
                HTML.element(
                    "div"
                    {"class": "col-lg-6"}
                    [
                        HTML.element(
                            "div"
                            {"class": "card studio-card h-100"}
                            [
                                HTML.element(
                                    "div"
                                    {"class": "card-body"}
                                    [
                                        HTML.element(
                                            "div"
                                            {
                                                "class": "d-flex justify-content-between align-items-start mb-3"
                                            }
                                            [
                                                HTML.element(
                                                    "div"
                                                    {
                                                        "class": "d-flex gap-3 align-items-center"
                                                    }
                                                    [
                                                        HTML.element(
                                                            "span"
                                                            {
                                                                "class": "studio-provider-icon"
                                                            }
                                                            [HTML.text("M")]
                                                        )
                                                        HTML.element(
                                                            "div"
                                                            {}
                                                            [
                                                                HTML.element(
                                                                    "h2"
                                                                    {
                                                                        "class": "h5 mb-0"
                                                                    }
                                                                    [
                                                                        HTML.text(
                                                                            "MySQL"
                                                                        )
                                                                    ]
                                                                )
                                                                HTML.element(
                                                                    "div"
                                                                    {
                                                                        "class": "small text-muted studio-mono"
                                                                    }
                                                                    [
                                                                        HTML.text(
                                                                            host + ":" + port
                                                                        )
