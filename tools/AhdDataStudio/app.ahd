                                                                            "Project databases only"
                                                                        )
                                                                    ]
                                                                )
                                                            ]
                                                        )
                                                    ]
                                                )
                                                HTML.element(
                                                    "span"
                                                    {
                                                        "class": "badge rounded-pill text-bg-secondary studio-status-badge"
                                                    }
                                                    [
                                                        HTML.text(
                                                            str(
                                                                len(sqliteFiles)
                                                            ) + " found"
                                                        )
                                                    ]
                                                )
                                            ]
                                        )
                                        HTML.element(
                                            "div"
                                            {}
                                            sqliteDetailNodes
                                        )
                                        HTML.element(
                                            "a"
                                            {
                                                "class": "btn btn-primary btn-sm"
                                                "href": "/AhdDataStudio/sqlite"
                                            }
                                            [HTML.text("Open SQLite")]
                                        )
                                    ]
                                )
                            ]
                        )
                    ]
                )
            ]
        )
        HTML.element(
            "div"
            {"class": "studio-panel mt-3"}
            [
                HTML.element(
                    "div"
                    {"class": "small fw-semibold mb-1"}
                    [HTML.text("Safety boundary")]
                )
                HTML.element(
                    "div"
                    {"class": "small text-muted"}
                    [
                        HTML.text(
                            "AhdDataStudio is bound to 127.0.0.1 and SQLite discovery remains limited to explicitly configured paths or immediate children of the configured project root."
                        )
                    ]
                )
            ]
        )
    ]
    return sessions.commit(session, HTTP.html(layout("Home", token, body)))
}

mysqlHome: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            names: Local List<String> := mysqlDatabases(db)
            dbRows: Local List<HTMLNode> := []
            for name in names {
                dbRows.add(
                    HTML.element(
                        "tr"
                        {}
                        [
                            HTML.element(
                                "td"
                                {}
                                [HTML.element("strong", {}, [HTML.text(name)])]
                            )
                            HTML.element(
                                "td"
                                {"class": "text-end"}
                                [
                                    queryFormClass(
                                        "/AhdDataStudio/mysql/database"
                                        {"database": name}
                                        "Open"
                                        "btn btn-sm btn-primary"
                                    )
                                ]
                            )
                        ]
                    )
                )
            }
            body: Local List<HTMLNode> := [
                HTML.element("h1", {"class": "h4 mb-2"}, [HTML.text("MySQL")])
                HTML.element(
                    "p"
                    {"class": "text-muted"}
                    [
                        HTML.text(
                            str(
                                len(names)
                            ) + " visible schemas for these credentials."
                        )
                    ]
                )
                HTML.element(
                    "div"
                    {"class": "table-responsive"}
                    [
                        HTML.element(
                            "table"
                            {
                                "class": "table table-sm table-hover align-middle bg-white"
                            }
                            [
                                HTML.element(
                                    "thead"
                                    {"class": "table-light"}
                                    [
                                        HTML.element(
                                            "tr"
                                            {}
                                            [
                                                HTML.element(
                                                    "th"
                                                    {}
                                                    [HTML.text("Database")]
                                                )
                                                HTML.element(
                                                    "th"
                                                    {"class": "text-end"}
                                                    [HTML.text("")]
                                                )
                                            ]
                                        )
                                    ]
                                )
                                HTML.element("tbody", {}, dbRows)
                            ]
                        )
                    ]
                )
            ]
            return sessions.commit(
                session
                HTTP.html(layout("MySQL", token, body))
            )
        }
        except MySQLError as error {
            return sessions.commit(
                session
                HTTP.html(layout("MySQL", token, errorNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return sessions.commit(
            session
            HTTP.html(layout("MySQL", token, errorNodes(error.message)))
        )
    }
}

mysqlDatabasePage: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    schema: Local String? := request.query("database")
    if schema == null {
        schema = request.form("database")
    }
    if schema == null {
        return sessions.commit(
            session
            HTTP.html(
                layout("MySQL", token, errorNodes("database is required"))
            )
        )
    }
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            allowed: Local List<String> := mysqlDatabases(db)
            if not (schema in allowed) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("MySQL", token, errorNodes("unknown database"))
                    )
                )
            }
            mysqlActiveSchema: Global String
            mysqlActiveSchema = schema
            kind: Local String := "all"
            kindQuery: Local String? := request.query("kind")
            if kindQuery != null {
                kind = kindQuery
            }
            filter: Local String := ""
            filterQuery: Local String? := request.query("q")
            if filterQuery != null {
                filter = filterQuery
            }
            tables: Local List<Pair<String, String>> := mysqlTables(db, schema)
            countAll: Local Int := 0
            countTable: Local Int := 0
            countView: Local Int := 0
            countSystem: Local Int := 0
            tableRows: Local List<HTMLNode> := []
            for table in tables {
                tableType: Local String := table["type"]
                countAll++
                if tableType == "BASE TABLE" {
                    countTable++
                }
                if tableType == "VIEW" {
                    countView++
                }
                if tableType == "SYSTEM VIEW" {
                    countSystem++
                }
                if not tableKindMatches(tableType, kind) {
                    continue
                }
                if filter != "" {
                    if not table["name"].lower().contains(filter.lower()) {
                        continue
                    }
                }
                name: Local String := table["name"]
                tableRows.add(
                    HTML.element(
                        "tr"
                        {}
                        [
                            HTML.element(
                                "td"
                                {}
                                [
                                    HTML.element(
                                        "code"
                                        {"class": "studio-name", "title": name}
                                        [HTML.text(name)]
                                    )
                                ]
                            )
                            HTML.element(
                                "td"
                                {"class": "studio-actions-cell"}
                                [mysqlActionGroup(schema, name)]
                            )
                            HTML.element("td", {}, [typeBadge(tableType)])
                            HTML.element("td", {}, [HTML.text(table["engine"])])
                            HTML.element(
                                "td"
                                {"class": "text-end"}
                                [HTML.text(table["rows"])]
                            )
                        ]
                    )
                )
            }
            body: Local List<HTMLNode> := [
                HTML.element("h1", {"class": "h4 mb-1"}, [HTML.text(schema)])
                HTML.element(
                    "p"
                    {"class": "text-muted small"}
                    [
                        HTML.text(
                            "TABLE_ROWS is an estimate when MySQL provides one, not an exact COUNT(*)."
                        )
                    ]
                )
                HTML.element(
                    "ul"
                    {"class": "nav nav-tabs studio-tabs mb-3"}
                    [
                        kindTab(schema, "all", kind, "All", countAll)
                        kindTab(schema, "table", kind, "Tables", countTable)
                        kindTab(schema, "view", kind, "Views", countView)
                        kindTab(schema, "system", kind, "System", countSystem)
                    ]
                )
                HTML.element(
                    "form"
                    {
                        "method": "get"
                        "action": "/AhdDataStudio/mysql/database"
                        "class": "row g-2 mb-3"
                    }
                    [
                        hiddenField("database", schema)
                        hiddenField("kind", kind)
                        HTML.element(
                            "div"
                            {"class": "col-auto"}
                            [
                                HTML.element(
                                    "input"
                                    {
                                        "type": "search"
                                        "name": "q"
                                        "value": filter
                                        "class": "form-control form-control-sm"
                                        "placeholder": "Filter tables"
                                    }
                                    []
                                )
                            ]
                        )
                        HTML.element(
                            "div"
                            {"class": "col-auto"}
                            [
                                HTML.element(
                                    "button"
                                    {
                                        "type": "submit"
                                        "class": "btn btn-sm btn-outline-secondary"
                                    }
                                    [HTML.text("Filter")]
                                )
                            ]
                        )
                    ]
                )
                HTML.element(
                    "div"
                    {
                        "class": "d-flex justify-content-between align-items-center mb-2"
                    }
                    [
                        HTML.element(
                            "span"
                            {"class": "small text-muted"}
                            [HTML.text(str(len(tableRows)) + " shown")]
                        )
                        queryFormClass(
                            "/AhdDataStudio/mysql/sql"
                            {"database": schema}
                            "SQL console"
                            "btn btn-sm btn-outline-primary"
                        )
                    ]
                )
                HTML.element(
                    "div"
                    {"class": "table-responsive"}
                    [
                        HTML.element(
                            "table"
                            {
                                "class": "table table-sm table-striped table-hover align-middle bg-white studio-table"
                            }
                            [
                                HTML.element(
                                    "thead"
                                    {"class": "table-light"}
                                    [
                                        HTML.element(
                                            "tr"
                                            {}
                                            [
                                                HTML.element(
                                                    "th"
                                                    {}
                                                    [HTML.text("Table")]
                                                )
                                                HTML.element(
                                                    "th"
                                                    {}
                                                    [HTML.text("Action")]
                                                )
                                                HTML.element(
                                                    "th"
                                                    {}
                                                    [HTML.text("Type")]
                                                )
                                                HTML.element(
                                                    "th"
                                                    {}
                                                    [HTML.text("Engine")]
                                                )
                                                HTML.element(
                                                    "th"
                                                    {"class": "text-end"}
                                                    [HTML.text("Approx. rows")]
                                                )
                                            ]
                                        )
                                    ]
                                )
                                HTML.element("tbody", {}, tableRows)
                            ]
                        )
                    ]
                )
            ]
            return sessions.commit(
                session
                HTTP.html(layout(schema, token, body))
            )
        }
        except MySQLError as error {
            return sessions.commit(
                session
                HTTP.html(layout("MySQL", token, errorNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return sessions.commit(
            session
            HTTP.html(layout("MySQL", token, errorNodes(error.message)))
        )
    }
}

mysqlTableNav: Function := (
    schema: String
    table: String
    current: String
) -> HTMLNode {
    fields: Local Pair<String, String> := {"database": schema, "table": table}
    browseClass: Local String := "nav-link"
    structureClass: Local String := "nav-link"
    indexClass: Local String := "nav-link"
    sqlClass: Local String := "nav-link"
    if current == "browse" {
        browseClass = "nav-link active"
    }
    if current == "structure" {
        structureClass = "nav-link active"
    }
    if current == "indexes" {
        indexClass = "nav-link active"
    }
    if current == "sql" {
        sqlClass = "nav-link active"
    }
    return HTML.element(
        "ul"
        {"class": "nav nav-tabs studio-tabs mb-3"}
        [
            HTML.element(
                "li"
                {"class": "nav-item"}
                [
                    queryFormClass(
                        "/AhdDataStudio/mysql/database"
                        {"database": schema}
                        "Tables"
                        "nav-link"
                    )
                ]
            )
            HTML.element(
                "li"
                {"class": "nav-item"}
                [
                    queryFormClass(
                        "/AhdDataStudio/mysql/browse"
                        fields
                        "Browse"
                        browseClass
                    )
                ]
            )
            HTML.element(
                "li"
                {"class": "nav-item"}
                [
                    queryFormClass(
                        "/AhdDataStudio/mysql/table"
                        fields
                        "Structure"
                        structureClass
                    )
                ]
            )
            HTML.element(
                "li"
                {"class": "nav-item"}
                [
                    queryFormClass(
                        "/AhdDataStudio/mysql/indexes"
                        fields
                        "Indexes"
                        indexClass
                    )
                ]
            )
            HTML.element(
                "li"
                {"class": "nav-item"}
                [
                    queryFormClass(
                        "/AhdDataStudio/mysql/sql"
                        {"database": schema}
                        "SQL"
                        sqlClass
                    )
                ]
            )
        ]
    )
}

mysqlStructurePage: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    schema: Local String? := request.query("database")
    table: Local String? := request.query("table")
    if schema == null or table == null {
        return sessions.commit(
            session
            HTTP.html(
                layout(
                    "MySQL"
                    token
                    errorNodes("database and table are required")
                )
            )
        )
    }
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            if not (schema in mysqlDatabases(db)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("MySQL", token, errorNodes("unknown database"))
                    )
                )
            }
            if not (table in mysqlTableNames(db, schema)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("MySQL", token, errorNodes("unknown table"))
                    )
                )
            }
            columns: Local List<Pair<String, String>> := mysqlColumns(
                db
                schema
                table
            )
            rows: Local List<List<String>> := []
            insertFields: Local List<HTMLNode> := [
                csrfField(token)
                hiddenField("database", schema)
                hiddenField("table", table)
            ]
            for column in columns {
                rows.add(
                    [
                        column["name"]
                        column["type"]
                        column["nullable"]
                        column["default"]
                        column["key"]
                        column["extra"]
                    ]
                )
                extra: Local String := column["extra"].lower()
                if not extra.contains("auto_increment") {
                    insertFields.add(
                        fieldNode(
                            column["name"]
                            column["type"]
                            column["nullable"]
                        )
                    )
                }
            }
            insertFields.add(
                HTML.element(
                    "div"
                    {"class": "col-12"}
                    [
                        HTML.element(
                            "button"
                            {
                                "type": "submit"
                                "class": "btn btn-primary btn-sm"
                            }
                            [HTML.text("Insert row")]
                        )
                    ]
                )
            )
            body: Local List<HTMLNode> := [
                HTML.element(
                    "h1"
                    {"class": "h4 mb-1"}
                    [HTML.text(schema + "." + table)]
                )
                HTML.element(
                    "p"
                    {"class": "small text-muted studio-mono"}
                    [HTML.text("MySQL table structure")]
                )
                mysqlTableNav(schema, table, "structure")
                htmlTable(
                    ["Column", "Type", "Nullable", "Default", "Key", "Extra"]
                    rows
                )
                HTML.element(
                    "div"
                    {"class": "studio-panel mt-3"}
                    [
                        HTML.element(
                            "div"
                            {
                                "class": "d-flex justify-content-between align-items-center mb-3"
                            }
                            [
                                HTML.element(
                                    "h2"
                                    {"class": "h6 mb-0"}
                                    [HTML.text("Insert row")]
                                )
                                HTML.element(
                                    "span"
                                    {"class": "small text-muted"}
                                    [
                                        HTML.text(
                                            "Values are submitted through parameter binding."
                                        )
                                    ]
                                )
                            ]
                        )
                        HTML.element(
                            "form"
                            {
                                "method": "post"
                                "action": "/AhdDataStudio/mysql/insert"
                                "class": "row g-3"
                            }
                            insertFields
                        )
                    ]
                )
                HTML.element(
                    "div"
                    {"class": "studio-danger mt-3"}
                    [
                        HTML.element(
                            "h2"
                            {"class": "h6 text-danger mb-1"}
                            [HTML.text("Danger zone")]
                        )
                        HTML.element(
                            "p"
                            {"class": "small text-muted mb-3"}
                            [
                                HTML.text(
                                    "DROP and TRUNCATE require a separate confirmation POST."
                                )
                            ]
                        )
                        HTML.element(
                            "div"
                            {"class": "d-flex flex-wrap gap-2"}
                            [
                                queryFormClass(
                                    "/AhdDataStudio/mysql/confirm"
                                    {
                                        "database": schema
                                        "table": table
                                        "action": "drop"
                                    }
                                    "Drop table…"
                                    "btn btn-sm btn-outline-danger"
                                )
                                queryFormClass(
                                    "/AhdDataStudio/mysql/confirm"
                                    {
                                        "database": schema
                                        "table": table
                                        "action": "truncate"
                                    }
                                    "Truncate table…"
                                    "btn btn-sm btn-outline-danger"
                                )
                            ]
                        )
                    ]
                )
            ]
            return sessions.commit(
                session
                HTTP.html(layout(table, token, body))
            )
        }
        except MySQLError as error {
            return sessions.commit(
                session
                HTTP.html(layout("MySQL", token, errorNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return sessions.commit(
            session
            HTTP.html(layout("MySQL", token, errorNodes(error.message)))
        )
    }
}

mysqlIndexesPage: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    schema: Local String? := request.query("database")
    table: Local String? := request.query("table")
    if schema == null or table == null {
        return sessions.commit(
            session
            HTTP.html(
                layout(
                    "MySQL"
                    token
                    errorNodes("database and table are required")
                )
            )
        )
    }
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            if not (schema in mysqlDatabases(db)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("MySQL", token, errorNodes("unknown database"))
                    )
                )
            }
            if not (table in mysqlTableNames(db, schema)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("MySQL", token, errorNodes("unknown table"))
                    )
                )
            }
            infoRows: Local List<Pair<String, MySQLValue>> := db.query(
                "SELECT INDEX_NAME, NON_UNIQUE, COLUMN_NAME, SEQ_IN_INDEX FROM INFORMATION_SCHEMA.STATISTICS WHERE TABLE_SCHEMA = ? AND TABLE_NAME = ? ORDER BY INDEX_NAME, SEQ_IN_INDEX"
                [MySQL.fromString(schema), MySQL.fromString(table)]
            )
            rows: Local List<List<String>> := []
            for row in infoRows {
                indexName: Local String := ""
                unique: Local String := ""
                column: Local String := ""
                seq: Local String := ""
                if "INDEX_NAME" in row {
                    if row["INDEX_NAME"].kind() == "String" {
                        indexName = row["INDEX_NAME"].string()
                    }
                }
                if "NON_UNIQUE" in row {
                    if row["NON_UNIQUE"].kind() == "Int" {
                        if row["NON_UNIQUE"].int() == 0 {
                            unique = "unique"
                        }
                        else {
                            unique = "non-unique"
                        }
                    }
                }
                if "COLUMN_NAME" in row {
                    if row["COLUMN_NAME"].kind() == "String" {
                        column = row["COLUMN_NAME"].string()
                    }
                }
                if "SEQ_IN_INDEX" in row {
                    if row["SEQ_IN_INDEX"].kind() == "Int" {
                        seq = str(row["SEQ_IN_INDEX"].int())
                    }
                }
                rows.add([indexName, unique, column, seq])
            }
            body: Local List<HTMLNode> := [
                HTML.element(
                    "h1"
                    {"class": "h4"}
                    [HTML.text("Indexes · " + table)]
                )
                mysqlTableNav(schema, table, "indexes")
                htmlTable(["Index", "Uniqueness", "Column", "Sequence"], rows)
            ]
            return sessions.commit(
                session
                HTTP.html(layout("Indexes", token, body))
            )
        }
        except MySQLError as error {
            return sessions.commit(
                session
                HTTP.html(layout("MySQL", token, errorNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return sessions.commit(
            session
            HTTP.html(layout("MySQL", token, errorNodes(error.message)))
        )
    }
}

mysqlBrowsePage: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    pageSize: Global Int
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    schema: Local String? := request.query("database")
    table: Local String? := request.query("table")
    if schema == null or table == null {
        return sessions.commit(
            session
            HTTP.html(
                layout(
                    "MySQL"
                    token
                    errorNodes("database and table are required")
                )
            )
        )
    }
    page: Local Int := parsePage(request.query("page"))
    direction: Local String := sortDirection(request.query("dir"))
    sortCol: Local String? := request.query("sort")
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            if not (schema in mysqlDatabases(db)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("MySQL", token, errorNodes("unknown database"))
                    )
                )
            }
            if not (table in mysqlTableNames(db, schema)) {
                return sessions.commit(
                    session
                    HTTP.html(
                        layout("MySQL", token, errorNodes("unknown table"))
                    )
                )
            }
            columns: Local List<Pair<String, String>> := mysqlColumns(
                db
                schema
                table
            )
            columnNames: Local List<String> := mysqlColumnNames(
                db
                schema
                table
            )
            orderColumn: Local String := columnNames[0]
            if sortCol != null {
                if sortCol in columnNames {
                    orderColumn = sortCol
                }
            }
            offset: Local Int := (page - 1) * pageSize
            qualified: Local String := quoteMysql(
                schema
            ) + "." + quoteMysql(table)
            sql: Local String := "SELECT * FROM " + qualified + " ORDER BY " + quoteMysql(
                orderColumn
            ) + " " + direction + " LIMIT ? OFFSET ?"
            data: Local List<Pair<String, MySQLValue>> := db.query(
                sql
                [MySQL.fromInt(pageSize), MySQL.fromInt(offset)]
            )
            headers: Local List<String> := []
            if len(data) > 0 {
                for key in data[0] {
                    headers.add(key)
                }
            }
            else {
                headers = columnNames
            }
            pkCols: Local List<String> := mysqlPrimaryColumns(columns)
            rows: Local List<List<String>> := []
            actionNodes: Local List<HTMLNode> := []
            rowNumber: Local Int := offset + 1
            for dataRow in data {
                cells: Local List<String> := []
                for header in headers {
                    if header in dataRow {
                        cells.add(formatMysqlValue(dataRow[header]))
                    }
                    else {
                        cells.add("")
                    }
                }
                rows.add(cells)
                if len(pkCols) > 0 {
                    deleteChildren: Local List<HTMLNode> := [
                        csrfField(token)
                        hiddenField("database", schema)
                        hiddenField("table", table)
                    ]
                    updateChildren: Local List<HTMLNode> := [
                        csrfField(token)
                        hiddenField("database", schema)
                        hiddenField("table", table)
                    ]
                    pkSummary: Local String := ""
                    for pk in pkCols {
                        pkValue: Local String := ""
                        if pk in dataRow {
                            pkValue = formatMysqlValue(dataRow[pk])
                        }
                        deleteChildren.add(hiddenField("pk_" + pk, pkValue))
                        updateChildren.add(hiddenField("pk_" + pk, pkValue))
                        if pkSummary != "" {
                            pkSummary = pkSummary + " · "
                        }
                        pkSummary = pkSummary + pk + "=" + pkValue
                    }
                    fieldNodes: Local List<HTMLNode> := []
                    for header in headers {
                        if not (header in pkCols) {
                            current: Local String := ""
                            if header in dataRow {
                                current = formatMysqlValue(dataRow[header])
                            }
                            fieldNodes.add(
                                HTML.element(
                                    "div"
                                    {}
                                    [
                                        HTML.element(
                                            "label"
                                            {"class": "small text-muted mb-1"}
                                            [HTML.text(header)]
                                        )
                                        HTML.element(
                                            "input"
                                            {
                                                "type": "text"
                                                "name": "col_" + header
                                                "value": current
                                                "class": "form-control form-control-sm"
                                            }
                                            []
                                        )
                                    ]
                                )
                            )
                        }
                    }
                    for field in fieldNodes {
                        updateChildren.add(field)
                    }
                    updateChildren.add(
                        HTML.element(
                            "button"
                            {
                                "type": "submit"
                                "class": "btn btn-sm btn-primary mt-2"
                            }
                            [HTML.text("Update row")]
                        )
                    )
                    deleteChildren.add(
                        HTML.element(
                            "button"
                            {
                                "type": "submit"
                                "class": "btn btn-sm btn-outline-danger"
                            }
                            [HTML.text("Delete row")]
                        )
                    )
                    actionNodes.add(
                        HTML.element(
                            "div"
                            {"class": "studio-row-action"}
                            [
                                HTML.element(
                                    "div"
                                    {
                                        "class": "d-flex justify-content-between align-items-start gap-3 mb-2"
                                    }
                                    [
                                        HTML.element(
                                            "div"
                                            {}
                                            [
                                                HTML.element(
                                                    "div"
                                                    {
                                                        "class": "small fw-semibold"
                                                    }
                                                    [
                                                        HTML.text(
                                                            "Row " + str(
                                                                rowNumber
                                                            )
                                                        )
                                                    ]
                                                )
                                                HTML.element(
                                                    "div"
                                                    {
                                                        "class": "small text-muted studio-mono"
                                                    }
                                                    [HTML.text(pkSummary)]
                                                )
                                            ]
                                        )
                                        HTML.element(
                                            "form"
                                            {
                                                "method": "post"
                                                "action": "/AhdDataStudio/mysql/delete"
                                            }
                                            deleteChildren
                                        )
                                    ]
                                )
                                HTML.element(
                                    "form"
                                    {
                                        "method": "post"
                                        "action": "/AhdDataStudio/mysql/update"
                                    }
                                    [
                                        HTML.element(
                                            "div"
                                            {
                                                "class": "studio-row-action-fields"
                                            }
                                            updateChildren
                                        )
                                    ]
                                )
                            ]
                        )
                    )
                }
                rowNumber++
            }
            pager: Local List<HTMLNode> := []
            if page > 1 {
                pager.add(
                    queryFormClass(
                        "/AhdDataStudio/mysql/browse"
                        {
                            "database": schema
                            "table": table
                            "page": str(page - 1)
                            "sort": orderColumn
                            "dir": direction
                        }
                        "← Previous"
                        "btn btn-sm btn-outline-secondary"
                    )
                )
            }
            if len(data) == pageSize {
                pager.add(
                    queryFormClass(
                        "/AhdDataStudio/mysql/browse"
                        {
                            "database": schema
                            "table": table
                            "page": str(page + 1)
                            "sort": orderColumn
                            "dir": direction
                        }
                        "Next →"
                        "btn btn-sm btn-outline-secondary"
                    )
                )
            }
            sortLinks: Local List<HTMLNode> := []
            for name in columnNames {
                ascClass: Local String := "btn btn-sm btn-light border"
                descClass: Local String := "btn btn-sm btn-light border"
                if name == orderColumn and direction == "ASC" {
                    ascClass = "btn btn-sm btn-primary"
                }
                if name == orderColumn and direction == "DESC" {
                    descClass = "btn btn-sm btn-primary"
                }
                sortLinks.add(
                    queryFormClass(
                        "/AhdDataStudio/mysql/browse"
                        {
                            "database": schema
                            "table": table
                            "sort": name
                            "dir": "ASC"
                        }
                        name + " ↑"
                        ascClass
                    )
                )
                sortLinks.add(
                    queryFormClass(
                        "/AhdDataStudio/mysql/browse"
                        {
                            "database": schema
                            "table": table
                            "sort": name
                            "dir": "DESC"
                        }
                        name + " ↓"
                        descClass
                    )
                )
            }
            body: Local List<HTMLNode> := [
                HTML.element(
                    "h1"
                    {"class": "h4 mb-1"}
                    [HTML.text("Browse · " + table)]
                )
                HTML.element(
                    "p"
                    {"class": "small text-muted studio-mono"}
                    [HTML.text(schema + "." + table)]
                )
                mysqlTableNav(schema, table, "browse")
                HTML.element(
                    "div"
                    {
                        "class": "d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2"
                    }
                    [
                        HTML.element(
                            "span"
                            {"class": "small text-muted"}
                            [
                                HTML.text(
                                    "Page " + str(
                                        page
                                    ) + " · up to " + str(pageSize) + " rows"
                                )
                            ]
                        )
                        HTML.element(
                            "span"
                            {"class": "small text-muted"}
                            [
                                HTML.text(
                                    "Sort: " + orderColumn + " " + direction
                                )
                            ]
                        )
                    ]
                )
                HTML.element("div", {"class": "studio-sortbar"}, sortLinks)
            ]
            if len(data) == 0 {
                body.add(
                    emptyState(
                        "No rows on this page"
                        "The table is empty at this offset, or there are no more rows to display."
                    )
                )
            }
            else {
                body.add(htmlTable(headers, rows))
            }
            body.add(
                HTML.element(
                    "div"
                    {"class": "studio-pagination"}
                    [
                        HTML.element(
                            "span"
                            {"class": "small text-muted"}
                            [HTML.text("Page " + str(page))]
                        )
                        HTML.element("div", {"class": "pager-actions"}, pager)
                    ]
                )
            )
            if len(actionNodes) > 0 {
                body.add(
                    HTML.element(
                        "h2"
                        {"class": "h6 mt-4 mb-1"}
                        [HTML.text("Row actions")]
                    )
                )
                body.add(
                    HTML.element(
                        "p"
                        {"class": "small text-muted"}
                        [
                            HTML.text(
                                "Updates and deletes use parameter binding. Identifiers come from discovered metadata."
                            )
                        ]
                    )
                )
                for action in actionNodes {
                    body.add(action)
                }
            }
            return sessions.commit(
                session
                HTTP.html(layout("Browse", token, body))
            )
        }
        except MySQLError as error {
            return sessions.commit(
                session
                HTTP.html(layout("MySQL", token, errorNodes(error.message)))
            )
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return sessions.commit(
            session
            HTTP.html(layout("MySQL", token, errorNodes(error.message)))
        )
    }
}

