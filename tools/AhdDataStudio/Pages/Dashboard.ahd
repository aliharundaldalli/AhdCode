bring Path
bring Env
bring File
from File bring FileError
bring HTML
from HTML bring HTMLNode
bring HTTP
from HTTP bring Request
from HTTP bring Response
from HTTP bring SessionStore
from HTTP bring Session
bring MySQL
from MySQL bring MySQLDatabase
from MySQL bring MySQLError

home: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    mysqlStatus: Local String := t("not_configured")
    mysqlDetail: Local String := ""
    mysqlOk: Local Bool := false
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            names: Local List<String> := mysqlDatabases(db)
            mysqlOk = true
            mysqlStatus = t("connected")
            mysqlDetail = str(len(names)) + " " + t("visible_databases")
        }
        except MySQLError as error {
            mysqlStatus = t("connection_failed")
            mysqlDetail = redact(error.message)
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        mysqlStatus = t("connection_failed")
        mysqlDetail = redact(error.message)
    }
    except DomainError as error {
        mysqlStatus = t("connection_failed")
        mysqlDetail = redact(error.message)
    }

    sqliteFiles: Local List<String> := []
    sqliteStatus: Local String := t("no_project_db")
    attempt {
        sqliteFiles = allowedSqlitePaths()
        sqliteStatus = str(len(sqliteFiles)) + " " + t("db_files")
    }
    except FileError as error {
        sqliteStatus = t("discovery_failed")
        sqliteDetail: Local String := redact(error.message)
        sqliteStatus = sqliteStatus + " — " + sqliteDetail
    }

    host: Local String := Env.getOr("AHD_DATA_MYSQL_HOST", "127.0.0.1")
    port: Local String := Env.getOr("AHD_DATA_MYSQL_PORT", "3306")

    sqliteDetailNodes: Local List<HTMLNode> := [
        HTML.element(
            "p"
            {"class": "mb-2 text-muted"}
            [HTML.text(sqliteStatus)]
        )
    ]
    if len(sqliteFiles) == 0 {
        sqliteDetailNodes.add(
            HTML.element(
                "p"
                {"class": "small text-muted mb-3"}
                [
                    HTML.text(
                        t("sqlite_hint")
                    )
                ]
            )
        )
    }

    for path in sqliteFiles {
        sqliteDetailNodes.add(
            HTML.element("div", {"class": "studio-database-entry"}, [
                HTML.element("div", {}, [
                    HTML.element("strong", {}, [HTML.text(Path.base(path))])
                    HTML.element("span", {"class": "studio-path"}, [HTML.text(path)])
                ])
                sqliteDatabaseAction(path, token, "btn btn-sm btn-outline-primary")
            ])
        )
    }

    body: Local List<HTMLNode> := [
        HTML.element(
            "div"
            {"class": "studio-page-heading"}
            [
                HTML.element(
                    "div"
                    {"class": "eyebrow"}
                    [HTML.text(t("home_eyebrow"))]
                )
                HTML.element(
                    "h1"
                    {"class": "h3 mb-1"}
                    [HTML.text("AhdDataStudio")]
                )
                HTML.element(
                    "p"
                    {"class": "text-muted mb-0"}
                    [
                        HTML.text(
                            t("home_lead")
                        )
                    ]
                )
            ]
        )
        HTML.element(
            "div"
            {"class": "row g-3"}
            [
                HTML.element(
                    "div"
                    {"class": "col-lg-6"}
                    [
                        HTML.element(
                            "div"
                            {"class": "card studio-card h-100"}
                            [
                                HTML.element(
                                    "div"
                                    {"class": "card-body"}
                                    [
                                        HTML.element(
                                            "div"
                                            {
                                                "class": "d-flex justify-content-between align-items-start mb-3"
                                            }
                                            [
                                                HTML.element(
                                                    "div"
                                                    {
                                                        "class": "d-flex gap-3 align-items-center"
                                                    }
                                                    [
                                                        HTML.element(
                                                            "span"
                                                            {
                                                                "class": "studio-provider-icon"
                                                            }
                                                            [HTML.text("M")]
                                                        )
                                                        HTML.element(
                                                            "div"
                                                            {}
                                                            [
                                                                HTML.element(
                                                                    "h2"
                                                                    {
                                                                        "class": "h5 mb-0"
                                                                    }
                                                                    [
                                                                        HTML.text(
                                                                            "MySQL"
                                                                        )
                                                                    ]
                                                                )
                                                                HTML.element(
                                                                    "div"
                                                                    {
                                                                        "class": "small text-muted studio-mono"
                                                                    }
                                                                    [
                                                                        HTML.text(
                                                                            host + ":" + port
                                                                        )
                                                                    ]
                                                                )
                                                            ]
                                                        )
                                                    ]
                                                )
                                                statusBadge(
                                                    mysqlStatus
                                                    mysqlOk
                                                )
                                            ]
                                        )
                                        HTML.element(
                                            "p"
                                            {"class": "text-muted mb-3"}
                                            [HTML.text(mysqlDetail)]
                                        )
                                        HTML.element(
                                            "a"
                                            {
                                                "class": "btn btn-primary btn-sm"
                                                "href": "/AhdDataStudio/mysql"
                                            }
                                            [HTML.text(t("open_mysql"))]
                                        )
                                    ]
                                )
                            ]
                        )
                    ]
                )
                HTML.element(
                    "div"
                    {"class": "col-lg-6"}
                    [
                        HTML.element(
                            "div"
                            {"class": "card studio-card h-100"}
                            [
                                HTML.element(
                                    "div"
                                    {"class": "card-body"}
                                    [
                                        HTML.element(
                                            "div"
                                            {
                                                "class": "d-flex justify-content-between align-items-start mb-3"
                                            }
                                            [
                                                HTML.element(
                                                    "div"
                                                    {
                                                        "class": "d-flex gap-3 align-items-center"
                                                    }
                                                    [
                                                        HTML.element(
                                                            "span"
                                                            {
                                                                "class": "studio-provider-icon sqlite"
                                                            }
                                                            [HTML.text("S")]
                                                        )
                                                        HTML.element(
                                                            "div"
                                                            {}
                                                            [
                                                                HTML.element(
                                                                    "h2"
                                                                    {
                                                                        "class": "h5 mb-0"
                                                                    }
                                                                    [
                                                                        HTML.text(
                                                                            "SQLite"
                                                                        )
                                                                    ]
                                                                )
                                                                HTML.element(
                                                                    "div"
                                                                    {
                                                                        "class": "small text-muted"
                                                                    }
                                                                    [
                                                                        HTML.text(
                                                                            t("project_only")
                                                                        )
                                                                    ]
                                                                )
                                                            ]
                                                        )
                                                    ]
                                                )
                                                HTML.element(
                                                    "span"
                                                    {
                                                        "class": "badge rounded-pill text-bg-secondary studio-status-badge"
                                                    }
                                                    [
                                                        HTML.text(
                                                            str(
                                                                len(sqliteFiles)
                                                            ) + " " + t("found")
                                                        )
                                                    ]
                                                )
                                            ]
                                        )
                                        HTML.element(
                                            "div"
                                            {}
                                            sqliteDetailNodes
                                        )
                                        HTML.element(
                                            "a"
                                            {
                                                "class": "btn btn-primary btn-sm"
                                                "href": "/AhdDataStudio/sqlite"
                                            }
                                            [HTML.text(t("open_sqlite"))]
                                        )
                                    ]
                                )
                            ]
                        )
                    ]
                )
            ]
        )
        HTML.element(
            "div"
            {"class": "studio-panel mt-3"}
            [
                HTML.element(
                    "div"
                    {"class": "small fw-semibold mb-1"}
                    [HTML.text(t("safety_title"))]
                )
                HTML.element(
                    "div"
                    {"class": "small text-muted"}
                    [
                        HTML.text(
                            t("safety_body")
                        )
                    ]
                )
            ]
        )
    ]
    return sessions.commit(session, HTTP.html(layout("Home", token, body)))
}

