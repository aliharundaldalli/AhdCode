// Connect to MySQL through Env, with no default database, then list the
// databases the credentials can see. Never hardcode a real password.
//
//   export MYSQL_HOST=127.0.0.1
//   export MYSQL_USERNAME=app
//   export MYSQL_PASSWORD=change-me
//   export MYSQL_SECURITY=tls
//   ahdcode run 01_mysql_connect.ahd
bring Env
bring MySQL
from MySQL bring MySQLDatabase
from MySQL bring MySQLError

host := Env.getOr("MYSQL_HOST", "127.0.0.1")
username := Env.getOr("MYSQL_USERNAME", "app")
password := Env.getOr("MYSQL_PASSWORD", "")
security := Env.getOr("MYSQL_SECURITY", "tls")

attempt {
    // No default database: this connection can only be used for
    // administrative queries like SHOW DATABASES until one is selected.
    db: Local MySQLDatabase := MySQL.connect(host, username, password, 3306, null, security)
    write("connected")

    rows: Local := db.query("SHOW DATABASES")
    for row in rows {
        write(row["Database"].string())
    }
    db.close()
} except MySQLError as error {
    write("could not connect: " + error.message)
}
