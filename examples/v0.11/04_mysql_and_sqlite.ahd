// MySQL and SQLite in the same AhdCode process: a network cache-miss log
// kept in MySQL, and a local per-run scratch table kept in SQLite. The two
// modules never collide -- MySQLDatabase and SQLite's Database are distinct
// types with no shared API. Never hardcode a real password.
//
//   export MYSQL_HOST=127.0.0.1
//   export MYSQL_USERNAME=app
//   export MYSQL_PASSWORD=change-me
//   export MYSQL_DATABASE=ahdcode_demo
//   ahdcode run 04_mysql_and_sqlite.ahd
bring Env
bring MySQL
from MySQL bring MySQLDatabase
from MySQL bring MySQLError
bring SQLite
from SQLite bring Database

host := Env.getOr("MYSQL_HOST", "127.0.0.1")
username := Env.getOr("MYSQL_USERNAME", "app")
password := Env.getOr("MYSQL_PASSWORD", "")
database := Env.getOr("MYSQL_DATABASE", "ahdcode_demo")
security := Env.getOr("MYSQL_SECURITY", "tls")

attempt {
    mysql: Local MySQLDatabase := MySQL.connect(host, username, password, 3306, database, security)
    mysql.execute("""
        CREATE TABLE IF NOT EXISTS lookups (
            id INT PRIMARY KEY AUTO_INCREMENT,
            term VARCHAR(200) NOT NULL
        )
        """)
    mysql.execute("INSERT INTO lookups (term) VALUES (?)", [MySQL.fromString("hello from mysql")])
    lastRow: Local := mysql.query("SELECT term FROM lookups ORDER BY id DESC LIMIT 1")
    write("mysql: " + lastRow[0]["term"].string())
    mysql.close()

    sqlite: Local Database := SQLite.open(":memory:")
    sqlite.execute("CREATE TABLE scratch (id INTEGER PRIMARY KEY, note TEXT)")
    sqlite.execute("INSERT INTO scratch (note) VALUES (?)", [SQLite.fromString("hello from sqlite")])
    scratchRow: Local := sqlite.query("SELECT note FROM scratch")
    write("sqlite: " + scratchRow[0]["note"].string())
    sqlite.close()
} except MySQLError as error {
    write("MySQL error: " + error.message)
}
