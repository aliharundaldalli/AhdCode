// 69 - UUID values: random v4, time-ordered v7, and strict parsing.
//
// UUID text is always 36 characters in the 8-4-4-4-12 form and is written in
// lowercase. Braces, a urn:uuid: prefix, and the 32-digit form are rejected.
// Compare UUIDValues with equals and compare: `==` keeps the identity
// semantics every built-in class has, and str(id) is <UUIDValue>, so call
// id.string() for the text.
bring UUID
from UUID bring (UUIDValue, UUIDError)

random: UUIDValue := UUID.v4()
write("v4 version: " + str(random.version()))

first: UUIDValue := UUID.v7()
second: UUIDValue := UUID.v7()
third: UUIDValue := UUID.v7()
write("v7 version: " + str(first.version()))
write(
    "v7 values sort in creation order: " + str(
        first.compare(second) < 0 and second.compare(third) < 0
    )
)

parsed: UUIDValue := UUID.parse("017F22E2-79B0-7CC3-98C4-DC0C0C07398F")
write("canonical text: " + parsed.string())
again: UUIDValue := UUID.parse(parsed.string())
write("equals after a round trip: " + str(again.equals(parsed)))
write("== compares identity, not text: " + str(again == parsed))
write("str of a UUIDValue: " + str(parsed))
write("zero: " + UUID.zero().string() + " isZero " + str(UUID.zero().isZero()))

for text in [
    "017f22e2-79b0-7cc3-98c4-dc0c0c07398f"
    r"{017f22e2-79b0-7cc3-98c4-dc0c0c07398f}"
    "urn:uuid:017f22e2-79b0-7cc3-98c4-dc0c0c07398f"
    "017f22e279b07cc398c4dc0c0c07398f"
] {
    write(text + " valid: " + str(UUID.isValid(text)))
}

attempt {
    UUID.parse("017f22e279b07cc398c4dc0c0c07398f")
}
except UUIDError as error {
    write(error.message)
}
