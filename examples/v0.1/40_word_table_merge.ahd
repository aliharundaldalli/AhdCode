bring Word
from Word bring Document

document: Document := Word.new()
document = document.heading("Merged table", 1)
document = document.table(
    ["Region", "Q1", "Q2"]
    [["North", "10", "12"], ["South", "8", "11"]]
    [[0, 0, 1, 3], [1, 0, 2, 1]]
    "center"
)
document.save("word-table-merge.docx")
write("word-table-merge.docx saved")
