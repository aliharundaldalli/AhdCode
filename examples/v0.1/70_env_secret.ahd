// 70 - Env.secret: a secret from NAME, or from the file NAME_FILE points to.
//
// Container platforms mount secrets as files and pass their paths in
// variables such as DB_PASSWORD_FILE. Env.secret("DB_PASSWORD") reads
// DB_PASSWORD, or else the file named by DB_PASSWORD_FILE with one trailing
// line break removed, and returns null when neither is set. Setting both is
// an error, so a stale variable can never silently win. The example never
// prints the secret itself.
bring Env
bring File
bring Path
from Env bring EnvError

directory := "ahdcode-v140-secret"
File.createDir(directory)
secretPath := Path.join([directory, "db_password.txt"])
File.writeText(secretPath, "correct horse battery staple\n")

Env.unset("DB_PASSWORD")
Env.unset("DB_PASSWORD_FILE")
missing: String? := Env.secret("DB_PASSWORD")
write("neither set gives null: " + str(missing == null))

Env.set("DB_PASSWORD_FILE", secretPath)
fromFile: String? := Env.secret("DB_PASSWORD")
if fromFile != null {
    write(
        "read from DB_PASSWORD_FILE: " + str(
            fromFile == "correct horse battery staple"
        )
    )
}

Env.set("DB_PASSWORD", "also-set")
attempt {
    Env.secret("DB_PASSWORD")
}
except EnvError as error {
    write(error.message)
}

Env.unset("DB_PASSWORD_FILE")
direct: String? := Env.secret("DB_PASSWORD")
if direct != null {
    write("read from DB_PASSWORD: " + str(direct == "also-set"))
}
Env.unset("DB_PASSWORD")
