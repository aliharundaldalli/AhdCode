// A 3D surface: z = sin(x) * cos(y) over a 41 x 41 grid. It is saved as a
// PNG, then shown in AhdCode's Plot viewer, where dragging orbits, Shift+drag
// pans, the wheel zooms, R resets, and the toolbar saves the same PNG.
bring Plot
bring Math
bring Numeric
from Plot bring (Surface)

x: List<Real> := []
for step in between(0, 41) {
    x.add(-3.0 + step * 0.15)
}
y: List<Real> := x
rows: List<List<Real>> := []
for yValue in y {
    row: Local List<Real> := []
    for xValue in x {
        row.add(Math.sin(xValue) * Math.cos(yValue))
    }
    rows.add(row)
}

surface: Surface := Plot.surface(x, y, Numeric.matrix(rows))
surface = surface.title("sin(x) · cos(y)").xLabel("x").yLabel("y").zLabel("z")
surface.save("surface.png")
surface.wireframe(true).save("surface-wireframe.png")
write("saved surface.png and surface-wireframe.png")
surface.show()
