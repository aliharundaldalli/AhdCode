// The session store shared by the routes and the /live accept check. It is
// created on first use, after Web.start has loaded .env, so the Secure cookie
// flag follows APP_PROTOCOL.
bring Web
bring Env
from Web bring SessionStore

attendanceSessionStore: SessionStore? := null

attendanceSessions: Function := () -> SessionStore {
    attendanceSessionStore: Global SessionStore?
    current: Local SessionStore? := attendanceSessionStore
    if current != null {
        return current
    }
    created: Local SessionStore := Web.sessions(
        "attendance"
        43200
        Env.getOr("APP_PROTOCOL", "http") == "https"
        "Lax"
    )
    attendanceSessionStore = created
    return created
}
