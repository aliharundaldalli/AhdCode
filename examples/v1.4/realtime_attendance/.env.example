APP_NAME=Realtime Attendance
APP_ENV=development
APP_HOST=localhost
APP_PROTOCOL=http
SERVER_HOST=127.0.0.1
SERVER_PORT=8140

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=attendance
DB_DATABASE=attendance
# "tls" for a remote server; "none" only for a local plaintext one.
DB_SECURITY=none
# Set DB_PASSWORD, or instead DB_PASSWORD_FILE pointing at a secret file.
DB_PASSWORD=change-me

# Shared by app.ahd and jobs.ahd. Use a long random value.
NOTIFY_TOKEN=change-me-to-a-long-random-token
NOTIFY_URL=http://127.0.0.1:8140/internal/notify
