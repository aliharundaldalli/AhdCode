# Local raffle demo. Copy to .env and edit. Do not commit real credentials.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ahdcode_demo
MYSQL_SECURITY=none

# Admin login. The process hashes this with Argon2id and stores only the hash.
RAFFLE_ADMIN_USER=admin
RAFFLE_ADMIN_PASSWORD=change-me-local-only
