adminPage: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    if not isAdmin(session) {
        return adminLoginForm(session, token)
    }
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            raffleInfo: Local Pair<String, String> := raffleStatus(db)
            status: Local String := raffleInfo["status"]
            count: Local Int := entryCount(db)
            completed: Local Int := historyCount(db)
            average: Local String := averageParticipants(db)
            body: Local List<HTMLNode> := [
                HTML.element("h1", {}, [HTML.text("Admin dashboard")])
            ]
            note: Local HTMLNode? := flashNode(session)
            if note != null {
                body.add(note)
            }
            body.add(
                HTML.element(
                    "div"
                    {"class": "stats"}
                    [
                        HTML.element(
                            "div"
                            {"class": "stat"}
                            [
                                HTML.element(
                                    "div"
                                    {"class": "label"}
                                    [HTML.text("Status")]
                                )
                                HTML.element(
                                    "div"
                                    {"class": "value"}
                                    [HTML.text(statusLabel(status))]
                                )
                            ]
                        )
                        HTML.element(
                            "div"
                            {"class": "stat"}
                            [
                                HTML.element(
                                    "div"
                                    {"class": "label"}
                                    [HTML.text("Entries")]
                                )
                                HTML.element(
                                    "div"
                                    {"class": "value"}
                                    [HTML.text(str(count))]
                                )
                            ]
                        )
                        HTML.element(
                            "div"
                            {"class": "stat"}
                            [
                                HTML.element(
                                    "div"
                                    {"class": "label"}
                                    [HTML.text("Completed raffles")]
                                )
                                HTML.element(
                                    "div"
                                    {"class": "value"}
                                    [HTML.text(str(completed))]
                                )
                            ]
                        )
                        HTML.element(
                            "div"
                            {"class": "stat"}
                            [
                                HTML.element(
                                    "div"
                                    {"class": "label"}
                                    [HTML.text("Avg. participants")]
                                )
                                HTML.element(
                                    "div"
                                    {"class": "value"}
                                    [HTML.text(average)]
                                )
                            ]
                        )
                    ]
                )
            )
            if status == "drawn" {
                body.add(
                    banner("ok", "Last winner: " + raffleInfo["winner_name"])
                )
            }
            actions: Local List<HTMLNode> := []
            if status == "idle" {
                actions.add(
                    actionForm("/admin/start", token, "Start raffle", "")
                )
            }
            if status == "open" {
                actions.add(
                    actionForm(
                        "/admin/close"
                        token
                        "Close registration"
                        "secondary"
                    )
                )
            }
            if status == "closed" {
                actions.add(actionForm("/admin/draw", token, "Draw winner", ""))
            }
            if status == "drawn" {
                actions.add(
                    actionForm(
                        "/admin/reset"
                        token
                        "Prepare next raffle"
                        "secondary"
                    )
                )
            }
            actions.add(actionForm("/admin/logout", token, "Log out", "danger"))
            body.add(HTML.element("div", {"class": "card actions"}, actions))
            body.add(
                HTML.element(
                    "p"
                    {"class": "muted"}
                    [
                        HTML.text(
                            "Start opens a new round and clears current entries. Previous winners stay in history. Draw runs in one MySQL transaction."
                        )
                    ]
                )
            )
            return sessions.commit(
                session
                HTTP.html(layout("Admin", body, "admin"))
            )
        }
        except MySQLError as error {
            return dbFail(session)
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return dbFail(session)
    }
}

adminLogin: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    denied: Local Response? := guardPost(request, session)
    if denied != null {
        return denied
    }
    denied = guardCsrf(request, session)
    if denied != null {
        return denied
    }
    username: Local String? := request.form("username")
    password: Local String? := request.form("password")
    if username == null or password == null {
        return failPage(session, "Login failed", 401)
    }
    rotateCsrf(session)
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            rows: Local List<Pair<String, MySQLValue>> := db.query(
                "SELECT username, password_hash FROM raffle_admin WHERE username = ?"
                [MySQL.fromString(username)]
            )
            if len(rows) == 0 {
                return failPage(session, "Login failed", 401)
            }
            hash: Local String := cellString(rows[0], "password_hash")
            if not Security.passwordVerify(password, hash) {
                return failPage(session, "Login failed", 401)
            }
            insertAudit(
                db
                "admin_login"
                "signed in as " + cellString(rows[0], "username")
            )
            session.rotate()
            session.set("admin", "1")
            rotateCsrf(session)
            return sessions.commit(session, HTTP.redirect("/admin"))
        }
        except MySQLError as error {
            return dbFail(session)
        }
        except SecurityError as error {
            return failPage(session, "Login failed", 401)
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return dbFail(session)
    }
}

adminStart: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    denied: Local Response? := guardPost(request, session)
    if denied != null {
        return denied
    }
    denied = guardCsrf(request, session)
    if denied != null {
        return denied
    }
    denied = guardAdmin(session)
    if denied != null {
        return denied
    }
    rotateCsrf(session)
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            tx: Local MySQLTransaction := db.begin()
            openTx: Local Bool := true
            attempt {
                current: Local String := txStatus(tx)
                if current != "idle" {
                    tx.rollback()
                    openTx = false
                    return failPage(session, "Raffle is not idle", 409)
                }
                tx.execute("DELETE FROM raffle_entry")
                updated: Local MySQLResult := tx.execute(
                    "UPDATE raffle SET status = 'open', winner_name = NULL, winner_code = NULL WHERE id = 1"
                )
                insertAuditTx(
                    tx
                    "raffle_start"
                    "opened a new raffle; rows updated " + str(
                        updated.affectedRows()
                    )
                )
                tx.commit()
                openTx = false
                setFlash(session, "Raffle is open. Participants can join.")
                return sessions.commit(session, HTTP.redirect("/admin"))
            }
            except MySQLError as error {
                if openTx {
                    rollbackQuiet(tx)
                }
                return dbFail(session)
            }
        }
        except MySQLError as error {
            return dbFail(session)
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return dbFail(session)
    }
}

adminClose: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    denied: Local Response? := guardPost(request, session)
