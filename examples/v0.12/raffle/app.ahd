// Local MySQL raffle showcase.
//
//   cd examples/v0.12/raffle
//   ahdcode run app.ahd
//   open http://127.0.0.1:8082/
//   ahdcode kill app.run
//
// Binds 127.0.0.1:8082 only. Admin passwords are hashed with Argon2id.
bring Env
bring File
bring HTML
bring HTTP
bring MySQL
bring Security
from Env bring EnvError
from File bring FileError
from HTML bring HTMLNode
from HTML bring HTMLError
from HTTP bring Server
from HTTP bring Request
from HTTP bring Response
from HTTP bring SessionStore
from HTTP bring Session
from HTTP bring HTTPError
from MySQL bring MySQLDatabase
from MySQL bring MySQLTransaction
from MySQL bring MySQLResult
from MySQL bring MySQLValue
from MySQL bring MySQLError
from Security bring SecurityError

sessions: SessionStore := HTTP.sessions("ahd_raffle", 3600, false, "Lax")

loadEnvFile: Function := () -> Nothing {
    if File.exists(".env") {
        Env.load(".env")
    }
}

redact: Function := (message: String) -> String {
    password: Local String := Env.getOr(
        "MYSQL_PASSWORD"
        Env.getOr("AHD_DATA_MYSQL_PASSWORD", "")
    )
    adminPassword: Local String := Env.getOr("RAFFLE_ADMIN_PASSWORD", "")
    out: Local String := message
    if password != "" {
        out = out.replace(password, "[redacted]")
    }
    if adminPassword != "" {
        out = out.replace(adminPassword, "[redacted]")
    }
    return out
}

connectMysql: Function := () -> MySQLDatabase {
    host: Local String := Env.getOr(
        "MYSQL_HOST"
        Env.getOr("AHD_DATA_MYSQL_HOST", "127.0.0.1")
    )
    username: Local String := Env.getOr(
        "MYSQL_USERNAME"
        Env.getOr("AHD_DATA_MYSQL_USER", "root")
    )
    password: Local String := Env.getOr(
        "MYSQL_PASSWORD"
        Env.getOr("AHD_DATA_MYSQL_PASSWORD", "")
    )
    database: Local String := Env.getOr("MYSQL_DATABASE", "ahdcode_demo")
    security: Local String := Env.getOr(
        "MYSQL_SECURITY"
        Env.getOr("AHD_DATA_MYSQL_SECURITY", "none")
    )
    port: Local Int := int(
        Env.getOr("MYSQL_PORT", Env.getOr("AHD_DATA_MYSQL_PORT", "3306"))
    )
    return MySQL.connect(host, username, password, port, database, security)
}

cellString: Function := (row: Pair<String, MySQLValue>, key: String) -> String {
    if not (key in row) {
        return ""
    }
    value: Local MySQLValue := row[key]
    if value.isNull() {
        return ""
    }
    if value.kind() == "String" {
        return value.string()
    }
    return ""
}

cellInt: Function := (row: Pair<String, MySQLValue>, key: String) -> Int {
    if not (key in row) {
        return 0
    }
    value: Local MySQLValue := row[key]
    if value.isNull() {
        return 0
    }
    if value.kind() == "Int" {
        return value.int()
    }
    if value.kind() == "String" {
        return int(value.string())
    }
    return 0
}

displayValue: Function := (value: MySQLValue) -> String {
    if value.isNull() {
        return "—"
    }
    kind: Local String := value.kind()
    if kind == "Int" {
        return str(value.int())
    }
    if kind == "String" {
        return value.string()
    }
    if kind == "Real" {
        return str(value.real())
    }
    return "[" + kind + "]"
}

csrfToken: Function := (session: Session) -> String {
    token: Local String? := session.get("csrf")
    if token == null {
        token = Security.token()
        session.set("csrf", token)
    }
    return token
}

csrfOK: Function := (request: Request, session: Session) -> Bool {
    stored: Local String? := session.get("csrf")
    submitted: Local String? := request.form("csrf")
    if stored == null {
        return false
    }
    if submitted == null {
        return false
    }
    return Security.secureEqual(stored, submitted)
}

rotateCsrf: Function := (session: Session) -> Nothing {
    session.set("csrf", Security.token())
}

hiddenField: Function := (name: String, value: String) -> HTMLNode {
    return HTML.element(
        "input"
        {"type": "hidden", "name": name, "value": value}
        []
    )
}

csrfField: Function := (token: String) -> HTMLNode {
    return hiddenField("csrf", token)
}

isAdmin: Function := (session: Session) -> Bool {
    flag: Local String? := session.get("admin")
    if flag == null {
        return false
    }
    return flag == "1"
}

setFlash: Function := (session: Session, message: String) -> Nothing {
    session.set("flash", message)
}

popFlash: Function := (session: Session) -> String {
    msg: Local String? := session.get("flash")
    if msg == null {
        return ""
    }
    session.set("flash", "")
    return msg
}

maskCode: Function := (code: String) -> String {
    n: Local Int := len(code)
    if n <= 4 {
        return "••••"
    }
    return "••••" + code[(n - 4):n]
}

statusLabel: Function := (status: String) -> String {
    if status == "open" {
        return "Open"
    }
    if status == "closed" {
        return "Closed"
    }
    if status == "drawn" {
        return "Drawn"
    }
    return "Idle"
}

badgeClass: Function := (status: String) -> String {
    if status == "open" {
        return "badge badge-open"
    }
    if status == "closed" {
        return "badge badge-closed"
    }
    if status == "drawn" {
        return "badge badge-drawn"
    }
    return "badge badge-idle"
}

pageCSS: Function := () -> String {
    return r"""
* { box-sizing: border-box; }
body { margin: 0; font-family: system-ui, sans-serif; background: #f3f5f8; color: #152033; }
header { background: #fff; border-bottom: 1px solid #d8dee6; padding: 12px 20px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; }
.brand { font-weight: 700; color: #152033; text-decoration: none; font-size: 18px; }
nav { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
nav a { color: #305d8c; text-decoration: none; }
main { max-width: 880px; margin: 0 auto; padding: 28px 16px 48px; }
.hero { text-align: center; }
.badge { display: inline-block; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
.badge-idle { background: #e8ecf1; color: #5c6573; }
.badge-open { background: #d9f4e3; color: #0f6b38; }
.badge-closed { background: #fff3cd; color: #7a5b00; }
.badge-drawn { background: #dce7f8; color: #1a4d8c; }
.metric { font-size: 40px; font-weight: 700; margin: 8px 0 4px; }
.card { background: #fff; border: 1px solid #d8dee6; border-radius: 12px; padding: 20px; margin: 16px 0; }
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin: 16px 0; }
.stat { background: #fff; border: 1px solid #d8dee6; border-radius: 12px; padding: 16px; }
.stat .label { color: #5c6573; font-size: 13px; }
.stat .value { font-size: 28px; font-weight: 700; word-break: break-word; }
.banner { padding: 10px 12px; border-radius: 8px; margin: 12px 0; }
.err { background: #fde8e4; border: 1px solid #e2a396; }
.ok { background: #e7f6ec; border: 1px solid #b7e0c2; }
.warn { background: #fff3cd; border: 1px solid #e6d08a; }
.code { font-family: ui-monospace, SFMono-Regular, monospace; font-size: 16px; word-break: break-all; background: #eef1f4; padding: 12px; border-radius: 8px; }
.mono { font-family: ui-monospace, SFMono-Regular, monospace; word-break: break-all; }
input, button, textarea { font: inherit; }
input[type=text], input[type=password], textarea { width: 100%; max-width: 420px; padding: 10px 12px; border: 1px solid #c5ced8; border-radius: 8px; }
button { cursor: pointer; background: #305d8c; color: #fff; border: 0; border-radius: 8px; padding: 10px 16px; }
button.secondary { background: #5c6573; }
button.danger { background: #b42318; }
.muted { color: #5c6573; }
table { width: 100%; border-collapse: collapse; background: #fff; }
th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid #e6ebf0; vertical-align: top; word-break: break-word; }
th { font-size: 12px; color: #5c6573; text-transform: uppercase; letter-spacing: 0.04em; }
.actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.actions form { margin: 0; }
label { display: block; font-weight: 600; margin: 0 0 6px; }
.stack { display: grid; gap: 12px; }
@media (max-width: 640px) {
  .metric { font-size: 32px; }
  table { font-size: 14px; }
}
"""
}

layout: Function := (
    title: String
    body: List<HTMLNode>
    navKind: String
) -> String {
    links: Local List<HTMLNode> := [
        HTML.element("a", {"href": "/"}, [HTML.text("Raffle")])
        HTML.element("a", {"href": "/verify"}, [HTML.text("Verify")])
        HTML.element("a", {"href": "/history"}, [HTML.text("History")])
        HTML.element("a", {"href": "/admin"}, [HTML.text("Admin")])
    ]
    if navKind == "admin" {
        links.add(
            HTML.element(
                "a"
                {"href": "/admin/participants"}
                [HTML.text("Participants")]
            )
        )
        links.add(
            HTML.element(
                "a"
                {"href": "/admin/history"}
                [HTML.text("Past draws")]
            )
        )
        links.add(
            HTML.element("a", {"href": "/admin/audit"}, [HTML.text("Audit")])
        )
    }
    nodes: Local List<HTMLNode> := [
        HTML.element("style", {}, [HTML.text(pageCSS())])
        HTML.element(
            "header"
            {}
            [
                HTML.element(
                    "a"
                    {"href": "/", "class": "brand"}
                    [HTML.text("AhdCode Raffle")]
                )
                HTML.element("nav", {}, links)
            ]
        )
        HTML.element("main", {}, body)
    ]
    return HTML.document("Raffle · " + title, nodes)
}

banner: Function := (kind: String, message: String) -> HTMLNode {
    return HTML.element(
        "div"
        {"class": "banner " + kind}
        [HTML.text(message)]
    )
}

failPage: Function := (
    session: Session
    message: String
    status: Int
) -> Response {
    sessions: Global SessionStore
    navKind: Local String := "public"
    if isAdmin(session) {
        navKind = "admin"
    }
    body: Local List<HTMLNode> := [
        HTML.element("h1", {}, [HTML.text("Notice")])
        banner("err", message)
        HTML.element(
            "p"
            {}
            [HTML.element("a", {"href": "/"}, [HTML.text("Back to raffle")])]
        )
    ]
    return sessions.commit(
        session
        HTTP.html(layout("Notice", body, navKind), status)
    )
}

dbFail: Function := (session: Session) -> Response {
    return failPage(session, "Database unavailable", 503)
}

guardPost: Function := (request: Request, session: Session) -> Response? {
    if request.method() != "POST" {
        return failPage(session, "Invalid request", 405)
    }
    return null
}

guardCsrf: Function := (request: Request, session: Session) -> Response? {
    if not csrfOK(request, session) {
        return failPage(session, "Invalid request", 403)
    }
    return null
}

guardAdmin: Function := (session: Session) -> Response? {
    sessions: Global SessionStore
    if isAdmin(session) {
        return null
    }
    return sessions.commit(session, HTTP.redirect("/admin"))
}

emptyState: Function := (message: String) -> HTMLNode {
    return HTML.element("p", {"class": "muted"}, [HTML.text(message)])
}

flashNode: Function := (session: Session) -> HTMLNode? {
    text: Local String := popFlash(session)
    if text == "" {
        return null
    }
    return banner("ok", text)
}

hasColumn: Function := (
    db: MySQLDatabase
    table: String
    column: String
) -> Bool {
    rows: Local List<Pair<String, MySQLValue>> := db.query(
        "SELECT COLUMN_NAME FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = ? AND COLUMN_NAME = ?"
        [MySQL.fromString(table), MySQL.fromString(column)]
    )
    return len(rows) > 0
}

ensureSchema: Function := (db: MySQLDatabase) -> Bool {
    db.execute("""
        CREATE TABLE IF NOT EXISTS raffle_admin (
            id INT PRIMARY KEY AUTO_INCREMENT,
            username VARCHAR(64) NOT NULL UNIQUE,
            password_hash VARCHAR(255) NOT NULL
        )
        """)
    db.execute("""
        CREATE TABLE IF NOT EXISTS raffle (
            id INT PRIMARY KEY,
            status VARCHAR(16) NOT NULL,
            winner_name VARCHAR(128) NULL,
            winner_code VARCHAR(128) NULL
        )
        """)
    db.execute("""
        CREATE TABLE IF NOT EXISTS raffle_entry (
            id INT PRIMARY KEY AUTO_INCREMENT,
            display_name VARCHAR(128) NOT NULL,
            code VARCHAR(128) NOT NULL UNIQUE,
            note VARCHAR(255) NULL,
            created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
        )
        """)
    db.execute("""
        CREATE TABLE IF NOT EXISTS raffle_history (
            id INT PRIMARY KEY AUTO_INCREMENT,
            winner_name VARCHAR(128) NOT NULL,
            winner_code VARCHAR(128) NOT NULL,
            participant_count INT NOT NULL,
            drawn_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
        )
        """)
    db.execute("""
        CREATE TABLE IF NOT EXISTS raffle_audit (
            id INT PRIMARY KEY AUTO_INCREMENT,
            action VARCHAR(64) NOT NULL,
            detail VARCHAR(255) NOT NULL,
            created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
        )
        """)
    if not hasColumn(db, "raffle_entry", "note") {
        db.execute("ALTER TABLE raffle_entry ADD COLUMN note VARCHAR(255) NULL")
    }
    if not hasColumn(db, "raffle_entry", "created_at") {
        db.execute(
            "ALTER TABLE raffle_entry ADD COLUMN created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP"
        )
    }
    raffleRows: Local List<Pair<String, MySQLValue>> := db.query(
        "SELECT id FROM raffle WHERE id = 1"
    )
    if len(raffleRows) == 0 {
        db.execute("INSERT INTO raffle (id, status) VALUES (1, 'idle')")
    }
    adminRows: Local List<Pair<String, MySQLValue>> := db.query(
        "SELECT id FROM raffle_admin"
    )
    if len(adminRows) == 0 {
        secret: Local String? := Env.get("RAFFLE_ADMIN_PASSWORD")
        if secret == null {
            write(
                "Configuration error: RAFFLE_ADMIN_PASSWORD must be set before the first admin account is created."
            )
            return false
        }
        if secret.trim() == "" {
            write(
                "Configuration error: RAFFLE_ADMIN_PASSWORD must be set before the first admin account is created."
            )
            return false
        }
        username: Local String := Env.getOr("RAFFLE_ADMIN_USER", "admin")
        hash: Local String := Security.passwordHash(secret)
        created: Local MySQLResult := db.execute(
            "INSERT INTO raffle_admin (username, password_hash) VALUES (?, ?)"
            [MySQL.fromString(username), MySQL.fromString(hash)]
        )
        newId: Local Int? := created.lastInsertId()
        if newId != null {
            write("Created admin account id " + str(newId))
        }
    }
    return true
}

insertAudit: Function := (
    db: MySQLDatabase
    action: String
    detail: String
) -> MySQLResult {
    return db.execute(
        "INSERT INTO raffle_audit (action, detail) VALUES (?, ?)"
        [MySQL.fromString(action), MySQL.fromString(detail)]
    )
}

insertAuditTx: Function := (
    tx: MySQLTransaction
    action: String
    detail: String
) -> MySQLResult {
    return tx.execute(
        "INSERT INTO raffle_audit (action, detail) VALUES (?, ?)"
        [MySQL.fromString(action), MySQL.fromString(detail)]
    )
}

rollbackQuiet: Function := (tx: MySQLTransaction) -> Nothing {
    attempt {
        tx.rollback()
    }
    except MySQLError as ignored {
        ignored = ignored
    }
}

raffleStatus: Function := (db: MySQLDatabase) -> Pair<String, String> {
    rows: Local List<Pair<String, MySQLValue>> := db.query(
        "SELECT status, winner_name, winner_code FROM raffle WHERE id = 1"
    )
    if len(rows) == 0 {
        return {"status": "idle", "winner_name": "", "winner_code": ""}
    }
    return {
        "status": cellString(rows[0], "status")
        "winner_name": cellString(rows[0], "winner_name")
        "winner_code": cellString(rows[0], "winner_code")
    }
}

entryCount: Function := (db: MySQLDatabase) -> Int {
    rows: Local List<Pair<String, MySQLValue>> := db.query(
        "SELECT COUNT(*) AS n FROM raffle_entry"
    )
    if len(rows) == 0 {
        return 0
    }
    return cellInt(rows[0], "n")
}

historyCount: Function := (db: MySQLDatabase) -> Int {
    rows: Local List<Pair<String, MySQLValue>> := db.query(
        "SELECT COUNT(*) AS n FROM raffle_history"
    )
    if len(rows) == 0 {
        return 0
    }
    return cellInt(rows[0], "n")
}

averageParticipants: Function := (db: MySQLDatabase) -> String {
    rows: Local List<Pair<String, MySQLValue>> := db.query(
        "SELECT AVG(participant_count) AS avg_n FROM raffle_history"
    )
    if len(rows) == 0 {
        return "—"
    }
    value: Local MySQLValue := rows[0]["avg_n"]
    return displayValue(value)
}

txStatus: Function := (tx: MySQLTransaction) -> String {
    rows: Local List<Pair<String, MySQLValue>> := tx.query(
        "SELECT status FROM raffle WHERE id = 1 FOR UPDATE"
    )
    if len(rows) == 0 {
        return ""
    }
    return cellString(rows[0], "status")
}

historyTable: Function := (rows: List<Pair<String, MySQLValue>>) -> HTMLNode {
    if len(rows) == 0 {
        return emptyState("No previous winners yet.")
    }
    bodyRows: Local List<HTMLNode> := []
    for row in rows {
        bodyRows.add(
            HTML.element(
                "tr"
                {}
                [
                    HTML.element(
                        "td"
                        {}
                        [HTML.text(cellString(row, "drawn_at"))]
                    )
                    HTML.element(
                        "td"
                        {}
                        [HTML.text(cellString(row, "winner_name"))]
                    )
                    HTML.element(
                        "td"
                        {"class": "mono"}
                        [HTML.text(cellString(row, "winner_code"))]
                    )
                    HTML.element(
                        "td"
                        {}
                        [HTML.text(str(cellInt(row, "participant_count")))]
                    )
                ]
            )
        )
    }
    return HTML.element(
        "table"
        {}
        [
            HTML.element(
                "thead"
                {}
                [
                    HTML.element(
                        "tr"
                        {}
                        [
                            HTML.element("th", {}, [HTML.text("Date")])
                            HTML.element("th", {}, [HTML.text("Winner")])
                            HTML.element(
                                "th"
                                {}
                                [HTML.text("Participation code")]
                            )
                            HTML.element("th", {}, [HTML.text("Participants")])
                        ]
                    )
                ]
            )
            HTML.element("tbody", {}, bodyRows)
        ]
    )
}

actionForm: Function := (
    action: String
    token: String
    label: String
    kind: String
) -> HTMLNode {
    cls: Local Pair<String, String> := {"type": "submit"}
    if kind != "" {
        cls = {"type": "submit", "class": kind}
    }
    return HTML.element(
        "form"
        {"method": "post", "action": action}
        [csrfField(token), HTML.element("button", cls, [HTML.text(label)])]
    )
}

home: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    token: Local String := csrfToken(session)
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            raffleInfo: Local Pair<String, String> := raffleStatus(db)
            status: Local String := raffleInfo["status"]
            count: Local Int := entryCount(db)
            body: Local List<HTMLNode> := []
            note: Local HTMLNode? := flashNode(session)
            if note != null {
                body.add(note)
            }
            body.add(
                HTML.element(
                    "section"
                    {"class": "hero card"}
                    [
                        HTML.element(
                            "p"
                            {"class": "muted"}
                            [HTML.text("Current raffle")]
                        )
                        HTML.element(
                            "p"
                            {}
                            [
                                HTML.element(
                                    "span"
                                    {"class": badgeClass(status)}
                                    [HTML.text(statusLabel(status))]
                                )
                            ]
                        )
                        HTML.element(
                            "div"
                            {"class": "metric"}
                            [HTML.text(str(count))]
                        )
                        HTML.element(
                            "p"
                            {"class": "muted"}
                            [HTML.text("participants")]
                        )
                    ]
                )
            )
            if status == "idle" {
                body.add(
                    HTML.element(
                        "p"
                        {"class": "muted"}
                        [
                            HTML.text(
                                "No active raffle. An administrator will start the next round."
                            )
                        ]
                    )
                )
            }
            if status == "open" {
                body.add(
                    HTML.element(
                        "form"
                        {
                            "method": "post"
                            "action": "/join"
                            "class": "card stack"
                        }
                        [
                            HTML.element(
                                "h2"
                                {}
                                [HTML.text("Join this raffle")]
                            )
                            csrfField(token)
                            HTML.element("label", {}, [HTML.text("Your name")])
                            HTML.element(
                                "input"
                                {
                                    "type": "text"
                                    "name": "name"
                                    "placeholder": "Ada"
                                    "maxlength": "128"
                                }
                                []
                            )
                            HTML.element(
                                "label"
                                {}
                                [HTML.text("Optional note")]
                            )
                            HTML.element(
                                "input"
                                {
                                    "type": "text"
                                    "name": "note"
                                    "placeholder": "Optional"
                                    "maxlength": "255"
                                }
                                []
                            )
                            HTML.element(
                                "button"
                                {"type": "submit"}
                                [HTML.text("Join raffle")]
                            )
                        ]
                    )
                )
            }
            if status == "closed" {
                body.add(
                    banner(
                        "warn"
                        "Registration has ended. Winner selection is pending."
                    )
                )
            }
            if status == "drawn" {
                body.add(
                    HTML.element(
                        "div"
                        {"class": "card"}
                        [
                            HTML.element("h2", {}, [HTML.text("Winner")])
                            HTML.element(
                                "p"
                                {}
                                [
                                    HTML.element(
                                        "strong"
                                        {}
                                        [HTML.text(raffleInfo["winner_name"])]
                                    )
                                ]
                            )
                            HTML.element(
                                "p"
                                {"class": "muted"}
                                [HTML.text("Winning participation code")]
                            )
                            HTML.element(
                                "div"
                                {"class": "code"}
                                [HTML.text(raffleInfo["winner_code"])]
                            )
                            HTML.element(
                                "p"
                                {"class": "muted"}
                                [
                                    HTML.text(
                                        "Drawn from " + str(
                                            count
                                        ) + " participants."
                                    )
                                ]
                            )
                        ]
                    )
                )
            }
            return sessions.commit(
                session
                HTTP.html(layout("Home", body, "public"))
            )
        }
        except MySQLError as error {
            return dbFail(session)
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return dbFail(session)
    }
    except DomainError as error {
        return failPage(session, redact(error.message), 400)
    }
}

joinRaffle: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    denied: Local Response? := guardPost(request, session)
    if denied != null {
        return denied
    }
    denied = guardCsrf(request, session)
    if denied != null {
        return denied
    }
    rawName: Local String? := request.form("name")
    if rawName == null {
        return failPage(session, "A name is required", 400)
    }
    name: Local String := rawName.trim()
    if name == "" {
        return failPage(session, "A name is required", 400)
    }
    if len(name) > 128 {
        return failPage(session, "Names are limited to 128 characters", 400)
    }
    note: Local String := ""
    rawNote: Local String? := request.form("note")
    if rawNote != null {
        note = rawNote.trim()
    }
    if len(note) > 255 {
        return failPage(session, "Notes are limited to 255 characters", 400)
    }
    rotateCsrf(session)
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            raffleInfo: Local Pair<String, String> := raffleStatus(db)
            status: Local String := raffleInfo["status"]
            if status == "closed" {
                return failPage(session, "Registration is already closed", 409)
            }
            if status != "open" {
                return failPage(session, "Raffle is not open", 409)
            }
            code: Local String := Security.token()
            created: Local MySQLResult := db.execute(
                "INSERT INTO raffle_entry (display_name, code, note) VALUES (?, ?, ?)"
                [
                    MySQL.fromString(name)
                    MySQL.fromString(code)
                    MySQL.fromString(note)
                ]
            )
            newId: Local Int? := created.lastInsertId()
            session.set("ticket_name", name)
            session.set("ticket_code", code)
            session.set("ticket_note", note)
            if newId != null {
                session.set("ticket_id", str(newId))
            }
            return sessions.commit(session, HTTP.redirect("/ticket"))
        }
        except MySQLError as error {
            return dbFail(session)
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return dbFail(session)
    }
}

ticketPage: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    storedName: Local String? := session.get("ticket_name")
    storedCode: Local String? := session.get("ticket_code")
    if storedName == null or storedCode == null {
        return sessions.commit(session, HTTP.redirect("/"))
    }
    name: Local String := storedName
    code: Local String := storedCode
    note: Local String := ""
    storedNote: Local String? := session.get("ticket_note")
    if storedNote != null {
        note = storedNote
    }
    body: Local List<HTMLNode> := [
        HTML.element("h1", {}, [HTML.text("You joined the raffle")])
        HTML.element(
            "p"
            {}
            [HTML.text("This is your participation receipt. Keep the code.")]
        )
        HTML.element("div", {"class": "card stack"}, [])
    ]
    card: Local List<HTMLNode> := [
        HTML.element("p", {"class": "muted"}, [HTML.text("Name")])
        HTML.element("p", {}, [HTML.element("strong", {}, [HTML.text(name)])])
    ]
    storedId: Local String? := session.get("ticket_id")
    if storedId != null {
        card.add(HTML.element("p", {"class": "muted"}, [HTML.text("Entry ID")]))
        card.add(HTML.element("p", {"class": "mono"}, [HTML.text(storedId)]))
    }
    if note != "" {
        card.add(HTML.element("p", {"class": "muted"}, [HTML.text("Note")]))
        card.add(HTML.element("p", {}, [HTML.text(note)]))
    }
    card.add(
        HTML.element("p", {"class": "muted"}, [HTML.text("Participation code")])
    )
    card.add(HTML.element("div", {"class": "code"}, [HTML.text(code)]))
    body = [
        HTML.element("h1", {}, [HTML.text("You joined the raffle")])
        HTML.element(
            "p"
            {}
            [HTML.text("This is your participation receipt. Keep the code.")]
        )
        HTML.element("div", {"class": "card stack"}, card)
        HTML.element(
            "p"
            {}
            [
                HTML.element(
                    "a"
                    {"href": "/verify"}
                    [HTML.text("Verify a ticket")]
                )
            ]
        )
        HTML.element(
            "p"
            {}
            [HTML.element("a", {"href": "/"}, [HTML.text("Back to raffle")])]
        )
    ]
    return sessions.commit(session, HTTP.html(layout("Ticket", body, "public")))
}

