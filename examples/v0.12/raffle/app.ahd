verifyTicket: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    denied: Local Response? := guardPost(request, session)
    if denied != null {
        return denied
    }
    denied = guardCsrf(request, session)
    if denied != null {
        return denied
    }
    rawCode: Local String? := request.form("code")
    if rawCode == null {
        return failPage(session, "A participation code is required", 400)
    }
    submitted: Local String := rawCode.trim()
    if submitted == "" {
        return failPage(session, "A participation code is required", 400)
    }
    rotateCsrf(session)
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            rows: Local List<Pair<String, MySQLValue>> := db.query(
                "SELECT display_name, code FROM raffle_entry WHERE code = ?"
                [MySQL.fromString(submitted)]
            )
            body: Local List<HTMLNode> := [
                HTML.element("h1", {}, [HTML.text("Verify ticket")])
            ]
            if len(rows) == 0 {
                body.add(banner("err", "Participation code not found"))
            }
            else {
                stored: Local String := cellString(rows[0], "code")
                if not Security.secureEqual(stored, submitted) {
                    body.add(banner("err", "Participation code not found"))
                }
                else {
                    body.add(banner("ok", "Valid participation code"))
                    body.add(
                        HTML.element(
                            "div"
                            {"class": "card"}
                            [
                                HTML.element(
                                    "p"
                                    {}
                                    [HTML.text("Participant: ")]
                                )
                                HTML.element(
                                    "p"
                                    {}
                                    [
                                        HTML.element(
                                            "strong"
                                            {}
                                            [
                                                HTML.text(
                                                    cellString(
                                                        rows[0]
                                                        "display_name"
                                                    )
                                                )
                                            ]
                                        )
                                    ]
                                )
                                HTML.element(
                                    "p"
                                    {"class": "muted"}
                                    [HTML.text("Status: Registered")]
                                )
                            ]
                        )
                    )
                }
            }
            body.add(
                HTML.element(
                    "p"
                    {}
                    [
                        HTML.element(
                            "a"
                            {"href": "/verify"}
                            [HTML.text("Verify another")]
                        )
                    ]
                )
            )
            return sessions.commit(
                session
                HTTP.html(layout("Verify", body, "public"))
            )
        }
        except MySQLError as error {
            return dbFail(session)
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return dbFail(session)
    }
}

