adminDraw: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    denied: Local Response? := guardPost(request, session)
    if denied != null {
        return denied
    }
    denied = guardCsrf(request, session)
    if denied != null {
        return denied
    }
    denied = guardAdmin(session)
    if denied != null {
        return denied
    }
    rotateCsrf(session)
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            tx: Local MySQLTransaction := db.begin()
            openTx: Local Bool := true
            attempt {
                current: Local String := txStatus(tx)
                if current == "open" {
                    tx.rollback()
                    openTx = false
                    return failPage(
                        session
                        "Close registration before drawing a winner"
                        409
                    )
                }
                if current != "closed" {
                    tx.rollback()
                    openTx = false
                    return failPage(session, "Raffle is not closed", 409)
                }
                winnerRows: Local List<Pair<String, MySQLValue>> := tx.query(
                    "SELECT display_name, code FROM raffle_entry ORDER BY RAND() LIMIT 1"
                )
                if len(winnerRows) == 0 {
                    tx.rollback()
                    openTx = false
                    return failPage(session, "No participants", 409)
                }
                winnerName: Local String := cellString(
                    winnerRows[0]
                    "display_name"
                )
                winnerCode: Local String := cellString(winnerRows[0], "code")
                countRows: Local List<Pair<String, MySQLValue>> := tx.query(
                    "SELECT COUNT(*) AS n FROM raffle_entry"
                )
                count: Local Int := 0
                if len(countRows) > 0 {
                    count = cellInt(countRows[0], "n")
                }
                tx.execute(
                    "UPDATE raffle SET status = 'drawn', winner_name = ?, winner_code = ? WHERE id = 1"
                    [MySQL.fromString(winnerName), MySQL.fromString(winnerCode)]
                )
                history: Local MySQLResult := tx.execute(
                    "INSERT INTO raffle_history (winner_name, winner_code, participant_count) VALUES (?, ?, ?)"
                    [
                        MySQL.fromString(winnerName)
                        MySQL.fromString(winnerCode)
                        MySQL.fromInt(count)
                    ]
                )
                historyId: Local String := "none"
                newId: Local Int? := history.lastInsertId()
                if newId != null {
                    historyId = str(newId)
                }
                insertAuditTx(
                    tx
                    "raffle_draw"
                    "history_id=" + historyId + " participants=" + str(count)
                )
                tx.commit()
                openTx = false
                setFlash(session, "Winner announced.")
                return sessions.commit(session, HTTP.redirect("/"))
            }
            except MySQLError as error {
                if openTx {
                    rollbackQuiet(tx)
                }
                return dbFail(session)
            }
        }
        except MySQLError as error {
            return dbFail(session)
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return dbFail(session)
    }
}

adminReset: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    denied: Local Response? := guardPost(request, session)
    if denied != null {
        return denied
    }
    denied = guardCsrf(request, session)
    if denied != null {
        return denied
    }
    denied = guardAdmin(session)
    if denied != null {
        return denied
    }
    rotateCsrf(session)
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            tx: Local MySQLTransaction := db.begin()
            openTx: Local Bool := true
            attempt {
                current: Local String := txStatus(tx)
                if current != "drawn" {
                    tx.rollback()
                    openTx = false
                    return failPage(
                        session
                        "Prepare next raffle only after a draw"
                        409
                    )
                }
                tx.execute("DELETE FROM raffle_entry")
                tx.execute(
                    "UPDATE raffle SET status = 'idle', winner_name = NULL, winner_code = NULL WHERE id = 1"
                )
                insertAuditTx(
                    tx
                    "raffle_reset"
                    "prepared next raffle; history preserved"
                )
                tx.commit()
                openTx = false
                setFlash(
                    session
                    "Ready for the next raffle. Previous winners were kept."
                )
                return sessions.commit(session, HTTP.redirect("/admin"))
            }
            except MySQLError as error {
                if openTx {
                    rollbackQuiet(tx)
                }
                return dbFail(session)
            }
        }
        except MySQLError as error {
            return dbFail(session)
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return dbFail(session)
    }
}

adminLogout: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    denied: Local Response? := guardPost(request, session)
    if denied != null {
        return denied
    }
    denied = guardCsrf(request, session)
    if denied != null {
        return denied
    }
    if isAdmin(session) {
        attempt {
            db: Local MySQLDatabase := connectMysql()
            attempt {
                insertAudit(db, "admin_logout", "signed out")
            }
            except MySQLError as error {}
            ultimately {
                db.close()
            }
        }
        except MySQLError as error {}
    }
    session.destroy()
    return sessions.commit(session, HTTP.redirect("/admin"))
}

adminParticipants: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    denied: Local Response? := guardAdmin(session)
    if denied != null {
        return denied
    }
    token: Local String := csrfToken(session)
    search: Local String := ""
    raw: Local String? := request.query("q")
    if raw != null {
        search = raw.trim()
    }
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            rows: Local List<Pair<String, MySQLValue>> := []
            if search == "" {
                rows = db.query(
                    "SELECT id, display_name, code, created_at FROM raffle_entry ORDER BY id DESC LIMIT 100"
                )
            }
            else {
                rows = db.query(
                    "SELECT id, display_name, code, created_at FROM raffle_entry WHERE display_name LIKE ? ORDER BY id DESC LIMIT 100"
                    [MySQL.fromString("%" + search + "%")]
                )
            }
            body: Local List<HTMLNode> := [
                HTML.element("h1", {}, [HTML.text("Participants")])
            ]
            note: Local HTMLNode? := flashNode(session)
            if note != null {
                body.add(note)
            }
            body.add(
                HTML.element(
                    "form"
                    {
                        "method": "get"
                        "action": "/admin/participants"
                        "class": "card stack"
                    }
                    [
                        HTML.element("label", {}, [HTML.text("Search by name")])
                        HTML.element(
                            "input"
                            {
                                "type": "text"
                                "name": "q"
                                "value": search
                                "placeholder": "Name"
                            }
                            []
                        )
                        HTML.element(
                            "button"
                            {"type": "submit"}
                            [HTML.text("Search")]
                        )
                    ]
                )
            )
            if len(rows) == 0 {
                body.add(
                    HTML.element(
                        "div"
                        {"class": "card"}
                        [emptyState("No participants.")]
                    )
                )
            }
            else {
                tableRows: Local List<HTMLNode> := []
                for row in rows {
                    idText: Local String := str(cellInt(row, "id"))
                    tableRows.add(
                        HTML.element(
                            "tr"
                            {}
                            [
                                HTML.element(
                                    "td"
                                    {"class": "mono"}
                                    [HTML.text(idText)]
                                )
                                HTML.element(
                                    "td"
                                    {}
                                    [HTML.text(cellString(row, "display_name"))]
                                )
                                HTML.element(
                                    "td"
                                    {}
                                    [HTML.text(cellString(row, "created_at"))]
                                )
                                HTML.element(
                                    "td"
                                    {"class": "mono"}
                                    [
                                        HTML.text(
                                            maskCode(cellString(row, "code"))
                                        )
                                    ]
                                )
                                HTML.element(
                                    "td"
                                    {}
                                    [
                                        HTML.element(
                                            "form"
                                            {
                                                "method": "post"
                                                "action": "/admin/participant/delete"
                                            }
                                            [
                                                csrfField(token)
                                                hiddenField("id", idText)
                                                HTML.element(
                                                    "button"
                                                    {
                                                        "type": "submit"
                                                        "class": "danger"
                                                    }
                                                    [HTML.text("Remove")]
                                                )
                                            ]
                                        )
                                    ]
                                )
                            ]
                        )
                    )
                }
                body.add(
                    HTML.element(
                        "div"
                        {"class": "card"}
                        [
                            HTML.element(
                                "table"
                                {}
                                [
                                    HTML.element(
                                        "thead"
                                        {}
                                        [
                                            HTML.element(
                                                "tr"
                                                {}
                                                [
                                                    HTML.element(
                                                        "th"
                                                        {}
                                                        [HTML.text("ID")]
                                                    )
                                                    HTML.element(
                                                        "th"
                                                        {}
                                                        [HTML.text("Name")]
                                                    )
                                                    HTML.element(
                                                        "th"
                                                        {}
                                                        [HTML.text("Joined at")]
                                                    )
                                                    HTML.element(
                                                        "th"
                                                        {}
                                                        [HTML.text("Ticket")]
                                                    )
                                                    HTML.element(
                                                        "th"
                                                        {}
                                                        [HTML.text("Action")]
                                                    )
                                                ]
                                            )
                                        ]
                                    )
                                    HTML.element("tbody", {}, tableRows)
                                ]
                            )
                        ]
                    )
                )
            }
            return sessions.commit(
                session
                HTTP.html(layout("Participants", body, "admin"))
            )
        }
        except MySQLError as error {
            return dbFail(session)
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return dbFail(session)
    }
}

adminDeleteParticipant: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    denied: Local Response? := guardPost(request, session)
    if denied != null {
        return denied
    }
    denied = guardCsrf(request, session)
    if denied != null {
        return denied
    }
    denied = guardAdmin(session)
    if denied != null {
        return denied
    }
    rawId: Local String? := request.form("id")
    if rawId == null {
        return failPage(session, "Invalid request", 400)
    }
    idVal: Local Int := 0
    attempt {
        idVal = int(rawId.trim())
    }
    except DomainError as error {
        return failPage(session, "Invalid request", 400)
    }
    if idVal <= 0 {
        return failPage(session, "Invalid request", 400)
    }
    rotateCsrf(session)
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            tx: Local MySQLTransaction := db.begin()
            openTx: Local Bool := true
            attempt {
                current: Local String := txStatus(tx)
                if current != "open" and current != "closed" {
                    tx.rollback()
                    openTx = false
                    return failPage(
                        session
                        "Participants can be removed only before a draw"
                        409
                    )
                }
                deleted: Local MySQLResult := tx.execute(
                    "DELETE FROM raffle_entry WHERE id = ?"
                    [MySQL.fromInt(idVal)]
                )
                changed: Local Int := deleted.affectedRows()
                if changed == 0 {
                    tx.rollback()
                    openTx = false
                    return failPage(session, "No participants", 404)
                }
                insertAuditTx(
                    tx
                    "participant_delete"
                    "removed entry id " + str(
                        idVal
                    ) + "; affected " + str(changed)
                )
                tx.commit()
                openTx = false
                setFlash(
                    session
                    "Removed " + str(changed) + " participant(s)."
                )
                return sessions.commit(
                    session
                    HTTP.redirect("/admin/participants")
                )
            }
            except MySQLError as error {
                if openTx {
                    rollbackQuiet(tx)
                }
                return dbFail(session)
            }
        }
        except MySQLError as error {
            return dbFail(session)
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return dbFail(session)
    }
}

adminHistory: Function := (request: Request) -> Response {
    sessions: Global SessionStore
    session: Local Session := sessions.open(request)
    denied: Local Response? := guardAdmin(session)
    if denied != null {
        return denied
    }
    attempt {
        db: Local MySQLDatabase := connectMysql()
        attempt {
            rows: Local List<Pair<String, MySQLValue>> := db.query(
                "SELECT drawn_at, winner_name, winner_code, participant_count FROM raffle_history ORDER BY id DESC LIMIT 50"
            )
            body: Local List<HTMLNode> := [
                HTML.element("h1", {}, [HTML.text("Draw history")])
                HTML.element(
                    "p"
                    {"class": "muted"}
                    [HTML.text("Latest 50 completed raffles.")]
                )
                HTML.element("div", {"class": "card"}, [historyTable(rows)])
            ]
            return sessions.commit(
                session
                HTTP.html(layout("Draw history", body, "admin"))
            )
        }
        except MySQLError as error {
            return dbFail(session)
        }
        ultimately {
            db.close()
        }
    }
    except MySQLError as error {
        return dbFail(session)
    }
}

