    }
    xLabelText: Local String := "Not Aralığı"
    if activeLang != "TR" {
        xLabelText = "Grade Range"
    }
    yLabelText: Local String := "Frekans"
    if activeLang != "TR" {
        yLabelText = "Count"
    }

    chart: Local Chart := Plot.histogram(allGrades, 5).title(hTitle).xLabel(xLabelText).yLabel(yLabelText)
    chart.show()
}

