// Password hashing with Argon2id.
//
// Security.passwordHash returns a PHC-encoded string that stores the algorithm,
// parameters, salt, and derived key together. Store this string; never store
// the plaintext password.
//
//   ahdcode run 01_password_hash.ahd
bring Security
from Security bring SecurityError

password: String := "fake_qa_password_example"

hash: String := Security.passwordHash(password)
write("hash: " + hash)

ok: Bool := Security.passwordVerify(password, hash)
write("verify correct:  {ok}")

wrong: Bool := Security.passwordVerify("wrong_password", hash)
write("verify wrong:    {wrong}")

attempt {
    Security.passwordVerify("any", "not-a-valid-phc-string")
} except SecurityError as error {
    write("malformed hash caught: " + error.message)
}
