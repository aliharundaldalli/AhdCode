# Copy this file to .env for local development.
#
# .env is a local development convenience and must never be committed: keep
# real values out of version control and out of the built executable.
# A variable already present in the process environment always wins over this
# file, so a container or CI deployment overrides it without editing anything.

APP_NAME=Ahd Akademi
APP_ENV=development
APP_HOST=ahdakademi.com
APP_PROTOCOL=http

# The socket this process binds. It is not the public address: behind
# Cloudflare, Caddy, or nginx the public URL above and this pair differ.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Optional, application-specific. Read only in Config/App.ahd.
APP_TAGLINE=AhdCode ile yazılmış küçük bir akademi
