// Sign in.
//
// A failed attempt always reports the same thing, whether the address is
// unknown, the password is wrong, or the account is deactivated. Saying which
// would turn the login form into an account-existence oracle.
require("Layouts/Auth.ahd")
require("Components/FormField.ahd")
require("Services/Context.ahd")
require("Services/Session.ahd")
require("Services/Auth.ahd")
require("Services/CSRF.ahd")
require("Support/Validation.ahd")
bring Web
from Web bring (Request, Response, HTMLNode, Session, RequestContext, Form)

loginPage: Function := (request: Request) -> Response {
    web: Local RequestContext := Web.context(request, sessionStore())
    session: Local Session := web.session
    context: Local PageContext := contextFor(session)
    return web.respond(loginView(session, context, "", ""))
}

loginView: Function := (
    session: Session
    context: PageContext
    email: String
    error: String
) -> Response {
    fields: Local List<HTMLNode> := []
    if error != "" {
        fields.add(alertBox("error", error))
    }

    fields.add(
        Web.UI.formTo(
            "/login"
            "post"
            [
                csrfInput(session)
                formFieldWithIcon(
                    "login-email"
                    "email"
                    "E-posta"
                    "email"
                    "fa-solid fa-envelope"
                    email
                    ""
                    "ornek@eposta.com"
                )
                formPasswordFieldWithIcon(
                    "login-password"
                    "password"
                    "Parola"
                    "fa-solid fa-lock"
                    ""
                    ""
                    "••••••••"
                )
                Web.UI.buttonNodes(
                    [
                        Web.UI.i(
                            ""
                            {"class": "fa-solid fa-right-to-bracket me-2"}
                        )
                        Web.UI.text("Giriş yap")
                    ]
                    {"type": "submit", "class": "btn btn-primary w-100 py-2"}
                )
            ]
        )
    )
    fields.add(
        Web.UI.div(
            [
                Web.UI.div(
                    [
                        Web.UI.span(
                            "Hesabınız yok mu? "
                            {"class": "text-body-secondary"}
                        )
                        Web.UI.aNodes(
                            "/register"
                            [
                                Web.UI.i(
                                    ""
                                    {"class": "fa-solid fa-user-plus me-1"}
                                )
                                Web.UI.text("Kayıt olun")
                            ]
                            {"class": "fw-semibold text-decoration-none"}
                        )
                    ]
                    {"class": "mb-2"}
                )
                Web.UI.div(
                    [
                        Web.UI.aNodes(
                            "/forgot-password"
                            [
                                Web.UI.i("", {"class": "fa-solid fa-key me-1"})
                                Web.UI.text("Parolamı unuttum")
                            ]
                            {
                                "class": "text-body-secondary text-decoration-none small"
                            }
                        )
                    ]
                )
            ]
            {"class": "mt-4 pt-3 border-top text-center small"}
        )
    )

    return authLayout(
        "Giriş"
        context.siteName
        context.headerColor
        context.flash
        context.flashKind
        fields
    )
}

loginSubmit: Function := (request: Request) -> Response {
    web: Local RequestContext := Web.context(request, sessionStore())
    session: Local Session := web.session
    context: Local PageContext := contextFor(session)
    form: Local Form := web.form()
    if web.csrfValid() == false {
        return web.respond(Web.text("Geçersiz form belirteci.", 403))
    }

    email: Local String := form.value("email").trim().lower()
    password: Local String := form.value("password")
    user: Local UserRecord? := authAttempt(email, password)
    if user == null {
        return web.respond(
            loginView(session, context, email, "E-posta veya parola hatalı.")
        )
    }

    authLogin(session, user)
    portalFlash(web, "success", "Hoş geldiniz, {user.name}.")
    return web.respond(Web.redirect("/"))
}

logoutSubmit: Function := (request: Request) -> Response {
    web: Local RequestContext := Web.context(request, sessionStore())
    session: Local Session := web.session
    if web.csrfValid() == false {
        return web.respond(Web.text("Geçersiz form belirteci.", 403))
    }

    authLogout(session)
    return web.respond(Web.redirect("/"))
}
