// Choose a new password with a reset link.
require("Layouts/Auth.ahd")
require("Components/FormField.ahd")
require("Services/Context.ahd")
require("Services/Session.ahd")
require("Services/CSRF.ahd")
require("Services/PasswordReset.ahd")
require("Support/Validation.ahd")
bring Web
from Web bring (Request, Response, HTMLNode, Session)

resetPasswordPage: Function := (request: Request) -> Response {
    session: Local Session := sessionOpen(request)
    context: Local PageContext := contextFor(session)
    selector: Local String := validationField(request.query("selector"))
    token: Local String := validationField(request.query("token"))

    if resetVerify(selector, token) == null {
        return sessionCommit(session, resetPasswordInvalid(context))
    }

    return sessionCommit(
        session
        resetPasswordView(session, context, selector, token, [])
    )
}

resetPasswordInvalid: Function := (context: PageContext) -> Response {
    return authLayout(
        "Bağlantı geçersiz"
        context.siteName
        context.headerColor
        context.flash
        context.flashKind
        [
            alertBox(
                "error"
                "Bu sıfırlama bağlantısı geçersiz, süresi dolmuş veya kullanılmış."
            )
            Web.UI.pNodes(
                [Web.UI.a("/forgot-password", "Yeni bağlantı isteyin")]
                {"class": "mb-0"}
            )
        ]
    )
}

resetPasswordView: Function := (
    session: Session
    context: PageContext
    selector: String
    token: String
    errors: List<String>
) -> Response {
    fields: Local List<HTMLNode> := []
    if len(errors) > 0 {
        fields.add(errorList(errors))
    }

    fields.add(
        Web.UI.formTo(
            "/reset-password"
            "post"
            [
                csrfInput(session)
                Web.UI.input("hidden", "selector", selector)
                Web.UI.input("hidden", "token", token)
                formField(
                    "reset-password"
                    "password"
                    "Yeni parola"
                    "password"
                    ""
                    "En az {str(validationMinimumPassword())} karakter."
                )
                formField(
                    "reset-confirm"
                    "password_confirmation"
                    "Yeni parola (tekrar)"
                    "password"
                )
                Web.UI.button(
                    "Parolayı değiştir"
                    {"type": "submit", "class": "btn btn-primary w-100"}
                )
            ]
        )
    )

    return authLayout(
        "Yeni parola"
        context.siteName
        context.headerColor
        context.flash
        context.flashKind
        fields
    )
}

resetPasswordSubmit: Function := (request: Request) -> Response {
    session: Local Session := sessionOpen(request)
    context: Local PageContext := contextFor(session)
    if csrfValid(session, request) == false {
        return sessionCommit(session, Web.text("Geçersiz form belirteci.", 403))
    }

    selector: Local String := validationField(request.form("selector"))
    token: Local String := validationField(request.form("token"))
    password: Local String := validationField(request.form("password"))
    confirmation: Local String := validationField(
        request.form("password_confirmation")
    )

    record: Local ResetRecord? := resetVerify(selector, token)
    if record == null {
        return sessionCommit(session, resetPasswordInvalid(context))
    }

    errors: Local List<String> := []
    if validationPasswordLongEnough(password) == false {
        errors.add(
            "Parola en az {str(validationMinimumPassword())} karakter olmalı."
        )
    }

    if password != confirmation {
        errors.add("Parolalar eşleşmiyor.")
    }

    if len(errors) > 0 {
        return sessionCommit(
            session
            resetPasswordView(session, context, selector, token, errors)
        )
    }

    if resetComplete(record, password) == false {
        return sessionCommit(session, resetPasswordInvalid(context))
    }

    flashSet(
        session
        "success"
        "Parolanız değiştirildi. Yeni parolanızla giriş yapın."
    )
    return sessionCommit(session, Web.redirect("/login"))
}
