// The upload handler.
require("Services/Context.ahd")
require("Services/Session.ahd")
require("Services/Solutions.ahd")
require("Services/CSRF.ahd")
require("Repositories/Questions.ahd")
require("Repositories/Users.ahd")
require("Support/Validation.ahd")
bring Web
from Web bring (Request, Response, Session, UploadedFile, RequestContext, Form)
bring HTTP
bring File

solutionSubmit: Function := (request: Request) -> Response {
    web: Local RequestContext := Web.context(request, sessionStore())
    session: Local Session := web.session
    context: Local PageContext := contextFor(session)

    viewer: Local UserRecord? := context.user
    if viewer == null {
        return web.respond(Web.redirect("/login"))
    }

    form: Local Form := web.form()
    if web.csrfValid() == false {
        return web.respond(Web.text("Geçersiz form belirteci.", 403))
    }

    questionId: Local Int := validationPositiveInt(form.optional("question_id"))
    question: Local QuestionRecord? := questionsFindPublished(questionId)
    if question == null {
        return web.respond(Web.text("Soru bulunamadı.", 404))
    }

    upload: Local UploadedFile? := request.file("solution")
    if upload == null {
        portalFlash(web, "error", "Bir dosya seçin.")
        return web.respond(
            Web.redirect("/question/{str(questionId)}")
        )
    }

    outcome: Local UploadOutcome := solutionStore(viewer.id, questionId, upload)
    if outcome.accepted {
        portalFlash(web, "success", outcome.message)
    }
    else {
        portalFlash(web, "error", outcome.message)
    }

    return web.respond(
        Web.redirect("/question/{str(questionId)}")
    )
}

solutionFileDownload: Function := (request: Request) -> Response {
    web: Local RequestContext := Web.context(request, sessionStore())
    session: Local Session := web.session

    id: Local Int := validationPositiveInt(request.query("id"))
    solution: Local SolutionRecord? := solutionsFindById(id)
    if solution == null {
        return web.respond(Web.text("Çözüm bulunamadı.", 404))
    }

    path: Local String := solutionPath(solution.storedFilename)
    if File.exists(path) == false {
        return web.respond(Web.text("Dosya bulunamadı.", 404))
    }

    return web.respond(HTTP.file(path, solution.mimeType))
}
