// The upload handler.
require("Services/Context.ahd")
require("Services/Session.ahd")
require("Services/Solutions.ahd")
require("Services/CSRF.ahd")
require("Repositories/Questions.ahd")
require("Repositories/Users.ahd")
require("Support/Validation.ahd")
bring Web
from Web bring (Request, Response, Session, UploadedFile)
bring HTTP
bring File

solutionSubmit: Function := (request: Request) -> Response {
    session: Local Session := sessionOpen(request)
    context: Local PageContext := contextFor(session)

    viewer: Local UserRecord? := context.user
    if viewer == null {
        return sessionCommit(session, Web.redirect("/login"))
    }

    if csrfValid(session, request) == false {
        return sessionCommit(session, Web.text("Geçersiz form belirteci.", 403))
    }

    questionId: Local Int := validationPositiveInt(request.form("question_id"))
    question: Local QuestionRecord? := questionsFindPublished(questionId)
    if question == null {
        return sessionCommit(session, Web.text("Soru bulunamadı.", 404))
    }

    upload: Local UploadedFile? := request.file("solution")
    if upload == null {
        flashSet(session, "error", "Bir dosya seçin.")
        return sessionCommit(
            session
            Web.redirect("/question?id={str(questionId)}")
        )
    }

    outcome: Local UploadOutcome := solutionStore(viewer.id, questionId, upload)
    if outcome.accepted {
        flashSet(session, "success", outcome.message)
    }
    else {
        flashSet(session, "error", outcome.message)
    }

    return sessionCommit(
        session
        Web.redirect("/question?id={str(questionId)}")
    )
}

solutionFileDownload: Function := (request: Request) -> Response {
    session: Local Session := sessionOpen(request)
    context: Local PageContext := contextFor(session)

    viewer: Local UserRecord? := context.user
    if viewer == null {
        return sessionCommit(session, Web.redirect("/login"))
    }

    id: Local Int := validationPositiveInt(request.query("id"))
    solution: Local SolutionRecord? := solutionsFindById(id)
    if solution == null {
        return sessionCommit(session, Web.text("Çözüm bulunamadı.", 404))
    }

    path: Local String := solutionPath(solution.storedFilename)
    if File.exists(path) == false {
        return sessionCommit(session, Web.text("Dosya bulunamadı.", 404))
    }

    return sessionCommit(session, HTTP.file(path, solution.mimeType))
}
