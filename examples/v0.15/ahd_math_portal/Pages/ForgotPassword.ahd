// Request a reset link.
//
// The response is identical for a registered and an unregistered address.
// That is the whole point of the page: it must not reveal who has an account.
require("Layouts/Auth.ahd")
require("Components/FormField.ahd")
require("Services/Context.ahd")
require("Services/Session.ahd")
require("Services/CSRF.ahd")
require("Services/PasswordReset.ahd")
require("Support/Validation.ahd")
bring Web
from Web bring (Request, Response, HTMLNode, Session)

forgotPasswordPage: Function := (request: Request) -> Response {
    session: Local Session := sessionOpen(request)
    context: Local PageContext := contextFor(session)
    return sessionCommit(session, forgotPasswordView(session, context, ""))
}

forgotPasswordView: Function := (
    session: Session
    context: PageContext
    notice: String
) -> Response {
    fields: Local List<HTMLNode> := []
    if notice != "" {
        fields.add(alertBox("info", notice))
    }

    fields.add(
        Web.UI.div(
            [
                Web.UI.i(
                    ""
                    {"class": "fa-solid fa-circle-info text-primary me-2"}
                )
                Web.UI.text(
                    "E-posta adresinizi girin. Kayıtlıysa güvenli bir şifre sıfırlama bağlantısı gönderilir."
                )
            ]
            {
                "class": "alert alert-primary-subtle border border-primary-subtle text-primary-emphasis small mb-4 d-flex align-items-center"
            }
        )
    )
    fields.add(
        Web.UI.formTo(
            "/forgot-password"
            "post"
            [
                csrfInput(session)
                formFieldWithIcon(
                    "forgot-email"
                    "email"
                    "E-posta"
                    "email"
                    "fa-solid fa-envelope"
                    ""
                    ""
                    "ornek@eposta.com"
                )
                Web.UI.buttonNodes(
                    [
                        Web.UI.i("", {"class": "fa-solid fa-paper-plane me-2"})
                        Web.UI.text("Sıfırlama Bağlantısı Gönder")
                    ]
                    {"type": "submit", "class": "btn btn-primary w-100 py-2"}
                )
            ]
        )
    )
    fields.add(
        Web.UI.div(
            [
                Web.UI.aNodes(
                    "/login"
                    [
                        Web.UI.i("", {"class": "fa-solid fa-arrow-left me-1"})
                        Web.UI.text("Giriş sayfasına dön")
                    ]
                    {"class": "text-decoration-none fw-semibold"}
                )
            ]
            {"class": "mt-4 pt-3 border-top text-center small"}
        )
    )

    return authLayout(
        "Parolamı unuttum"
        context.siteName
        context.headerColor
        context.flash
        context.flashKind
        fields
    )
}

forgotPasswordSubmit: Function := (request: Request) -> Response {
    session: Local Session := sessionOpen(request)
    context: Local PageContext := contextFor(session)
    if csrfValid(session, request) == false {
        return sessionCommit(session, Web.text("Geçersiz form belirteci.", 403))
    }

    email: Local String := validationEmail(request.form("email"))
    if validationEmailShaped(email) {
        resetRequest(email)
    }
    // The same sentence regardless: registered, unregistered, malformed, or
    // mail delivery failure.
    return sessionCommit(
        session
        forgotPasswordView(
            session
            context
            "Bu adres kayıtlıysa bir sıfırlama bağlantısı gönderildi."
        )
    )
}
