// Site settings.
//
// header_color is validated as a strict #RRGGBB value before it is stored and
// again before it is used, because it is the one setting that reaches a style
// attribute. Anything else -- a colour name, a url(), a javascript: string, a
// longer or shorter hex -- is rejected.
require("Layouts/Admin.ahd")
require("Components/FormField.ahd")
require("Services/Context.ahd")
require("Services/Session.ahd")
require("Services/Guard.ahd")
require("Services/CSRF.ahd")
require("Repositories/SiteSettings.ahd")
require("Support/Validation.ahd")
bring Web
from Web bring (
    Request
    Response
    HTMLNode
    Session
    RequestContext
    Form
    OldInput
    ValidationErrors
)

adminSettingsPage: Function := (request: Request) -> Response {
    web: Local RequestContext := Web.context(request, sessionStore())
    session: Local Session := web.session
    context: Local PageContext := contextFor(session)
    guard: Local GuardResult := adminGuard(session, context)
    if guard.allowed == false {
        return web.respond(guard.refusal)
    }

    return web.respond(
        adminSettingsView(
            session
            context
            settingsGet("site_name", "Ahd Akademi Matematik")
            settingsGet("header_color", "#0d6efd")
            []
        )
    )
}

colorPaletteField: Function := (
    id: String
    name: String
    label: String
    value: String
) -> HTMLNode {
    colors: Local List<String> := [
        "#0d6efd"
        "#4f46e5"
        "#059669"
        "#7c3aed"
        "#dc2626"
        "#0891b2"
        "#d97706"
        "#1e293b"
    ]
    swatches: Local List<HTMLNode> := []
    for c in colors {
        swatches.add(
            Web.UI.button(
                ""
                {
                    "type": "button"
                    "class": "btn p-0 border rounded shadow-sm me-2 mb-2"
                    "style": "width: 32px; height: 32px; background-color: {c}; cursor: pointer;"
                    "title": c
                    "aria-label": c
                    "onclick": "setColorPreset('{c}')"
                }
            )
        )
    }

    return Web.UI.div(
        [
            Web.UI.labelFor(id, label, {"class": "form-label fw-semibold"})
            Web.UI.div(
                [
                    Web.UI.input(
                        "color"
                        "header_color_picker"
                        value
                        {
                            "id": "header_color_picker"
                            "class": "form-control form-control-color me-2"
                            "style": "width: 48px; height: 38px; padding: 2px; cursor: pointer;"
                            "title": "Renk seçin"
                            "oninput": "setColorPreset(this.value)"
                            "onchange": "setColorPreset(this.value)"
                        }
                    )
                    Web.UI.input(
                        "text"
                        name
                        value
                        {
                            "id": id
                            "class": "form-control font-monospace"
                            "style": "max-width: 140px;"
                            "maxlength": "7"
                            "placeholder": "#0d6efd"
                            "oninput": "updateColorFromInput(this.value)"
                        }
                    )
                ]
                {"class": "d-flex align-items-center mb-2"}
            )
            Web.UI.div(
                [
                    Web.UI.span(
                        "Hızlı Palet Seçenekleri:"
                        {"class": "small text-body-secondary d-block mb-2"}
                    )
                    Web.UI.div(
                        swatches
                        {"class": "d-flex flex-wrap align-items-center"}
                    )
                ]
                {"class": "p-3 bg-light rounded border mb-2"}
            )
            Web.UI.p(
                "Yalnızca #RRGGBB biçimi kabul edilir. Renk seçiciden veya hazır paletten bir renk seçebilirsiniz."
                {"class": "form-text"}
            )
        ]
        {"class": "mb-3"}
    )
}

adminSettingsView: Function := (
    session: Session
    context: PageContext
    siteName: String
    headerColor: String
    errors: List<String>
) -> Response {
    content: Local List<HTMLNode> := []
    if len(errors) > 0 {
        content.add(errorList(errors))
    }

    content.add(
        Web.UI.div(
            [
                Web.UI.formTo(
                    "/admin/settings"
                    "post"
                    [
                        csrfInput(session)
                        formField(
                            "settings-name"
                            "site_name"
                            "Site adı"
                            "text"
                            siteName
                        )
                        colorPaletteField(
                            "settings-color"
                            "header_color"
                            "Başlık rengi"
                            headerColor
                        )
                        Web.UI.buttonNodes(
                            [
                                Web.UI.i(
                                    ""
                                    {"class": "fa-solid fa-floppy-disk me-1"}
                                )
                                Web.UI.text("Ayarları Kaydet")
                            ]
                            {"type": "submit", "class": "btn btn-primary"}
                        )
                    ]
                )
            ]
            {"class": "admin-card"}
        )
    )

    return adminLayout(
        session
        "Ayarlar"
        context.siteName
        context.headerColor
        context.user
        "/admin/settings"
        context.flash
        context.flashKind
        content
    )
}

adminSettingsSubmit: Function := (request: Request) -> Response {
    web: Local RequestContext := Web.context(request, sessionStore())
    session: Local Session := web.session
    context: Local PageContext := contextFor(session)
    guard: Local GuardResult := adminGuard(session, context)
    if guard.allowed == false {
        return web.respond(guard.refusal)
    }

    form: Local Form := web.form()
    if web.csrfValid() == false {
        return web.respond(Web.text("Geçersiz form belirteci.", 403))
    }

    siteName: Local String := form.value("site_name").trim()
    headerColor: Local String := form.value("header_color").trim()
    old: Local OldInput := form.old(["site_name", "header_color"])
    errors: Local ValidationErrors := Web.errors()
    errors.required("site_name", siteName, "Site adı boş olamaz.")
    errors.maxLength(
        "site_name"
        siteName
        80
        "Site adı en fazla 80 karakter olabilir."
    )
    errors.hexColor(
        "header_color"
        headerColor
        "Başlık rengi #RRGGBB biçiminde olmalı (örnek: #0d6efd)."
    )
    if errors.any() {
        return web.respond(
            adminSettingsView(
                session
                context
                old.value("site_name")
                old.value("header_color")
                errors.messages()
            )
        )
    }

    settingsSet("site_name", siteName)
    settingsSet("header_color", headerColor)
    portalFlash(web, "success", "Ayarlar kaydedildi.")
    return web.respond(Web.redirect("/admin/settings"))
}
