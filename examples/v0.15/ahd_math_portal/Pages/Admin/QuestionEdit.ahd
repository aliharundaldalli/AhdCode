// The question editor, including Gemini drafting.
//
// The generate button posts the editor's own fields to /admin/questions/generate,
// which calls Gemini and re-renders this same editor with the generated text
// filled in. Nothing is saved by that round trip: the administrator still has
// to press save, and then publish, as two further explicit actions.
require("Layouts/Admin.ahd")
require("Components/FormField.ahd")
require("Services/Context.ahd")
require("Services/Session.ahd")
require("Services/Guard.ahd")
require("Services/CSRF.ahd")
require("Services/Gemini.ahd")
require("Repositories/Questions.ahd")
require("Repositories/Users.ahd")
require("Support/Validation.ahd")
require("Config/Gemini.ahd")
bring Web
from Web bring (
    Request
    Response
    HTMLNode
    Session
    RequestContext
    Form
    OldInput
    ValidationErrors
)

adminQuestionNewPage: Function := (request: Request) -> Response {
    web: Local RequestContext := Web.context(request, sessionStore())
    session: Local Session := web.session
    context: Local PageContext := contextFor(session)
    guard: Local GuardResult := adminGuard(session, context)
    if guard.allowed == false {
        return web.respond(guard.refusal)
    }

    return web.respond(
        adminQuestionForm(session, context, 0, "", "", "", [], "")
    )
}

adminQuestionEditPage: Function := (request: Request) -> Response {
    web: Local RequestContext := Web.context(request, sessionStore())
    session: Local Session := web.session
    context: Local PageContext := contextFor(session)
    guard: Local GuardResult := adminGuard(session, context)
    if guard.allowed == false {
        return web.respond(guard.refusal)
    }

    id: Local Int := validationPathID(
        request.path()
        "/admin/questions/edit/"
        request.query("id")
    )
    question: Local QuestionRecord? := questionsFindAny(id)
    if question == null {
        return web.respond(Web.text("Soru bulunamadı.", 404))
    }

    return web.respond(
        adminQuestionForm(
            session
            context
            question.id
            question.title
            question.topic
            question.body
            []
            ""
        )
    )
}

adminQuestionForm: Function := (
    session: Session
    context: PageContext
    id: Int
    title: String
    topic: String
    body: String
    errors: List<String>
    notice: String
) -> Response {
    content: Local List<HTMLNode> := []
    if len(errors) > 0 {
        content.add(errorList(errors))
    }

    if notice != "" {
        content.add(alertBox("info", notice))
    }

    content.add(
        Web.UI.div(
            [
                Web.UI.formTo(
                    "/admin/questions/save"
                    "post"
                    [
                        csrfInput(session)
                        Web.UI.input("hidden", "question_id", str(id))
                        formField(
                            "question-title"
                            "title"
                            "Başlık"
                            "text"
                            title
                        )
                        formField(
                            "question-topic"
                            "topic"
                            "Konu"
                            "text"
                            topic
                        )
                        formTextArea(
                            "question-body"
                            "body"
                            "Soru metni"
                            body
                        )
                        Web.UI.buttonNodes(
                            [
                                Web.UI.i(
                                    ""
                                    {"class": "fa-solid fa-floppy-disk me-1"}
                                )
                                Web.UI.text("Kaydet")
                            ]
                            {"type": "submit", "class": "btn btn-primary"}
                        )
                    ]
                )
            ]
            {"class": "admin-card"}
        )
    )
    content.add(adminGeminiPanel(session, id, title, topic, body))
    content.add(
        Web.UI.pNodes(
            [
                Web.UI.aNodes(
                    "/admin/questions"
                    [
                        Web.UI.i("", {"class": "fa-solid fa-arrow-left me-1"})
                        Web.UI.text("Listeye dön")
                    ]
                    {"class": "text-decoration-none"}
                )
            ]
            {"class": "mt-3 mb-0 small"}
        )
    )

    heading: Local String := "Yeni soru"
    if id != 0 {
        heading = "Soruyu düzenle"
    }

    return adminLayout(
        session
        heading
        context.siteName
        context.headerColor
        context.user
        "/admin/questions"
        context.flash
        context.flashKind
        content
    )
}
// adminGeminiPanel is the AI drafting form. When Gemini is not configured the
// panel says so plainly instead of offering a button that cannot work.
adminGeminiPanel: Function := (
    session: Session
    id: Int
    title: String
    topic: String
    body: String
) -> HTMLNode {
    if geminiConfigured() == false {
        return Web.UI.div(
            [
                Web.UI.h2Nodes(
                    [
                        Web.UI.i(
                            ""
                            {
                                "class": "fa-solid fa-wand-magic-sparkles text-primary me-2"
                            }
                        )
                        Web.UI.text("Gemini ile üret")
                    ]
                    {"class": "h5 mb-3"}
                )
                Web.UI.p(
                    "Gemini yapılandırılmamış. GEMINI_API_KEY ve GEMINI_MODEL ortam değişkenlerini ayarlayın."
                    {"class": "alert alert-secondary mb-0"}
                )
            ]
            {"class": "admin-card"}
        )
    }

    return Web.UI.div(
        [
            Web.UI.h2Nodes(
                [
                    Web.UI.i(
                        ""
                        {
                            "class": "fa-solid fa-wand-magic-sparkles text-primary me-2"
                        }
                    )
                    Web.UI.text("Gemini ile üret")
                ]
                {"class": "h5 mb-1"}
            )
            Web.UI.p(
                "Üretilen metin taslak olarak forma yazılır. Yayımlamak ayrı ve açık bir adımdır."
                {"class": "text-body-secondary small mb-3"}
            )
            Web.UI.formTo(
                "/admin/questions/generate"
                "post"
                [
                    csrfInput(session)
                    Web.UI.input("hidden", "question_id", str(id))
                    Web.UI.input("hidden", "title", title)
                    Web.UI.input("hidden", "body", body)
                    formField("gemini-topic", "topic", "Konu", "text", topic)
                    Web.UI.div(
                        [
                            Web.UI.labelFor(
                                "gemini-difficulty"
                                "Zorluk"
                                {"class": "form-label"}
                            )
                            Web.UI.select(
                                "difficulty"
                                [
                                    Web.UI.option("kolay", "Kolay")
                                    Web.UI.option("orta", "Orta")
                                    Web.UI.option("zor", "Zor")
                                ]
                                {
                                    "id": "gemini-difficulty"
                                    "class": "form-select"
                                }
                            )
                        ]
                        {"class": "mb-3"}
                    )
                    formField(
                        "gemini-instruction"
                        "instruction"
                        "Ek yönerge"
                        "text"
                    )
                    Web.UI.buttonNodes(
                        [
                            Web.UI.i(
                                ""
                                {
                                    "class": "fa-solid fa-wand-magic-sparkles me-1"
                                }
                            )
                            Web.UI.text("Taslak üret")
                        ]
                        {"type": "submit", "class": "btn btn-outline-primary"}
                    )
                ]
            )
        ]
        {"class": "admin-card"}
    )
}

adminQuestionGenerateSubmit: Function := (request: Request) -> Response {
    web: Local RequestContext := Web.context(request, sessionStore())
    session: Local Session := web.session
    context: Local PageContext := contextFor(session)
    guard: Local GuardResult := adminGuard(session, context)
    if guard.allowed == false {
        return web.respond(guard.refusal)
    }

    form: Local Form := web.form()
    if web.csrfValid() == false {
        return web.respond(Web.text("Geçersiz form belirteci.", 403))
    }

    id: Local Int := validationPositiveInt(form.optional("question_id"))
    topic: Local String := form.value("topic").trim()
    difficulty: Local String := form.value("difficulty").trim()
    instruction: Local String := form.value("instruction").trim()
    existingTitle: Local String := form.value("title").trim()
    existingBody: Local String := form.value("body").trim()

    generated: Local GeneratedQuestion := geminiGenerate(
        topic
        difficulty
        instruction
    )
    if generated.ok == false {
        return web.respond(
            adminQuestionForm(
                session
                context
                id
                existingTitle
                topic
                existingBody
                [generated.error]
                ""
            )
        )
    }
    // The generated text is untrusted text. It reaches the page through the
    // ordinary escaping form fields, exactly like anything a person typed.
    newTitle: Local String := generated.title
    if newTitle == "" {
        newTitle = existingTitle
    }

    return web.respond(
        adminQuestionForm(
            session
            context
            id
            newTitle
            topic
            generated.body
            []
            "Taslak üretildi. Gözden geçirip kaydedin."
        )
    )
}

adminQuestionSaveSubmit: Function := (request: Request) -> Response {
    web: Local RequestContext := Web.context(request, sessionStore())
    session: Local Session := web.session
    context: Local PageContext := contextFor(session)
    guard: Local GuardResult := adminGuard(session, context)
    if guard.allowed == false {
        return web.respond(guard.refusal)
    }

    form: Local Form := web.form()
    if web.csrfValid() == false {
        return web.respond(Web.text("Geçersiz form belirteci.", 403))
    }

    id: Local Int := validationPositiveInt(form.optional("question_id"))
    title: Local String := form.value("title").trim()
    topic: Local String := form.value("topic").trim()
    body: Local String := form.value("body").trim()
    old: Local OldInput := form.old(["title", "topic", "body"])
    errors: Local ValidationErrors := Web.errors()
    errors.required("title", title, "Başlık gerekli.")
    errors.required("topic", topic, "Konu gerekli.")
    errors.required("body", body, "Soru metni gerekli.")
    if errors.any() {
        return web.respond(
            adminQuestionForm(
                session
                context
                id
                old.value("title")
                old.value("topic")
                old.value("body")
                errors.messages()
                ""
            )
        )
    }

    author: Local UserRecord? := context.user
    authorId: Local Int := 0
    if author != null {
        authorId = author.id
    }

    if id == 0 {
        questionsCreate(title, topic, body, authorId)
        portalFlash(web, "success", "Soru taslak olarak kaydedildi.")
    }
    else {
        questionsUpdate(id, title, topic, body)
        portalFlash(web, "success", "Soru güncellendi.")
    }

    return web.respond(Web.redirect("/admin/questions"))
}
