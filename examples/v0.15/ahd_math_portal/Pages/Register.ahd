// Registration.
//
// Uniqueness is decided by the database: the insert is attempted and a
// constraint violation becomes the duplicate-email message. A prior SELECT
// would be a race, and this way there is only one source of truth.
require("Layouts/Auth.ahd")
require("Components/FormField.ahd")
require("Services/Context.ahd")
require("Services/Session.ahd")
require("Services/Auth.ahd")
require("Services/CSRF.ahd")
require("Repositories/Users.ahd")
require("Support/Validation.ahd")
bring Web
from Web bring (
    Request
    Response
    HTMLNode
    Session
    RequestContext
    Form
    OldInput
    ValidationErrors
)
bring Security

registerPage: Function := (request: Request) -> Response {
    web: Local RequestContext := Web.context(request, sessionStore())
    session: Local Session := web.session
    context: Local PageContext := contextFor(session)
    return web.respond(registerView(session, context, "", "", []))
}

registerView: Function := (
    session: Session
    context: PageContext
    name: String
    email: String
    errors: List<String>
) -> Response {
    fields: Local List<HTMLNode> := []
    if len(errors) > 0 {
        fields.add(errorList(errors))
    }

    fields.add(
        Web.UI.formTo(
            "/register"
            "post"
            [
                csrfInput(session)
                formFieldWithIcon(
                    "register-name"
                    "name"
                    "Ad soyad"
                    "text"
                    "fa-solid fa-user"
                    name
                    ""
                    "Adınız Soyadınız"
                )
                formFieldWithIcon(
                    "register-email"
                    "email"
                    "E-posta"
                    "email"
                    "fa-solid fa-envelope"
                    email
                    ""
                    "ornek@eposta.com"
                )
                formPasswordFieldWithIcon(
                    "register-password"
                    "password"
                    "Parola"
                    "fa-solid fa-lock"
                    ""
                    "En az {str(validationMinimumPassword())} karakter."
                    "••••••••"
                )
                formPasswordFieldWithIcon(
                    "register-confirm"
                    "password_confirmation"
                    "Parola (tekrar)"
                    "fa-solid fa-shield-halved"
                    ""
                    ""
                    "••••••••"
                )
                Web.UI.buttonNodes(
                    [
                        Web.UI.i("", {"class": "fa-solid fa-user-plus me-2"})
                        Web.UI.text("Kayıt ol")
                    ]
                    {"type": "submit", "class": "btn btn-primary w-100 py-2"}
                )
            ]
        )
    )
    fields.add(
        Web.UI.div(
            [
                Web.UI.span(
                    "Zaten hesabınız var mı? "
                    {"class": "text-body-secondary"}
                )
                Web.UI.aNodes(
                    "/login"
                    [
                        Web.UI.i(
                            ""
                            {"class": "fa-solid fa-right-to-bracket me-1"}
                        )
                        Web.UI.text("Giriş yapın")
                    ]
                    {"class": "fw-semibold text-decoration-none"}
                )
            ]
            {"class": "mt-4 pt-3 border-top text-center small"}
        )
    )

    return authLayout(
        "Kayıt ol"
        context.siteName
        context.headerColor
        context.flash
        context.flashKind
        fields
    )
}

registerSubmit: Function := (request: Request) -> Response {
    web: Local RequestContext := Web.context(request, sessionStore())
    session: Local Session := web.session
    context: Local PageContext := contextFor(session)
    form: Local Form := web.form()
    if web.csrfValid() == false {
        return web.respond(Web.text("Geçersiz form belirteci.", 403))
    }

    name: Local String := form.value("name").trim()
    email: Local String := form.value("email").trim().lower()
    password: Local String := form.value("password")
    confirmation: Local String := form.value("password_confirmation")
    old: Local OldInput := form.old(["name", "email"])
    errors: Local ValidationErrors := Web.errors()
    errors.required("name", name, "Ad soyad gerekli.")
    errors.email("email", email, "Geçerli bir e-posta adresi girin.")
    errors.minLength(
        "password"
        password
        validationMinimumPassword()
        "Parola en az {str(validationMinimumPassword())} karakter olmalı."
    )
    errors.matches(
        "password_confirmation"
        confirmation
        password
        "Parolalar eşleşmiyor."
    )
    if errors.any() {
        return web.respond(
            registerView(
                session
                context
                old.value("name")
                old.value("email")
                errors.messages()
            )
        )
    }

    created: Local Int? := usersCreate(
        name
        email
        Security.passwordHash(password)
        "user"
    )
    if created == null {
        errors.add("email", "Bu e-posta adresi zaten kayıtlı.")
        return web.respond(
            registerView(
                session
                context
                old.value("name")
                old.value("email")
                errors.messages()
            )
        )
    }

    portalFlash(web, "success", "Kaydınız tamamlandı. Giriş yapabilirsiniz.")
    return web.respond(Web.redirect("/login"))
}
