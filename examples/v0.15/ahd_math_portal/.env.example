# Copy to .env for local development. Never commit a real .env.
#
# A variable already present in the process environment wins over this file,
# so containers and CI override it without editing anything. `ahdcode build`
# embeds none of it: the executable reads its configuration at start-up.

APP_NAME=Ahd Akademi Matematik
APP_ENV=development
APP_HOST=ahdakademi.com
APP_PROTOCOL=http

# The socket this process binds. Not the public address: behind Cloudflare,
# Caddy, or nginx the two differ. In development this is also the address you
# actually open -- <APP_HOST>.test is a logical identity only, and v0.15
# installs no resolver for it.
SERVER_HOST=127.0.0.1
SERVER_PORT=8160

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ahd_math_portal
DB_USERNAME=
DB_PASSWORD=
DB_SECURITY=none

# Optional. With no SMTP_HOST the password reset flow still behaves
# identically from the outside -- it just cannot deliver the message.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
SMTP_SECURITY=none

# Optional. With no key and model the admin AI panel reports itself
# unavailable instead of offering a button that cannot work.
GEMINI_API_KEY=
GEMINI_MODEL=

UPLOAD_ROOT=storage/solutions
UPLOAD_MAX_BYTES=5242880
