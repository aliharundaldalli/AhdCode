// Password reset.
//
// The link carries two random halves: a selector that identifies the row and a
// verifier that proves possession. Only the selector and the Argon2id hash of
// the verifier are stored, so the database never holds a credential that can
// be replayed as a working reset link.
//
// AhdCode's released Security module offers passwordHash/passwordVerify,
// token, and secureEqual -- there is no general-purpose message digest -- so
// the verifier is hashed with the same password primitive. That is a
// deliberate use of the available API, not a workaround for a missing one.
require("Repositories/PasswordResets.ahd")
require("Repositories/Users.ahd")
require("Services/Mail.ahd")
require("Config/App.ahd")
bring Security
bring Web

resetTokenMinutes: Int := 30
// resetRequest is called for every submitted address. When the address is not
// registered it does nothing at all -- and the caller still shows the same
// message, so the two cases are indistinguishable from outside.
resetRequest: Function := (email: String) -> Nothing {
    resetTokenMinutes: Global Int
    user: Local UserRecord? := usersFindByEmail(email)
    if user == null {
        return
    }

    if user.isActive == false {
        return
    }

    selector: Local String := Security.token()
    verifier: Local String := Security.token()
    resetsCreate(
        user.id
        selector
        Security.passwordHash(verifier)
        resetTokenMinutes
    )

    link: Local String := "{linkBaseURL()}/reset-password?selector={selector}&token={verifier}"
    mailSend(
        user.email
        "Parola sıfırlama"
        "Merhaba {user.name},\n\nParolanızı sıfırlamak için bu bağlantıyı açın:\n\n{link}\n\nBağlantı {str(resetTokenMinutes)} dakika geçerlidir ve yalnızca bir kez kullanılabilir.\n\nBu isteği siz yapmadıysanız bu iletiyi yok sayabilirsiniz."
    )
}
// resetVerify resolves a selector/verifier pair to an account, or null. It
// returns null for an unknown selector, an expired row, a consumed row, and a
// wrong verifier alike.
resetVerify: Function := (selector: String, verifier: String) -> ResetRecord? {
    if selector == "" or verifier == "" {
        return null
    }

    record: Local ResetRecord? := resetsFindUsable(selector)
    if record == null {
        return null
    }

    if Security.passwordVerify(verifier, record.verifierHash) == false {
        return null
    }

    return record
}
// resetComplete consumes the token and sets the new password. Consumption is
// checked first: if another request already used this row, this one changes
// nothing. Changing the password advances auth_version, which ends every
// session that authenticated with the old one.
resetComplete: Function := (record: ResetRecord, password: String) -> Bool {
    if resetsConsume(record.id) == false {
        return false
    }

    usersSetPassword(record.userId, Security.passwordHash(password))
    resetsInvalidateForUser(record.userId)
    return true
}

resetMinutes: Function := () -> Int {
    resetTokenMinutes: Global Int
    return resetTokenMinutes
}
