// One-shot session messages.
//
// v0.16 stores flash under the reserved __web_flash: prefix. Application
// helpers and RequestContext.flashSet/flashTake share those keys so a
// context.respond after portalFlash is visible on the next GET, then gone.
bring Web
from Web bring (Session, RequestContext)

flashKey: String := "__web_flash:message"
flashKindKey: String := "__web_flash:kind"

portalFlash: Function := (
    web: RequestContext
    kind: String
    message: String
) -> Nothing {
    web.flashSet("kind", kind)
    web.flashSet("message", message)
}

flashSet: Function := (
    session: Session
    kind: String
    message: String
) -> Nothing {
    flashKey: Global String
    flashKindKey: Global String
    session.set(flashKey, message)
    session.set(flashKindKey, kind)
}
// flashTake returns the pending message and clears it, so a refresh does not
// show it again.
flashTake: Function := (session: Session) -> String {
    flashKey: Global String
    message: Local String? := session.get(flashKey)
    if message == null {
        return ""
    }

    session.remove(flashKey)
    return message
}

flashTakeKind: Function := (session: Session) -> String {
    flashKindKey: Global String
    kind: Local String? := session.get(flashKindKey)
    if kind == null {
        return "info"
    }

    session.remove(flashKindKey)
    return kind
}
