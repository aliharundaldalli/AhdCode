// A labelled form control.
//
// labelFor writes the for attribute and the caller supplies the matching id,
// which is the accessibility pairing Web.UI documents. This component exists
// because the application repeats the pattern often -- it is not a Forms
// framework, and it does no validation.
bring Web
from Web bring HTMLNode

formField: Function := (
    id: String
    name: String
    label: String
    type: String
    value: String := ""
    help: String := ""
) -> HTMLNode {
    children: Local List<HTMLNode> := [
        Web.UI.labelFor(id, label, {"class": "form-label"})
        Web.UI.input(type, name, value, {"id": id, "class": "form-control"})
    ]
    if help != "" {
        children.add(Web.UI.p(help, {"class": "form-text"}))
    }

    return Web.UI.div(children, {"class": "mb-3"})
}

formTextArea: Function := (
    id: String
    name: String
    label: String
    value: String := ""
    rows: String := "8"
) -> HTMLNode {
    return Web.UI.div(
        [
            Web.UI.labelFor(id, label, {"class": "form-label"})
            Web.UI.textarea(
                name
                value
                {"id": id, "class": "form-control", "rows": rows}
            )
        ]
        {"class": "mb-3"}
    )
}

formPasswordField: Function := (
    id: String
    name: String
    label: String
    value: String := ""
    help: String := ""
) -> HTMLNode {
    children: Local List<HTMLNode> := [
        Web.UI.labelFor(id, label, {"class": "form-label"})
        Web.UI.div(
            [
                Web.UI.input(
                    "password"
                    name
                    value
                    {"id": id, "class": "form-control"}
                )
                Web.UI.buttonNodes(
                    [Web.UI.i("", {"class": "fa-regular fa-eye"})]
                    {
                        "type": "button"
                        "class": "btn btn-outline-secondary"
                        "onclick": "togglePasswordVisibility('{id}', this)"
                        "title": "Şifreyi Göster / Gizle"
                        "aria-label": "Şifreyi Göster / Gizle"
                    }
                )
            ]
            {"class": "input-group"}
        )
    ]
    if help != "" {
        children.add(Web.UI.p(help, {"class": "form-text"}))
    }

    return Web.UI.div(children, {"class": "mb-3"})
}

formFieldWithIcon: Function := (
    id: String
    name: String
    label: String
    type: String
    iconClass: String
    value: String := ""
    help: String := ""
    placeholder: String := ""
) -> HTMLNode {
    labelNode: Local HTMLNode := Web.UI.labelNodes(
        [
            Web.UI.i("", {"class": "{iconClass} me-2 text-primary"})
            Web.UI.text(label)
        ]
        {"for": id, "class": "form-label"}
    )
    inputNode: Local HTMLNode := Web.UI.input(
        type
        name
        value
        {"id": id, "class": "form-control"}
    )
    if placeholder != "" {
        inputNode = Web.UI.input(
            type
            name
            value
            {"id": id, "class": "form-control", "placeholder": placeholder}
        )
    }

    children: Local List<HTMLNode> := [labelNode, inputNode]
    if help != "" {
        children.add(Web.UI.p(help, {"class": "form-text"}))
    }

    return Web.UI.div(children, {"class": "mb-3"})
}

formPasswordFieldWithIcon: Function := (
    id: String
    name: String
    label: String
    iconClass: String
    value: String := ""
    help: String := ""
    placeholder: String := ""
) -> HTMLNode {
    labelNode: Local HTMLNode := Web.UI.labelNodes(
        [
            Web.UI.i("", {"class": "{iconClass} me-2 text-primary"})
            Web.UI.text(label)
        ]
        {"for": id, "class": "form-label"}
    )
    inputNode: Local HTMLNode := Web.UI.input(
        "password"
        name
        value
        {"id": id, "class": "form-control"}
    )
    if placeholder != "" {
        inputNode = Web.UI.input(
            "password"
            name
            value
            {"id": id, "class": "form-control", "placeholder": placeholder}
        )
    }

    children: Local List<HTMLNode> := [
        labelNode
        Web.UI.div(
            [
                inputNode
                Web.UI.buttonNodes(
                    [Web.UI.i("", {"class": "fa-regular fa-eye"})]
                    {
                        "type": "button"
                        "class": "btn btn-outline-secondary"
                        "onclick": "togglePasswordVisibility('{id}', this)"
                        "title": "Şifreyi Göster / Gizle"
                        "aria-label": "Şifreyi Göster / Gizle"
                    }
                )
            ]
            {"class": "input-group"}
        )
    ]
    if help != "" {
        children.add(Web.UI.p(help, {"class": "form-text"}))
    }

    return Web.UI.div(children, {"class": "mb-3"})
}
