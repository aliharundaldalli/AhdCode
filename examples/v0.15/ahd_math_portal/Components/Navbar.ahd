// The site navigation bar.
//
// A Component is an ordinary Function returning an HTMLNode. The header colour
// is a validated #RRGGBB value from site_settings -- validated before it is
// stored and again before it reaches the style attribute, so a stored setting
// can never carry arbitrary CSS.
require("Repositories/Users.ahd")
bring Web
from Web bring HTMLNode

navbar: Function := (
    token: String
    siteName: String
    headerColor: String
    user: UserRecord?
    isAdmin: Bool
) -> HTMLNode {
    links: Local List<HTMLNode> := [
        Web.UI.liNodes(
            [
                Web.UI.aNodes(
                    "/questions"
                    [
                        Web.UI.i("", {"class": "fa-solid fa-list-check me-1"})
                        Web.UI.text("Sorular")
                    ]
                    {"class": "nav-link"}
                )
            ]
            {"class": "nav-item"}
        )
    ]
    if isAdmin {
        links.add(
            Web.UI.liNodes(
                [
                    Web.UI.aNodes(
                        "/admin"
                        [
                            Web.UI.i(
                                ""
                                {"class": "fa-solid fa-shield-halved me-1"}
                            )
                            Web.UI.text("Yönetim")
                        ]
                        {"class": "nav-link"}
                    )
                ]
                {"class": "nav-item"}
            )
        )
    }

    return Web.UI.header(
        [
            Web.UI.nav(
                [
                    Web.UI.div(
                        [
                            Web.UI.aNodes(
                                "/"
                                [
                                    Web.UI.img(
                                        "/assets/images/logo.png"
                                        "AhdCode"
                                        {
                                            "width": "34"
                                            "height": "34"
                                            "class": "me-2 rounded shadow-sm navbar-brand-logo"
                                        }
                                    )
                                    Web.UI.span(
                                        siteName
                                        {"class": "fs-5 fw-bold text-white"}
                                    )
                                ]
                                {
                                    "class": "navbar-brand d-flex align-items-center text-white text-decoration-none me-4 py-0"
                                }
                            )
                            Web.UI.ul(
                                links
                                {
                                    "class": "navbar-nav me-auto mb-0 d-flex flex-row align-items-center gap-1"
                                }
                            )
                            navbarAccount(user, token)
                        ]
                        {"class": "container d-flex align-items-center py-2"}
                    )
                ]
                {
                    "class": "navbar navbar-expand"
                    "style": "background: linear-gradient(135deg, {headerColor} 0%, rgba(15, 23, 42, 0.95) 100%); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);"
                }
            )
        ]
        {"class": "site-header"}
    )
}

navbarAccount: Function := (user: UserRecord?, token: String) -> HTMLNode {
    if user == null {
        return Web.UI.div(
            [
                Web.UI.aNodes(
                    "/login"
                    [
                        Web.UI.i(
                            ""
                            {"class": "fa-solid fa-right-to-bracket me-1"}
                        )
                        Web.UI.text("Giriş")
                    ]
                    {"class": "btn btn-sm btn-light btn-nav-login me-2"}
                )
                Web.UI.aNodes(
                    "/register"
                    [
                        Web.UI.i("", {"class": "fa-solid fa-user-plus me-1"})
                        Web.UI.text("Kayıt ol")
                    ]
                    {"class": "btn btn-sm btn-outline-light btn-nav-register"}
                )
            ]
            {"class": "d-flex align-items-center"}
        )
    }

    return Web.UI.formTo(
        "/logout"
        "post"
        [
            Web.UI.input("hidden", "_csrf", token)
            Web.UI.aNodes(
                "/profile"
                [
                    Web.UI.i(
                        ""
                        {"class": "fa-solid fa-circle-user me-1 text-white-50"}
                    )
                    Web.UI.span(user.name, {"class": "fw-semibold"})
                ]
                {
                    "class": "btn btn-sm btn-outline-light btn-nav-profile me-2"
                    "title": "Profilimi Görüntüle"
                }
            )
            Web.UI.buttonNodes(
                [
                    Web.UI.i(
                        ""
                        {"class": "fa-solid fa-arrow-right-from-bracket me-1"}
                    )
                    Web.UI.text("Çıkış")
                ]
                {
                    "type": "submit"
                    "class": "btn btn-sm btn-light btn-nav-logout"
                    "title": "Oturumu Kapat"
                }
            )
        ]
        {"class": "d-flex align-items-center", "id": "logout-form"}
    )
}
