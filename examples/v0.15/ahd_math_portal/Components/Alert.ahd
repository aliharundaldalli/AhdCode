// A Bootstrap alert. The message is ordinary text and is escaped like any
// other content; only the caller-chosen kind reaches a class name, and the
// kinds are a fixed set rather than anything the message can influence.
bring Web
from Web bring HTMLNode

alertBox: Function := (kind: String, message: String) -> HTMLNode {
    style: Local String := "alert alert-info"
    if kind == "success" {
        style = "alert alert-success"
    }

    if kind == "error" {
        style = "alert alert-danger"
    }

    if kind == "warning" {
        style = "alert alert-warning"
    }

    return Web.UI.p(message, {"class": style, "role": "alert"})
}
// errorList renders validation failures. Each message is escaped text.
errorList: Function := (messages: List<String>) -> HTMLNode {
    items: Local List<HTMLNode> := []
    for message in messages {
        items.add(Web.UI.li(message))
    }

    return Web.UI.div(
        [Web.UI.ul(items, {"class": "mb-0 ps-3"})]
        {"class": "alert alert-danger", "role": "alert"}
    )
}
