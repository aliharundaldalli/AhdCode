// Password reset persistence.
//
// A row stores the selector in the clear and the Argon2id hash of the
// verifier. The usable half of the reset credential is never written down, so
// a leaked copy of this table cannot be turned back into a working reset link.
//
// Expiry and single use are enforced in SQL, on the database clock, so a
// wrong application clock cannot extend a token's life.
require("Config/Database.ahd")
require("Support/Rows.ahd")
bring MySQL
from MySQL bring (MySQLDatabase, MySQLValue)

ResetRecord: Class<> := {
    structure: Attributes := (id: Int, userId: Int, verifierHash: String)
}

resetsCreate: Function := (
    userId: Int
    selector: String
    verifierHash: String
    minutes: Int
) -> Nothing {
    connection(
        
    ).execute(
        "INSERT INTO password_resets (user_id, selector, verifier_hash, expires_at) VALUES (?, ?, ?, DATE_ADD(NOW(), INTERVAL ? MINUTE))"
        [
            MySQL.fromInt(userId)
            MySQL.fromString(selector)
            MySQL.fromString(verifierHash)
            MySQL.fromInt(minutes)
        ]
    )
}
// resetsFindUsable returns a row only when it is unexpired and unused. A
// consumed or stale token is indistinguishable from a wrong one to the caller.
resetsFindUsable: Function := (selector: String) -> ResetRecord? {
    rows: Local List<Pair<String, MySQLValue>> := connection(
        
    ).query(
        "SELECT id, user_id, verifier_hash FROM password_resets WHERE selector = ? AND used_at IS NULL AND expires_at > NOW() LIMIT 1"
        [MySQL.fromString(selector)]
    )
    if len(rows) == 0 {
        return null
    }

    return ResetRecord(
        id: rowInt(rows[0], "id")
        userId: rowInt(rows[0], "user_id")
        verifierHash: rowString(rows[0], "verifier_hash")
    )
}
// resetsConsume marks one token used, and reports whether this call is the one
// that consumed it. The WHERE clause repeats used_at IS NULL so two concurrent
// redemptions cannot both succeed.
resetsConsume: Function := (id: Int) -> Bool {
    result: Local := connection(
        
    ).execute(
        "UPDATE password_resets SET used_at = NOW() WHERE id = ? AND used_at IS NULL"
        [MySQL.fromInt(id)]
    )
    return result.affectedRows() == 1
}
// resetsInvalidateForUser retires every outstanding token for one account, so
// a completed reset cannot be followed by a second, older link.
resetsInvalidateForUser: Function := (userId: Int) -> Nothing {
    connection(
        
    ).execute(
        "UPDATE password_resets SET used_at = NOW() WHERE user_id = ? AND used_at IS NULL"
        [MySQL.fromInt(userId)]
    )
}
