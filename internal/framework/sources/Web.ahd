// AhdCode's first-party Web framework.
//
//     bring Web
//
// is the whole import an ordinary Web application needs. Web is a facade: it
// composes the existing HTTP, HTML, Session, Security, and Env primitives
// rather than replacing them, and it re-exports the types those primitives
// already define, so a Request reached through Web is the same Request HTTP
// hands a handler -- never a parallel copy of it.
//
// The low-level modules stay available and unchanged. An application that
// wants them writes `bring HTTP` and `bring HTML` exactly as before; Web is
// an addition, never a migration.
//
// What Web is not, in v0.15: it is not an ORM, not a Forms or validation
// framework, not a middleware system, not a template language, and not a
// JavaScript UI runtime. Pages are composed on the server and rendered to
// markup. There is no virtual DOM and no hydration step.
//
// The shape of an application:
//
//     App      manages the application: configuration, routes, assets
//     Page     produces the content of one page
//     Layout   wraps that content in the shared document shell
//     UI       builds the HTML tree
//
// Page, Layout, and Component are conventions, not language constructs.
// Each one is an ordinary AhdCode Function that returns an HTMLNode -- there
// is no base class to inherit, no lifecycle to implement, and no registry to
// join.
bring HTTP
from HTTP bring (
    Request
    Response
    Server
    Session
    SessionStore
    Cookie
    UploadedFile
    HTTPError
)
bring HTML
from HTML bring (HTMLNode, HTMLError)
bring Env
bring File
bring WebError
from WebError bring WebConfigError
bring WebConfig
from WebConfig bring AppConfig
bring WebApp
from WebApp bring App
bring WebUI
from WebUI bring UIKit
// UI is the semantic HTML component layer: Web.UI.section, Web.UI.h1,
// Web.UI.p, Web.UI.img, and the rest. Every String it takes as content is
// escaped, so a value out of a database or a form stays text.
UI: UIKit := UIKit()
// loadEnvironment reads a local .env file into the process environment.
//
// Precedence is fixed and deliberate: a variable already exported by the
// process, a container, or CI wins over the file. That makes `.env` a local
// development convenience and never something that quietly overrides a real
// deployment's configuration. Values are read at run time and are never
// compiled into the executable.
loadEnvironment: Function := (path: String := ".env") -> Nothing {
    if File.exists(path) {
        Env.load(path, false)
    }
}
// configure loads the local .env file if there is one, then reads and
// validates the application's environment contract. It raises WebConfigError,
// naming the key at fault, if anything required is missing or malformed.
//
// This is the one place an application reads its environment. Pages, layouts,
// and components receive the validated AppConfig instead of calling Env
// themselves.
configure: Function := (envPath: String := ".env") -> AppConfig {
    loadEnvironment(envPath)
    return WebConfig.load()
}
// app builds the application from a validated configuration, binding the
// server to SERVER_HOST and SERVER_PORT. Those describe the socket this
// process listens on, which is not the same thing as the application's public
// URL: behind a reverse proxy the two differ by design.
app: Function := (config: AppConfig) -> App {
    return App(
        config: config
        server: HTTP.server(config.serverHost, config.serverPort)
    )
}
// start is the ordinary entry point: load .env if present, validate the
// environment, and build the application.
start: Function := (envPath: String := ".env") -> App {
    return app(configure(envPath))
}
// html renders a finished node tree as an HTML response.
html: Function := (body: HTMLNode, status: Int := 200) -> Response {
    return HTTP.html(HTML.render(body), status)
}
// document renders a complete HTML document: the doctype, a UTF-8 head with
// the escaped title and whatever head nodes the caller adds, and the body.
//
// This is the whole of Web's document handling. It is a shell, not a template
// language: there are no slots, no inheritance, no directives, and no
// expressions embedded in markup. A Layout is an ordinary Function that ends
// by calling this.
document: Function := (
    title: String
    body: List<HTMLNode>
    head: List<HTMLNode> := []
) -> String {
    headNodes: Local List<HTMLNode> := [
        HTML.element("meta", {"charset": "utf-8"}, [])
        HTML.element(
            "meta"
            {
                "name": "viewport"
                "content": "width=device-width, initial-scale=1"
            }
            []
        )
        HTML.element("title", {}, [HTML.text(title)])
    ]
    for node in head {
        headNodes.add(node)
    }
    shell: Local HTMLNode := HTML.element(
        "html"
        {}
        [HTML.element("head", {}, headNodes), HTML.element("body", {}, body)]
    )
    return "<!doctype html>{HTML.render(shell)}"
}
// page is document as a response: the ordinary last line of a Layout.
page: Function := (
    title: String
    body: List<HTMLNode>
    head: List<HTMLNode> := []
    status: Int := 200
) -> Response {
    return HTTP.html(document(title, body, head), status)
}
// text returns a plain-text response, mirroring HTTP.text. To build an
// escaped text *node* for a page, use Web.UI.text.
text: Function := (body: String, status: Int := 200) -> Response {
    return HTTP.text(body, status)
}
// redirect sends the browser elsewhere. 303 is the default because the common
// case is the redirect that follows a successful POST.
redirect: Function := (location: String, status: Int := 303) -> Response {
    return HTTP.redirect(location, status)
}
// response builds a response with an explicit status, body, and content type,
// for anything the helpers above do not cover.
response: Function := (
    status: Int
    body: String
    contentType: String
) -> Response {
    return HTTP.response(status, body, contentType)
}
// render turns a node tree into markup.
render: Function := (node: HTMLNode) -> String {
    return HTML.render(node)
}
// sessions creates a session store. Sessions themselves are unchanged: the
// existing SessionStore.open / SessionStore.commit pair still frames a
// request, and this is only the constructor reached through Web.
sessions: Function := (
    cookieName: String := "ahdsession"
    maxAgeSeconds: Int := 86400
    secure: Bool := true
    sameSite: String := "Lax"
) -> SessionStore {
    return HTTP.sessions(cookieName, maxAgeSeconds, secure, sameSite)
}
