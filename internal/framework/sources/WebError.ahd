// Web's own error identity.
//
// Configuration, lifecycle, and typed-form errors are distinct. Existing
// HTTP, HTML, Session, and Security failures retain their original identities.
// Error messages never include submitted values, session data, or tokens.
WebConfigError: Class<Error> := {
    structure: Attributes := (SuperClass.attributes)
}
// Explicit lifecycle misuse; never includes request/session contents.
WebContextError: Class<Error> := {
    structure: Attributes := (SuperClass.attributes)
}
// Invalid submitted typed value; absence is represented separately.
FormValueError: Class<Error> := {
    structure: Attributes := (SuperClass.attributes)
}
